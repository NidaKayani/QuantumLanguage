namespace std
{

template <typename K>
class set
{
  public:
    typedef __tsiter<K> iterator;
    typedef __tsiter<K> const_iterator;
    typedef K value_type;
    typedef K key_type;

    set() {}
    set(initializer_list<K> items)
    {
        for (const K &k : items)
            insert(k);
    }
    set(const set &o) { t_.copyFrom(o.t_); }
    set(set &&o) { t_.takeFrom(o.t_); }
    template <typename It>
    set(It first, It last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    set &operator=(const set &o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.copyFrom(o.t_);
        }
        return *this;
    }
    set &operator=(set &&o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.takeFrom(o.t_);
        }
        return *this;
    }

    size_t size() const { return t_.size_; }
    bool empty() const { return t_.size_ == 0; }
    iterator begin() const { return iterator(t_.first(), &t_); }
    iterator end() const { return iterator(nullptr, &t_); }
    iterator find(const K &k) const { return iterator(t_.find(k), &t_); }
    size_t count(const K &k) const { return t_.find(k) ? 1 : 0; }
    bool contains(const K &k) const { return t_.find(k) != nullptr; }
    iterator lower_bound(const K &k) const { return iterator(t_.lowerBound(k), &t_); }
    iterator upper_bound(const K &k) const { return iterator(t_.upperBound(k), &t_); }

    pair<iterator, bool> insert(const K &k)
    {
        bool added = false;
        __tnode<K, char> *n = t_.insert(pair<K, char>(k, 0), added);
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    template <typename It>
    void insert(It first, It last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    pair<iterator, bool> emplace(const K &k) { return insert(k); }
    size_t erase(const K &k)
    {
        __tnode<K, char> *n = t_.find(k);
        if (!n)
            return 0;
        t_.erase(n);
        return 1;
    }
    iterator erase(iterator it)
    {
        __tnode<K, char> *next = __tree<K, char>::next(it.n_);
        t_.erase(it.n_);
        return iterator(next, &t_);
    }
    void clear() { t_.clear(); }
    bool operator==(const set &o) const
    {
        if (size() != o.size())
            return false;
        for (__tnode<K, char> *a = t_.first(), *b = o.t_.first(); a; a = __tree<K, char>::next(a), b = __tree<K, char>::next(b))
            if (!(a->kv.first == b->kv.first))
                return false;
        return true;
    }
    bool operator!=(const set &o) const { return !(*this == o); }

  private:
    __tree<K, char> t_;
