            h_ = o.h_ ? o.h_->__clone() : nullptr;
        }
        return *this;
    }
    __function2 &operator=(__function2 &&o)
    {
        if (this != &o)
        {
            delete h_;
            h_ = o.h_;
            o.h_ = nullptr;
        }
        return *this;
    }
    __function2 &operator=(void *null)
