        return *this;
    }
    __function0 &operator=(__function0 &&o)
    {
        if (this != &o)
        {
            delete h_;
            h_ = o.h_;
            o.h_ = nullptr;
        }
        return *this;
    }
    __function0 &operator=(void *null)
    {
        delete h_;
        h_ = nullptr;
        return *this;
    }
    template <typename F>
    __function0 &operator=(F f)
    {
        __fn_base0<R> *h = new __fn_impl0<F, R>(f);
        delete h_;
        h_ = h;
        return *this;
    }
    R operator()() const { return h_->__call(); }
    explicit operator bool() const { return h_ != nullptr; }
    bool operator!() const { return h_ == nullptr; }
    __fn_base0<R> *h_;
};

