        {"__startup", R"QNATIVELIB(// The native backend's program start: main(argc, argv)'s arguments, from the
// Windows command line as UTF-8. Included (by the compiler) when main takes
// them.
#pragma once
#include <windows.h>

char **__startup_args(int *argc)
{
    int n = 0;
    wchar_t **wide = CommandLineToArgvW(GetCommandLineW(), &n);
    char **out = new char *[n + 1];
    for (int i = 0; i < n; ++i)
    {
        int len = WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, nullptr, 0, nullptr, nullptr);
        out[i] = new char[len];
        WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, out[i], len, nullptr, nullptr);
    }
    out[n] = nullptr;
    LocalFree((HLOCAL)wide);
    *argc = n;
    return out;
}
)QNATIVELIB"},
        {"__tree", R"QNATIVELIB(// The balanced (AVL) search tree behind <map> and <set>: nodes keyed by
// kv.first, compared with <, linked to their parents so iterators can walk
// both ways. Nodes never move: references to elements stay valid until they
// are erased.
#pragma once
#include <utility>

namespace std
{

template <typename K, typename V>
struct __tnode
{
    pair<K, V> kv;
    __tnode *left;
    __tnode *right;
    __tnode *parent;
    int height;
    explicit __tnode(const pair<K, V> &x) : kv(x), left(nullptr), right(nullptr), parent(nullptr), height(1) {}
};

template <typename K, typename V>
class __tree
{
  public:
    typedef __tnode<K, V> Node;

    __tree() : root_(nullptr), size_(0) {}
    ~__tree() { clear(); }

    Node *root_;
    size_t size_;

    void clear()
    {
        drop(root_);
        root_ = nullptr;
        size_ = 0;
    }
    void copyFrom(const __tree &o)
    {
        for (Node *n = o.first(); n; n = next(n))
        {
            bool added = false;
            insert(n->kv, added);
        }
    }
    void takeFrom(__tree &o)
    {
        root_ = o.root_;
        size_ = o.size_;
        o.root_ = nullptr;
        o.size_ = 0;
    }

    Node *find(const K &k) const
    {
        Node *n = root_;
        while (n)
        {
            if (k < n->kv.first)
                n = n->left;
            else if (n->kv.first < k)
                n = n->right;
            else
                return n;
        }
        return nullptr;
    }
    // the first node whose key is not less than k (upper: greater than k)
    Node *lowerBound(const K &k) const
    {
        Node *n = root_, *r = nullptr;
        while (n)
        {
            if (n->kv.first < k)
                n = n->right;
            else
            {
                r = n;
                n = n->left;
            }
        }
        return r;
    }
    Node *upperBound(const K &k) const
    {
        Node *n = root_, *r = nullptr;
        while (n)
        {
            if (k < n->kv.first)
            {
                r = n;
                n = n->left;
            }
            else
                n = n->right;
        }
        return r;
    }
    Node *first() const
    {
        Node *n = root_;
        while (n && n->left)
            n = n->left;
        return n;
    }
    Node *last() const
    {
        Node *n = root_;
        while (n && n->right)
            n = n->right;
        return n;
    }
    static Node *next(Node *n)
    {
        if (n->right)
        {
            n = n->right;
            while (n->left)
                n = n->left;
            return n;
        }
        Node *p = n->parent;
        while (p && n == p->right)
        {
            n = p;
            p = p->parent;
        }
        return p;
    }
    static Node *prev(Node *n)
    {
        if (n->left)
        {
            n = n->left;
            while (n->right)
                n = n->right;
            return n;
        }
        Node *p = n->parent;
        while (p && n == p->left)
        {
            n = p;
            p = p->parent;
        }
        return p;
    }

    // the node with kv's key: the one there, or kv added
    Node *insert(const pair<K, V> &kv, bool &added)
    {
        Node *p = nullptr, *n = root_;
        bool left = false;
        while (n)
        {
            p = n;
            if (kv.first < n->kv.first)
            {
                n = n->left;
                left = true;
            }
            else if (n->kv.first < kv.first)
            {
                n = n->right;
                left = false;
            }
            else
            {
                added = false;
                return n;
            }
        }
        Node *x = new Node(kv);
        x->parent = p;
        if (!p)
            root_ = x;
        else if (left)
            p->left = x;
        else
            p->right = x;
        ++size_;
        added = true;
        rebalance(p);
        return x;
    }

    void erase(Node *z)
    {
        Node *from;
        if (!z->left || !z->right)
        {
            Node *c = z->left ? z->left : z->right;
            if (c)
                c->parent = z->parent;
            replace(z->parent, z, c);
            from = z->parent;
        }
        else
        {
            Node *y = z->right; // the successor takes z's place
            while (y->left)
                y = y->left;
            if (y->parent != z)
            {
                from = y->parent;
                if (y->right)
                    y->right->parent = y->parent;
                replace(y->parent, y, y->right);
                y->right = z->right;
                y->right->parent = y;
            }
            else
                from = y;
            y->left = z->left;
            y->left->parent = y;
            y->parent = z->parent;
            replace(z->parent, z, y);
            y->height = z->height;
        }
        delete z;
        --size_;
        rebalance(from);
    }

  private:
    static int h(Node *n) { return n ? n->height : 0; }
    static void fix(Node *n)
    {
        int a = h(n->left), b = h(n->right);
        n->height = (a > b ? a : b) + 1;
    }
    void replace(Node *p, Node *old, Node *now)
    {
        if (!p)
            root_ = now;
        else if (p->left == old)
            p->left = now;
        else
            p->right = now;
    }
    Node *rotateRight(Node *y)
    {
        Node *x = y->left;
        y->left = x->right;
        if (x->right)
            x->right->parent = y;
        x->parent = y->parent;
        replace(y->parent, y, x);
        x->right = y;
        y->parent = x;
        fix(y);
        fix(x);
        return x;
    }
    Node *rotateLeft(Node *y)
    {
        Node *x = y->right;
        y->right = x->left;
        if (x->left)
            x->left->parent = y;
        x->parent = y->parent;
        replace(y->parent, y, x);
        x->left = y;
        y->parent = x;
        fix(y);
        fix(x);
        return x;
    }
    void rebalance(Node *n)
    {
        while (n)
        {
            fix(n);
            int bal = h(n->left) - h(n->right);
            if (bal > 1)
            {
                if (h(n->left->left) < h(n->left->right))
                    rotateLeft(n->left);
                n = rotateRight(n);
            }
            else if (bal < -1)
            {
                if (h(n->right->right) < h(n->right->left))
                    rotateRight(n->right);
                n = rotateLeft(n);
            }
            n = n->parent;
        }
    }
    static void drop(Node *n)
    {
        while (n)
        {
            drop(n->left);
            Node *r = n->right;
            delete n;
            n = r;
        }
    }
};

// an iterator over a tree's nodes in key order; end() is null (-- from it:
// the last node)
template <typename K, typename V>
class __titer
{
  public:
    __titer() : n_(nullptr), t_(nullptr) {}
    __titer(__tnode<K, V> *n, const __tree<K, V> *t) : n_(n), t_(t) {}
    pair<K, V> &operator*() const { return n_->kv; }
    pair<K, V> *operator->() const { return &n_->kv; }
    __titer &operator++()
    {
        n_ = __tree<K, V>::next(n_);
        return *this;
    }
    __titer operator++(int)
    {
        __titer old = *this;
        n_ = __tree<K, V>::next(n_);
        return old;
    }
    __titer &operator--()
    {
        n_ = n_ ? __tree<K, V>::prev(n_) : t_->last();
        return *this;
    }
    __titer operator--(int)
    {
        __titer old = *this;
        --*this;
        return old;
    }
    bool operator==(const __titer &o) const { return n_ == o.n_; }
    bool operator!=(const __titer &o) const { return n_ != o.n_; }
    __tnode<K, V> *n_;
    const __tree<K, V> *t_;
};

// a set's: the keys only
template <typename K>
class __tsiter
{
  public:
    __tsiter() : n_(nullptr), t_(nullptr) {}
    __tsiter(__tnode<K, char> *n, const __tree<K, char> *t) : n_(n), t_(t) {}
    const K &operator*() const { return n_->kv.first; }
    const K *operator->() const { return &n_->kv.first; }
    __tsiter &operator++()
    {
        n_ = __tree<K, char>::next(n_);
        return *this;
    }
    __tsiter operator++(int)
    {
        __tsiter old = *this;
        n_ = __tree<K, char>::next(n_);
        return old;
    }
    __tsiter &operator--()
    {
        n_ = n_ ? __tree<K, char>::prev(n_) : t_->last();
        return *this;
    }
    bool operator==(const __tsiter &o) const { return n_ == o.n_; }
    bool operator!=(const __tsiter &o) const { return n_ != o.n_; }
    __tnode<K, char> *n_;
    const __tree<K, char> *t_;
};

} // namespace std
)QNATIVELIB"},
        {"algorithm", R"QNATIVELIB(// <algorithm> for Quantum's native backend: the algorithms over pointer
// ranges (vector and string iterators are pointers).
#pragma once
#include <utility>

namespace std
{

template <typename T>
const T &min(const T &a, const T &b)
{
    return b < a ? b : a;
}

template <typename T>
const T &max(const T &a, const T &b)
{
    return a < b ? b : a;
}

template <typename T>
void reverse(T *first, T *last)
{
    while (first < last)
    {
        --last;
        T t = std::move(*first);
        *first = std::move(*last);
        *last = std::move(t);
        ++first;
    }
}

template <typename T, typename V>
T *find(T *first, T *last, const V &value)
{
    for (; first != last; ++first)
        if (*first == value)
            return first;
    return last;
}

template <typename T, typename V>
long long count(T *first, T *last, const V &value)
{
    long long n = 0;
    for (; first != last; ++first)
        if (*first == value)
            ++n;
    return n;
}

// a stable merge sort (std::sort's order on equal keys is unspecified)
template <typename T, typename Less>
void __mergeSort(T *a, T *tmp, long long n, Less less)
{
    if (n < 2)
        return;
    long long mid = n / 2;
    __mergeSort(a, tmp, mid, less);
    __mergeSort(a + mid, tmp, n - mid, less);
    long long i = 0, j = mid, k = 0;
    while (i < mid && j < n)
    {
        if (less(a[j], a[i]))
            tmp[k++] = std::move(a[j++]);
        else
            tmp[k++] = std::move(a[i++]);
    }
    while (i < mid)
        tmp[k++] = std::move(a[i++]);
    while (j < n)
        tmp[k++] = std::move(a[j++]);
    for (long long x = 0; x < n; ++x)
        a[x] = std::move(tmp[x]);
}

template <typename T, typename Less>
void stable_sort(T *first, T *last, Less less)
{
    long long n = last - first;
    if (n < 2)
        return;
    T *tmp = new T[n];
    __mergeSort(first, tmp, n, less);
    delete[] tmp;
}

template <typename T>
struct __less
{
    bool operator()(const T &a, const T &b) const { return a < b; }
};

template <typename T>
void stable_sort(T *first, T *last)
{
    stable_sort(first, last, __less<T>());
}

template <typename T, typename Less>
void sort(T *first, T *last, Less less)
{
    stable_sort(first, last, less);
}

template <typename T>
void sort(T *first, T *last)
{
    stable_sort(first, last, __less<T>());
}

// predicates over any iterators
template <typename It, typename P>
It find_if(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return first;
    return last;
}
template <typename It, typename P>
It find_if_not(It first, It last, P p)
{
    for (; first != last; ++first)
        if (!p(*first))
            return first;
    return last;
}
template <typename It, typename P>
bool any_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return true;
    return false;
}
template <typename It, typename P>
bool all_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (!p(*first))
            return false;
    return true;
}
template <typename It, typename P>
bool none_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return false;
    return true;
}
template <typename It, typename P>
long long count_if(It first, It last, P p)
{
    long long n = 0;
    for (; first != last; ++first)
        if (p(*first))
            ++n;
    return n;
}
template <typename It, typename F>
F for_each(It first, It last, F f)
{
    for (; first != last; ++first)
        f(*first);
    return f;
}

// over contiguous elements
template <typename T, typename P>
T *remove_if(T *first, T *last, P p)
{
    T *out = first;
    for (; first != last; ++first)
        if (!p(*first))
        {
            if (out != first)
                *out = std::move(*first);
            ++out;
        }
    return out;
}
template <typename T, typename V>
T *remove(T *first, T *last, const V &value)
{
    T *out = first;
    for (; first != last; ++first)
        if (!(*first == value))
        {
            if (out != first)
                *out = std::move(*first);
            ++out;
        }
    return out;
}
template <typename T>
T *unique(T *first, T *last)
{
    if (first == last)
        return last;
    T *out = first;
    for (T *p = first + 1; p != last; ++p)
        if (!(*p == *out))
        {
            ++out;
            if (out != p)
                *out = std::move(*p);
        }
    return out + 1;
}
template <typename T, typename V>
T *lower_bound(T *first, T *last, const V &value)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (first[h] < value)
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V>
T *upper_bound(T *first, T *last, const V &value)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (!(value < first[h]))
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V>
bool binary_search(T *first, T *last, const V &value)
{
    T *p = lower_bound(first, last, value);
    return p != last && !(value < *p);
}
template <typename T>
T *max_element(T *first, T *last)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (*best < *p)
            best = p;
    return best;
}
template <typename T>
T *min_element(T *first, T *last)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (*p < *best)
            best = p;
    return best;
}
template <typename T, typename V>
void fill(T *first, T *last, const V &value)
{
    for (; first != last; ++first)
        *first = value;
}
template <typename T, typename V>
void replace(T *first, T *last, const V &from, const V &to)
{
    for (; first != last; ++first)
        if (*first == from)
            *first = to;
}
template <typename It, typename Out>
Out copy(It first, It last, Out out)
{
    for (; first != last; ++first, ++out)
        *out = *first;
    return out;
}
template <typename It, typename Out, typename F>
Out transform(It first, It last, Out out, F f)
{
    for (; first != last; ++first, ++out)
        *out = f(*first);
    return out;
}
template <typename A, typename B>
bool equal(A first, A last, B other)
{
    for (; first != last; ++first, ++other)
        if (!(*first == *other))
            return false;
    return true;
}

} // namespace std
