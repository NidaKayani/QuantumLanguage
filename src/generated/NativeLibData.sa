        {"map", R"QNATIVELIB(// <map> for Quantum's native backend: std::map over the AVL tree in
// <__tree> (keys ordered by <).
#pragma once
#include <__tree>
#include <initializer_list>

namespace std
{

template <typename K, typename V>
class map
{
  public:
    typedef __titer<K, V> iterator;
    typedef __titer<K, V> const_iterator;
    typedef pair<K, V> value_type;
    typedef K key_type;
    typedef V mapped_type;

    map() {}
    map(initializer_list<pair<K, V>> items)
    {
        for (const pair<K, V> &kv : items)
            insert(kv);
    }
    map(const map &o) { t_.copyFrom(o.t_); }
    map(map &&o) { t_.takeFrom(o.t_); }
    map &operator=(const map &o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.copyFrom(o.t_);
        }
        return *this;
    }
    map &operator=(map &&o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.takeFrom(o.t_);
        }
        return *this;
    }

    size_t size() const { return t_.size_; }
    bool empty() const { return t_.size_ == 0; }
    iterator begin() const { return iterator(t_.first(), &t_); }
    iterator end() const { return iterator(nullptr, &t_); }
    iterator find(const K &k) const { return iterator(t_.find(k), &t_); }
    size_t count(const K &k) const { return t_.find(k) ? 1 : 0; }
    bool contains(const K &k) const { return t_.find(k) != nullptr; }
    iterator lower_bound(const K &k) const { return iterator(t_.lowerBound(k), &t_); }
    iterator upper_bound(const K &k) const { return iterator(t_.upperBound(k), &t_); }

    V &operator[](const K &k)
    {
        __tnode<K, V> *n = t_.find(k);
        if (n)
            return n->kv.second;
        bool added = false;
        return t_.insert(pair<K, V>(k, V()), added)->kv.second;
    }
    V &at(const K &k) { return t_.find(k)->kv.second; }
    const V &at(const K &k) const { return t_.find(k)->kv.second; }
    pair<iterator, bool> insert(const pair<K, V> &kv)
    {
        bool added = false;
        __tnode<K, V> *n = t_.insert(kv, added);
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    pair<iterator, bool> emplace(const K &k, const V &v) { return insert(pair<K, V>(k, v)); }
    pair<iterator, bool> insert_or_assign(const K &k, const V &v)
    {
        bool added = false;
        __tnode<K, V> *n = t_.insert(pair<K, V>(k, v), added);
        if (!added)
            n->kv.second = v;
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    size_t erase(const K &k)
    {
        __tnode<K, V> *n = t_.find(k);
        if (!n)
            return 0;
        t_.erase(n);
        return 1;
    }
    iterator erase(iterator it)
    {
        __tnode<K, V> *next = __tree<K, V>::next(it.n_);
        t_.erase(it.n_);
        return iterator(next, &t_);
    }
    void clear() { t_.clear(); }
    bool operator==(const map &o) const
    {
        if (size() != o.size())
            return false;
        for (__tnode<K, V> *a = t_.first(), *b = o.t_.first(); a; a = __tree<K, V>::next(a), b = __tree<K, V>::next(b))
            if (!(a->kv.first == b->kv.first) || !(a->kv.second == b->kv.second))
                return false;
        return true;
    }
    bool operator!=(const map &o) const { return !(*this == o); }

  private:
    __tree<K, V> t_;
};

} // namespace std
