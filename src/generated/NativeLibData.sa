#include <initializer_list>

namespace std
{

// a reverse iterator over contiguous elements: p_ is one past the current one
template <typename T>
class __rptr
{
  public:
    __rptr() : p_(nullptr) {}
    explicit __rptr(T *p) : p_(p) {}
    T &operator*() const { return *(p_ - 1); }
    T *operator->() const { return p_ - 1; }
    __rptr &operator++()
    {
        --p_;
        return *this;
    }
    __rptr operator++(int)
    {
        __rptr old = *this;
        --p_;
        return old;
    }
    __rptr &operator--()
    {
        ++p_;
        return *this;
    }
    bool operator==(const __rptr &o) const { return p_ == o.p_; }
    bool operator!=(const __rptr &o) const { return p_ != o.p_; }
    T *base() const { return p_; }
    T *p_;
};

