        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.data_ = d;
        o.size_ = s;
        o.cap_ = c;
    }
    void assign(size_t n, const T &v)
    {
        clear();
        for (size_t k = 0; k < n; ++k)
            push_back(v);
    }

  private:
    T *data_;
    size_t size_;
    size_t cap_;
};

