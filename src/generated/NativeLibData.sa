template <typename R>
struct __fn_base0
{
    virtual ~__fn_base0() {}
    virtual R __call() = 0;
    virtual __fn_base0 *__clone() const = 0;
};

template <typename F, typename R>
struct __fn_impl0 : __fn_base0<R>
{
    F f;
    explicit __fn_impl0(const F &g) : f(g) {}
    R __call() override { return f(); }
    __fn_base0<R> *__clone() const override { return new __fn_impl0(f); }
};

template <typename R>
class __function0
{
  public:
    __function0() : h_(nullptr) {}
    __function0(void *null) : h_(nullptr) {}
    template <typename F>
    __function0(F f) : h_(new __fn_impl0<F, R>(f))
    {
    }
    __function0(const __function0 &o) : h_(o.h_ ? o.h_->__clone() : nullptr) {}
    __function0(__function0 &&o) : h_(o.h_) { o.h_ = nullptr; }
    ~__function0() { delete h_; }
    __function0 &operator=(const __function0 &o)
    {
        if (this != &o)
        {
            delete h_;
            h_ = o.h_ ? o.h_->__clone() : nullptr;
