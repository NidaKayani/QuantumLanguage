        {"random", R"QNATIVELIB(// <random> for Quantum's native backend, with libstdc++'s algorithms (so a
// seeded program draws the same numbers as when built by g++): the Mersenne
// twisters, random_device (RtlGenRandom), uniform_int_distribution (Lemire's
// nearly-divisionless method on 128-bit products) and
// uniform_real_distribution (generate_canonical, one 64-bit draw).
#pragma once
#include <__hash>

namespace __dll_advapi32
{
unsigned char SystemFunction036(void *buffer, unsigned long length); // RtlGenRandom
}

namespace std
{

class mt19937_64
{
  public:
    typedef unsigned long long result_type;
    explicit mt19937_64(unsigned long long s = 5489ULL) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = s;
        for (int i = 1; i < 312; ++i)
            x_[i] = 6364136223846793005ULL * (x_[i - 1] ^ (x_[i - 1] >> 62)) + (unsigned long long)i;
        i_ = 312;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 312)
            twist();
        unsigned long long z = x_[i_++];
        z ^= (z >> 29) & 0x5555555555555555ULL;
        z ^= (z << 17) & 0x71D67FFFEDA60000ULL;
        z ^= (z << 37) & 0xFFF7EEE000000000ULL;
        z ^= z >> 43;
        return z;
    }
    void discard(unsigned long long n)
    {
        while (n--)
            (*this)();
    }

  private:
    unsigned long long x_[312];
    int i_;
    void twist()
    {
        const unsigned long long upper = 0xFFFFFFFF80000000ULL, lower = 0x7FFFFFFFULL;
        for (int k = 0; k < 312; ++k)
        {
            unsigned long long y = (x_[k] & upper) | (x_[(k + 1) % 312] & lower);
            x_[k] = x_[(k + 156) % 312] ^ (y >> 1) ^ ((y & 1) ? 0xB5026F5AA96619E9ULL : 0ULL);
        }
        i_ = 0;
    }
};

class mt19937
{
  public:
    typedef unsigned result_type;
    explicit mt19937(unsigned long long s = 5489U) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = (unsigned)s;
        for (int i = 1; i < 624; ++i)
            x_[i] = 1812433253U * (x_[i - 1] ^ (x_[i - 1] >> 30)) + (unsigned)i;
        i_ = 624;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 624)
            twist();
        unsigned z = x_[i_++];
        z ^= z >> 11;
        z ^= (z << 7) & 0x9D2C5680U;
        z ^= (z << 15) & 0xEFC60000U;
        z ^= z >> 18;
        return z;
    }

  private:
    unsigned x_[624];
    int i_;
    void twist()
    {
        for (int k = 0; k < 624; ++k)
        {
            unsigned y = (x_[k] & 0x80000000U) | (x_[(k + 1) % 624] & 0x7FFFFFFFU);
            x_[k] = x_[(k + 397) % 624] ^ (y >> 1) ^ ((y & 1) ? 0x9908B0DFU : 0U);
        }
        i_ = 0;
    }
};
typedef mt19937 default_random_engine;

class random_device
{
  public:
    typedef unsigned result_type;
    random_device() {}
    unsigned operator()()
    {
        unsigned v = 0;
        __dll_advapi32::SystemFunction036(&v, 4);
        return v;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFULL; }
};

// the high and low 64 bits of a * b
inline unsigned long long __mul_hi(unsigned long long a, unsigned long long b, unsigned long long &lo)
{
    unsigned long long a0 = a & 0xFFFFFFFFULL, a1 = a >> 32, b0 = b & 0xFFFFFFFFULL, b1 = b >> 32;
    unsigned long long p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
    unsigned long long mid = (p00 >> 32) + (p01 & 0xFFFFFFFFULL) + (p10 & 0xFFFFFFFFULL);
    lo = (mid << 32) | (p00 & 0xFFFFFFFFULL);
    return p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
}

// a value in [0, range] from g, as libstdc++'s uniform_int_distribution::operator()
template <typename G>
unsigned long long __uniform_u64(G &g, unsigned long long urange)
{
    unsigned long long urngrange = G::max() - G::min();
    if (urngrange > urange)
    {
        unsigned long long uerange = urange + 1;
        if (urngrange == 0xFFFFFFFFFFFFFFFFULL)
        {
            unsigned long long low = 0;
            unsigned long long high = __mul_hi(g() - G::min(), uerange, low);
            if (low < uerange)
            {
                unsigned long long threshold = (0ULL - uerange) % uerange;
                while (low < threshold)
                    high = __mul_hi(g() - G::min(), uerange, low);
            }
            return high;
        }
        if (urngrange == 0xFFFFFFFFULL)
        {
            unsigned long long product = (g() - G::min()) * uerange;
            unsigned long long low = product & 0xFFFFFFFFULL;
            if (low < uerange)
            {
                unsigned long long threshold = ((0ULL - uerange) & 0xFFFFFFFFULL) % uerange;
                while (low < threshold)
                {
                    product = (g() - G::min()) * uerange;
                    low = product & 0xFFFFFFFFULL;
                }
            }
            return product >> 32;
        }
        unsigned long long scaling = urngrange / uerange, past = uerange * scaling, ret;
        do
            ret = g() - G::min();
        while (ret >= past);
        return ret / scaling;
    }
    if (urngrange < urange)
    {
        // upscaling: (urange+1) needs more than one draw
        unsigned long long ret, tmp;
        do
        {
            unsigned long long uerngrange = urngrange + 1;
            tmp = uerngrange * __uniform_u64(g, urange / uerngrange);
            ret = tmp + (g() - G::min());
        } while (ret > urange || ret < tmp);
        return ret;
    }
    return g() - G::min();
}

template <typename T>
class uniform_int_distribution
{
  public:
    uniform_int_distribution(T a = 0, T b = (T)0x7FFFFFFF) : a_(a), b_(b) {}
    template <typename G>
    T operator()(G &g)
    {
        unsigned long long urange = (unsigned long long)b_ - (unsigned long long)a_;
        return (T)(__uniform_u64(g, urange) + (unsigned long long)a_);
    }
    T a() const { return a_; }
    T b() const { return b_; }

  private:
    T a_, b_;
};

// generate_canonical<double, 53>: one draw over the generator's range
template <typename G>
double __canonical(G &g)
{
    double ret;
    if (G::max() - G::min() == 0xFFFFFFFFULL)
    {
        // 32-bit draws: two of them, (lo + hi * 2^32) / 2^64
        unsigned long long lo = g() - G::min();
        unsigned long long hi = g() - G::min();
        ret = (double)(lo + (hi << 32)) / 18446744073709551616.0;
    }
    else
        ret = (double)(g() - G::min()) / 18446744073709551616.0;
    if (ret >= 1.0)
        ret = 0.99999999999999989; // nextafter(1.0, 0.0)
    return ret;
}

template <typename T>
class uniform_real_distribution
{
  public:
    uniform_real_distribution(T a = 0, T b = 1) : a_(a), b_(b) {}
    template <typename G>
    T operator()(G &g)
    {
        return (T)(__canonical(g) * (b_ - a_) + a_);
    }

  private:
    T a_, b_;
};

