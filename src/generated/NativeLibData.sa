        {"__format", R"QNATIVELIB(// Number formatting for Quantum's native library: printf's conversions,
// exact. A double is mant * 2^exp; its decimal digits come from big-integer
// arithmetic on that exact value, rounded half to even like the C runtime.
#pragma once
