// quantum: cpp
#pragma once
// A Windows x64 executable (PE32+) around machine code: a .text section with
// the code and an .idata section importing functions from system DLLs. No
// linker: the image is laid out and written here.

#include "X64.h.sa"

#include <string>
#include <utility>
#include <vector>

namespace native
{

struct Import
{
    std::string dll;  // "kernel32.dll"
    std::string name; // "ExitProcess"
};

// The bytes of a console .exe. `entry` is the code offset execution starts
// at; each of `code.importRefs` names an entry of `imports`, and each of
// `code.dataRefs` a byte of `data` (the writable .data section).
// `dataPtrs` are pointers inside .data to other .data bytes: (where the
// 8-byte pointer is, the offset it points at), filled with absolute addresses.
std::string writePe(const Asm &code, int entry, const std::vector<Import> &imports, const std::string &data,
                    const std::vector<std::pair<int, int>> &dataPtrs);

} // namespace native
