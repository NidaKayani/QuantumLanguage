// quantum: cpp
// The native backend's code generator: the C++ AST (src/cpp/) to x86-64 code
// for Windows.
//
// Types so far: the integer types, pointers, references, arrays, and classes
// with constructors, destructors, single inheritance and virtual functions.
// Every variable lives in memory at its own size: locals in the rbp frame,
// globals, vtables and string literals in the .data section. An expression
// leaves a scalar value in rax, already wrapped to its type (an int
// sign-extended from 32 bits, an unsigned zero-extended, a bool 0 or 1), so
// 64-bit instructions give C++'s results; a class or array value leaves its
// address there. Operands of a binary operator meet on the stack.
//
// Calls use the Microsoft x64 registers and stack layout. Arguments, in
// order: a hidden pointer to the result when a function returns a class,
// `this` for a member function, then the parameters. A class passed by value
// is a pointer to a copy the caller makes; a reference is a pointer.
#include "Native.h.sa"
#include "Pe.h.sa"
#include "X64.h.sa"
#include "../cpp/Cpp.h.sa"

#include <cmath>
#include <fstream>
#include <iostream>
#include <map>
#include <memory>
#include <sstream>

namespace native
{

namespace
{

enum Kind
{
    K_VOID,
    K_BOOL,
    K_I8,
    K_U8,
    K_I16,
    K_U16,
    K_I32,
    K_U32,
    K_I64,
    K_U64,
    K_F32, // float
    K_F64, // double
};

[[noreturn]] void fail(const std::string &msg, int line) { throw cpp::Unsupported("native: " + msg, "", line); }

bool isUnsigned(Kind k) { return k == K_U8 || k == K_U16 || k == K_U32 || k == K_U64 || k == K_BOOL; }
bool isFloat(Kind k) { return k == K_F32 || k == K_F64; }

int kindSize(Kind k)
{
    switch (k)
    {
    case K_BOOL: case K_I8: case K_U8: return 1;
    case K_I16: case K_U16: return 2;
    case K_I32: case K_U32: case K_F32: return 4;
    case K_VOID: return 0;
    default: return 8;
    }
}

// The type an operand takes in arithmetic (integer promotion)
Kind promote(Kind k) { return isFloat(k) ? k : kindSize(k) < 4 ? K_I32 : k; }

// The usual arithmetic conversions between two operands
Kind common(Kind a, Kind b)
{
    a = promote(a);
    b = promote(b);
    if (a == K_F64 || b == K_F64)
        return K_F64;
    if (a == K_F32 || b == K_F32)
        return K_F32;
    if (a == K_U64 || b == K_U64)
        return K_U64;
    if (a == K_I64 || b == K_I64)
        return K_I64;
    if (a == K_U32 || b == K_U32)
        return K_U32;
    return K_I32;
}

const uint64_t kCodeBase = 0x140001000ULL; // where .text is loaded (Pe.sa: image base + 0x1000)

// ─── Types ─────────────────────────────────────────────────────────────────

enum Cat
{
    C_VOID,
    C_INT,
    C_PTR,
    C_REF,
    C_ARRAY,
    C_CLASS,
};

struct ClassInfo;
struct Method;
struct NType;
using NT = std::shared_ptr<NType>;

// A template instance's arguments: type parameters and value parameters
struct Binding
{
    std::map<std::string, NT> types;
    std::map<std::string, int64_t> values;
};
using BindP = std::shared_ptr<Binding>;

struct NType
{
    Cat cat = C_VOID;
    Kind kind = K_VOID; // C_INT
    NT elem;            // C_PTR / C_REF / C_ARRAY
    int n = 0;          // C_ARRAY
    ClassInfo *cls = nullptr;
    bool isConst = false; // a const reference binds to a temporary
};

struct Field
{
    std::string name;
    NT type;
    int off = 0;
    cpp::ExprP init;  // default member initializer
    bool initBraced = false;
    std::vector<cpp::ExprP> initArgs;
};

struct Method
{
    std::string name;
    ClassInfo *owner = nullptr; // null: a free function
    NT ret;
    std::vector<NT> params;
    std::vector<cpp::ExprP> defaults; // per parameter (null: none)
    cpp::DeclP decl;                  // null: generated (implicit constructor / destructor)
    int label = -1;
    bool isStatic = false, isVirtual = false, isCtor = false, isDtor = false, isPure = false;
    int vslot = -1;
    BindP bind; // a template instance's arguments (null: not a template)
};

struct ClassInfo
{
    std::string name;
    std::vector<Field> fields;
    int size = 0;
    int align = 1;
    ClassInfo *base = nullptr;
    bool polymorphic = false;
    int vtableOff = -1;
    std::vector<Method *> vslots;
    std::map<std::string, std::vector<Method *>> methods;
    std::vector<Method *> ctors;
    Method *dtor = nullptr;          // user-declared or generated
    Method *implicitCtor = nullptr;  // generated when there is no user constructor
    bool needsDtor = false;
    std::map<std::string, std::string> statics; // static data member -> global name
    BindP bind;                                 // a class template instance's arguments
    std::string templateName;                   // its template (the injected class name)
};

NT tVoid() { return std::make_shared<NType>(); }
NT tInt(Kind k)
{
    NT t = std::make_shared<NType>();
    t->cat = k == K_VOID ? C_VOID : C_INT;
    t->kind = k;
    return t;
}
NT tPtr(const NT &to)
{
    NT t = std::make_shared<NType>();
    t->cat = C_PTR;
    t->elem = to;
    return t;
}
NT tRef(const NT &to, bool isConst)
{
    NT t = std::make_shared<NType>();
    t->cat = C_REF;
    t->elem = to;
    t->isConst = isConst;
    return t;
}
NT tArray(const NT &of, int n)
{
    NT t = std::make_shared<NType>();
    t->cat = C_ARRAY;
    t->elem = of;
    t->n = n;
    return t;
}
NT tClass(ClassInfo *c)
{
    NT t = std::make_shared<NType>();
    t->cat = C_CLASS;
    t->cls = c;
    return t;
}

int sizeOf(const NT &t)
{
    switch (t->cat)
    {
    case C_INT: return kindSize(t->kind);
    case C_PTR: case C_REF: return 8;
    case C_ARRAY: return t->n * sizeOf(t->elem);
    case C_CLASS: return t->cls->size;
    default: return 1;
    }
}

int alignOf(const NT &t)
{
    switch (t->cat)
    {
    case C_INT: return kindSize(t->kind);
    case C_PTR: case C_REF: return 8;
    case C_ARRAY: return alignOf(t->elem);
    case C_CLASS: return t->cls->align;
    default: return 1;
    }
}

bool isScalar(const NT &t) { return t->cat == C_INT || t->cat == C_PTR; }

// The integer kind a scalar is handled as (a pointer: an unsigned 64-bit number)
Kind valKind(const NT &t) { return t->cat == C_INT ? t->kind : K_U64; }

int alignUp(int v, int a) { return (v + a - 1) / a * a; }

std::string typeKey(const NT &t)
{
    static const char *const kinds[] = {"void", "bool", "char", "uchar", "short", "ushort",
                                        "int", "uint", "llong", "ullong", "float", "double"};
    switch (t->cat)
    {
    case C_INT: return kinds[t->kind];
    case C_PTR: return typeKey(t->elem) + "*";
    case C_REF: return typeKey(t->elem) + "&";
    case C_ARRAY: return typeKey(t->elem) + "[" + std::to_string(t->n) + "]";
    case C_CLASS: return t->cls->name;
    default: return "void";
    }
}

bool derivesFrom(ClassInfo *c, ClassInfo *base)
{
    for (; c; c = c->base)
        if (c == base)
            return true;
    return false;
}

bool sameType(const NT &a, const NT &b)
{
    if (a->cat != b->cat)
        return false;
    switch (a->cat)
    {
    case C_INT: return a->kind == b->kind;
    case C_PTR: case C_REF: case C_ARRAY: return sameType(a->elem, b->elem) && a->n == b->n;
    case C_CLASS: return a->cls == b->cls;
    default: return true;
    }
}

// The IEEE-754 bits of v with `mant` mantissa bits and `bias` (double: 52 /
// 1023, float: 23 / 127), rounded to nearest even. Computed with frexp/ldexp
// so that every build of the compiler writes the same bytes.
uint64_t ieeeBits(double v, int mant, int bias)
{
    uint64_t sign = 0;
    if (v != v)
        return mant == 52 ? 0x7FF8000000000000ULL : 0x7FC00000ULL;
    if (v < 0)
    {
        sign = 1ULL << (mant == 52 ? 63 : 31);
        v = -v;
    }
    int expBits = mant == 52 ? 11 : 8;
    uint64_t expMax = (1ULL << expBits) - 1;
    if (v == 0)
        return sign;
    int e;
    double m = frexp(v, &e); // v = m * 2^e, 0.5 <= m < 1
    int64_t exp = e - 1 + bias;
    double scaled;
    if (exp <= 0)
    {
        scaled = ldexp(v, bias - 1 + mant); // a subnormal: v / 2^(1 - bias - mant)
        exp = 0;
    }
    else
        scaled = ldexp(m * 2 - 1, mant);
    double whole = floor(scaled);
    double frac = scaled - whole;
    uint64_t bits = (uint64_t)whole;
    if (frac > 0.5 || (frac == 0.5 && (bits & 1)))
        ++bits;
    if (bits >> mant)
    {
        bits &= (1ULL << mant) - 1;
        ++exp;
    }
    if (exp >= (int64_t)expMax)
        return sign | (expMax << mant); // infinity
    return sign | ((uint64_t)exp << mant) | bits;
}

// An integer literal's value and type (decimal: int, then long long; hex and
// octal may also be unsigned; suffixes u / l / ll)
int64_t literalValue(const std::string &text, Kind &kind)
{
    std::string s;
    for (char c : text)
        if (c != '\'')
            s += c;
    bool u = false;
    int longs = 0;
    while (!s.empty() && (s.back() == 'u' || s.back() == 'U' || s.back() == 'l' || s.back() == 'L'))
    {
        if (s.back() == 'u' || s.back() == 'U')
            u = true;
        else
            ++longs;
        s.pop_back();
    }
    int base = 10;
    size_t i = 0;
    if (s.size() > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        base = 16, i = 2;
    else if (s.size() > 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B'))
        base = 2, i = 2;
    else if (s.size() > 1 && s[0] == '0')
        base = 8, i = 1;
    uint64_t v = 0;
    for (; i < s.size(); ++i)
    {
        char c = s[i];
        int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : 99;
        v = v * base + d;
    }
    if (longs >= 2 || v > 0xFFFFFFFFULL)
        kind = u || (base != 10 && v > 0x7FFFFFFFFFFFFFFFULL) ? K_U64 : K_I64;
    else if (u || (base != 10 && v > 0x7FFFFFFFULL))
        kind = K_U32;
    else
        kind = v > 0x7FFFFFFFULL ? K_I64 : K_I32;
    return (int64_t)v;
}

const int kArgRegs[4] = {RCX, RDX, R8, R9};

// Where `this` comes from for a call
enum ThisKind
{
    TH_NONE,
    TH_OBJ,      // the object an lvalue expression designates
    TH_PTR,      // the value of a pointer expression
    TH_CUR,      // the current member function's this
    TH_LOCAL,    // the object at rbp+off
    TH_INDIRECT, // the address stored at rbp+off
    TH_GLOBAL,   // the object at .data+off
};

struct ThisSrc
{
    ThisKind kind = TH_NONE;
    cpp::ExprP e;
    int off = 0;
};

class Gen
{
  public:
    Asm a;
    std::vector<Import> imports;
    std::string data; // the .data section
    int entry = 0;

    void program(const cpp::Program &p);

  private:
    struct Var
    {
        NT type;
        bool global = false;
        int off = 0; // rbp offset, or .data offset
    };
    struct Cleanup // an object to destroy when its scope ends
    {
        int off;
        ClassInfo *cls; // null: only a handler record to pop (a try block)
        int ehRec = 0;  // rbp offset of its handler record (0: none)
    };
    struct Scope
    {
        std::map<std::string, Var> vars;
        std::vector<Cleanup> cleanups;
    };
    struct Loop
    {
        int breakLabel, continueLabel;
        size_t scopeDepth; // scopes_ size outside the loop body
    };

    std::vector<std::unique_ptr<Method>> allMethods_;
    std::map<std::string, std::vector<Method *>> funcs_;
    std::map<std::string, std::unique_ptr<ClassInfo>> classes_;
    std::map<std::string, Var> globals_;
    std::vector<std::pair<int, ClassInfo *>> globalObjects_; // .data offset, class: constructed before main
    std::vector<std::pair<int, cpp::DeclP>> globalCtorInits_; // .data offset, declaration
    std::map<std::string, int> runtime_; // runtime routine -> label (emitted when used)
    std::map<std::string, cpp::DeclP> classTemplates_;
    std::map<std::string, std::vector<cpp::DeclP>> funcTemplates_;
    std::map<std::string, Method *> funcInstances_; // name<args> -> instance
    BindP bind_;                                   // template arguments in effect
    // expression -> template binding -> its type (keyed by plain pointers:
    // compared by identity)
    std::map<const cpp::Expr *, std::map<const Binding *, NT>> typeMemo_;
    // lambda expression -> template binding -> its closure class
    std::map<const cpp::Expr *, std::map<const Binding *, ClassInfo *>> closures_;
    int lambdaCount_ = 0;
    bool deducing_ = false; // generating a body only to find its return type
    // exceptions: .data offsets of the handler chain's top, the exception in
    // flight (its object, type record, destructor), and the type records
    int ehTop_ = -1, ehObj_ = -1, ehType_ = -1, ehDtor_ = -1;
    std::map<std::string, int> typeInfo_;
    std::vector<int> catchSaves_; // rbp offsets where the enclosing handlers keep their exception
    NT deducedRet_;

    // the function being generated
    Method *cur_ = nullptr;
    std::vector<Scope> scopes_;
    std::vector<Loop> loops_;
    int nextOff_ = 0; // lowest rbp offset handed out
    int depth_ = 0;   // 8-byte pushes outstanding (stack alignment at calls)
    int retLabel_ = -1;
    NT retType_;
    int retPtrOff_ = 0; // home slot of the hidden result pointer
    int thisOff_ = 0;   // home slot of this
    std::vector<Cleanup> temps_; // temporaries of the current full-expression
    std::string nrvoName_;       // the local every `return` of a class returns (built in place)

    // types
    NT typeOf(const cpp::TypeNameP &t, int line);
    NT baseType(const cpp::TypeNameP &t, int line);
    int64_t constInt(const cpp::ExprP &e);
    void classDecl(const cpp::DeclP &d, const std::string &name = "");
    ClassInfo *instantiateClass(const std::string &name, const std::vector<cpp::TArg> &targs, int line);
    Method *instantiateFunc(const cpp::DeclP &d, int which, const std::vector<cpp::ExprP> &args,
                            const std::vector<cpp::TArg> &targs, bool explicitArgs, int line);
    Method *makeFunction(const cpp::DeclP &d, const BindP &bind);
    std::vector<Method *> functionCands(const std::string &name, const std::vector<cpp::ExprP> &args,
                                        const cpp::ExprP &callee, int line);
    NT operatorCall(const std::string &op, const std::vector<cpp::ExprP> &kids, int line, bool &found);
    void constructElements(const ThisSrc &base, int off, const NT &arr, int line);
    NT lambda(const cpp::ExprP &e);
    ClassInfo *closureClass(const cpp::ExprP &e, std::vector<std::pair<std::string, bool>> &caps);
    void deduceReturn(Method *m);
    NT autoType(const cpp::TypeNameP &t, const cpp::ExprP &init, int line);
    int typeInfo(const NT &t);
    int pushHandler(int landing);  // a handler record in the frame, made the chain's top
    void popHandler(int rec);      // the chain's top back to the record's predecessor
    void throwExpr(const cpp::ExprP &e);
    void tryStmt(const cpp::StmtP &s);
    void protect(Cleanup &c);      // destroy c's object if an exception passes
    Method *declareMethod(ClassInfo *c, const cpp::DeclP &m);
    void layoutClass(ClassInfo *c);
    Method *newMethod();

    // program pieces
    int importIndex(const std::string &dll, const std::string &name);
    int routine(const std::string &name);
    void function(Method &m);
    void ctorPrologue(Method &m);
    void dtorEpilogue(Method &m);
    void runtime();
    void globalVar(const cpp::DeclP &d);
    void constInit(int off, const NT &t, const cpp::ExprP &init, int line);
    int stringData(const std::string &bytes);
    void fillVtables();

    // values
    void wrap(Kind k, int r = RAX);
    void convKind(Kind from, Kind to); // rax: a `from` value -> a `to` value
    void truth(const NT &t);           // rax: a value -> 0/1 (floats: != 0.0)
    void arithFloat(const std::string &op, Kind k, int line);
    void compareFloat(const std::string &op, Kind k);
    void convert(const NT &to, const NT &from, int line);
    NT expr(const cpp::ExprP &e);
    NT addr(const cpp::ExprP &e);
    NT valueAt(const NT &t);
    NT typeOfExpr(const cpp::ExprP &e);
    NT binary(const cpp::ExprP &e);
    NT assign(const cpp::ExprP &e);
    NT incDec(const cpp::ExprP &e, bool inc, bool post);
    NT call(const cpp::ExprP &e, const ThisSrc *result = nullptr);
    NT callMethod(Method *m, const ThisSrc &self, const std::vector<cpp::ExprP> &args, bool virt, int line,
                  const ThisSrc *result = nullptr);
    Method *resolve(const std::vector<Method *> &cands, const std::vector<cpp::ExprP> &args, const std::string &what,
                    int line);
    int argCost(const NT &param, const cpp::ExprP &arg, const NT &argT);
    Method *findMethod(ClassInfo *c, const std::string &name, std::vector<Method *> &out);
    const Field *findField(ClassInfo *c, const std::string &name, int &off);
    void arith(const std::string &op, Kind k, int line);
    Var *lookup(const std::string &name);
    void pushRax();
    void popReg(int r);
    void copyBytes(int size);
    void bindRef(const NT &ref, const cpp::ExprP &e, int line);
    void loadThis(const ThisSrc &s);
    void construct(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &args, bool braced, int line);
    void destroy(const ThisSrc &self, ClassInfo *c);
    void destroyScopes(size_t downTo);
    void endFullExpr();
    void callRoutine(int label);

    // statements
    void stmt(const cpp::StmtP &s);
    void cond(const cpp::ExprP &e, int falseLabel);
    int newSlot(const NT &t);
    void localInit(int off, const NT &t, const cpp::ExprP &init, int line);
    void declare(const std::string &name, const NT &t, const cpp::ExprP &init, bool braced,
                 const std::vector<cpp::ExprP> &args, int line);
};

Method *Gen::newMethod()
{
    allMethods_.push_back(std::make_unique<Method>());
    Method *m = allMethods_.back().get();
    m->label = a.newLabel();
    return m;
}

// ─── Types ─────────────────────────────────────────────────────────────────

int64_t Gen::constInt(const cpp::ExprP &e)
{
    switch (e->k)
    {
    case cpp::EK::Int:
    {
        Kind k;
        return literalValue(e->str, k);
    }
    case cpp::EK::Char:
        return (int64_t)e->num;
    case cpp::EK::Bool:
        return e->num != 0;
    case cpp::EK::Unary:
        if (e->op == "-")
            return -constInt(e->kids[0]);
        if (e->op == "+")
            return constInt(e->kids[0]);
        if (e->op == "~")
            return ~constInt(e->kids[0]);
        break;
    case cpp::EK::Binary:
    {
        int64_t l = constInt(e->kids[0]), r = constInt(e->kids[1]);
        const std::string &op = e->op;
        if (op == "+") return l + r;
        if (op == "-") return l - r;
        if (op == "*") return l * r;
        if (op == "/" && r) return l / r;
        if (op == "%" && r) return l % r;
        if (op == "<<") return l << r;
        if (op == ">>") return l >> r;
        if (op == "|") return l | r;
        if (op == "&") return l & r;
        break;
    }
    case cpp::EK::SizeofT:
        return sizeOf(typeOf(e->type, e->line));
    case cpp::EK::Name:
        if (e->name.size() == 1 && bind_ && bind_->values.count(e->name[0]))
            return bind_->values[e->name[0]];
        if (e->name.size() == 1)
        {
            Var *v = lookup(e->name[0]);
            if (v && v->global && v->type->cat == C_INT)
            {
                int64_t x = 0; // a constant global: its initial bytes
                int n = kindSize(v->type->kind);
                for (int i = n - 1; i >= 0; --i)
                    x = x * 256 + (unsigned char)data[v->off + i];
                return x;
            }
        }
        break;
    default:
        break;
    }
    fail("a constant was expected here", e->line);
}

NT Gen::baseType(const cpp::TypeNameP &t, int line)
{
    std::vector<std::string> n = t->name;
    if (n.size() == 2 && n[0] == "std")
        n.erase(n.begin());
    if (n.size() == 1 && t->hasTargs && !t->targs.empty() && classTemplates_.count(n[0]))
        return tClass(instantiateClass(n[0], t->targs.back(), line));
    if (n.size() != 1 || t->hasTargs || t->isFunction)
        fail("type " + t->str(), line);
    const std::string &w = n[0];
    if (bind_)
    {
        auto b = bind_->types.find(w);
        if (b != bind_->types.end())
            return b->second;
    }
    if (w == "void")
        return tVoid();
    if (w == "bool")
        return tInt(K_BOOL);
    if (w == "double" || w == "long double")
        return tInt(K_F64);
    if (w == "float")
        return tInt(K_F32);
    if (w == "char" || w == "signed char" || w == "int8_t")
        return tInt(K_I8);
    if (w == "unsigned char" || w == "uint8_t")
        return tInt(K_U8);
    if (w == "short" || w == "short int" || w == "signed short" || w == "int16_t")
        return tInt(K_I16);
    if (w == "unsigned short" || w == "unsigned short int" || w == "uint16_t")
        return tInt(K_U16);
    if (w == "int" || w == "signed" || w == "signed int" || w == "long" || w == "long int" ||
        w == "signed long" || w == "int32_t")
        return tInt(K_I32); // long is 32 bits on Windows
    if (w == "unsigned" || w == "unsigned int" || w == "unsigned long" || w == "unsigned long int" ||
        w == "uint32_t")
        return tInt(K_U32);
    if (w == "long long" || w == "long long int" || w == "signed long long" || w == "int64_t" ||
        w == "ptrdiff_t" || w == "intptr_t")
        return tInt(K_I64);
    if (w == "unsigned long long" || w == "unsigned long long int" || w == "uint64_t" || w == "size_t" ||
        w == "uintptr_t")
        return tInt(K_U64);
    auto it = classes_.find(w);
    if (it != classes_.end())
        return tClass(it->second.get());
    // inside a class template, its own name means the current instance
    if (cur_ && cur_->owner && cur_->owner->templateName == w)
        return tClass(cur_->owner);
    fail("type " + t->str(), line);
}

// The type of `auto x = init` (also auto&, const auto&, auto*)
NT Gen::autoType(const cpp::TypeNameP &t, const cpp::ExprP &init, int line)
{
    if (!init)
        fail("auto without an initializer", line);
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList)
    {
        if (e->kids.size() != 1)
            fail("auto from a braced list", line);
        e = e->kids[0];
    }
    NT v = typeOfExpr(e);
    if (v->cat == C_REF)
        v = v->elem;
    if (t->ref || t->rref)
        return tRef(v, t->isConst);
    if (v->cat == C_ARRAY)
        v = tPtr(v->elem); // decays
    return v;
}

NT Gen::typeOf(const cpp::TypeNameP &t, int line)
{
    if (!t)
        fail("a declaration without a type", line);
    if (t->isAuto())
        fail("auto here (only for variables with an initializer so far)", line);
    NT ty = baseType(t, line);
    for (int i = (int)t->pointeeDims.size() - 1; i >= 0; --i)
        ty = tArray(ty, (int)constInt(t->pointeeDims[i]));
    for (int i = 0; i < t->pointers; ++i)
        ty = tPtr(ty);
    for (int i = (int)t->arrayDims.size() - 1; i >= 0; --i)
        ty = tArray(ty, t->arrayDims[i] ? (int)constInt(t->arrayDims[i]) : 0);
    if (t->ref || t->rref)
        ty = tRef(ty, t->isConst && t->pointers == 0);
    return ty;
}

Method *Gen::declareMethod(ClassInfo *c, const cpp::DeclP &m)
{
    Method *f = newMethod();
    f->name = m->isCtor ? c->name : m->isDtor ? "~" + c->name : m->name.back();
    f->owner = c;
    f->bind = c->bind;
    f->decl = m;
    f->isStatic = m->isStatic;
    f->isVirtual = m->isVirtual;
    f->isPure = m->isPure;
    f->isCtor = m->isCtor;
    f->isDtor = m->isDtor;
    f->ret = m->isCtor || m->isDtor ? tVoid() : typeOf(m->ret, m->line);
    for (const cpp::Param &pr : m->params)
    {
        NT pt = typeOf(pr.type, m->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        f->params.push_back(pt);
        f->defaults.push_back(pr.def);
    }
    if (m->variadic)
        fail("variadic function " + f->name, m->line);
    if (m->isCtor)
        c->ctors.push_back(f);
    else if (m->isDtor)
        c->dtor = f;
    else
        c->methods[f->name].push_back(f);
    return f;
}

void Gen::classDecl(const cpp::DeclP &d, const std::string &instName)
{
    if (d->name.size() != 1 || (d->isTemplate && instName.empty()))
        fail("this class (not yet: nested names)", d->line);
    if (d->isUnion)
        fail("union (not yet)", d->line);
    auto info = std::make_unique<ClassInfo>();
    std::string cname = instName.empty() ? d->name[0] : instName;
    info->name = cname;
    info->bind = bind_;
    if (!instName.empty())
        info->templateName = d->name[0];
    ClassInfo *c = info.get();
    classes_[cname] = std::move(info); // visible to its own pointer members
    if (d->bases.size() > 1)
        fail("multiple inheritance (not yet)", d->line);
    if (d->bases.size() == 1)
    {
        NT b = typeOf(d->bases[0], d->line);
        if (b->cat != C_CLASS)
            fail("base class " + d->bases[0]->str(), d->line);
        c->base = b->cls;
    }
    for (const cpp::DeclP &m : d->members)
    {
        switch (m->k)
        {
        case cpp::DK::Empty:
        case cpp::DK::StaticAssert:
            break;
        case cpp::DK::Var:
            if (m->isStatic)
            {
                // a static data member: a global named Class::member
                std::string g = c->name + "::" + m->var.name;
                c->statics[m->var.name] = g;
                auto copy = std::make_shared<cpp::Decl>(*m);
                copy->var.name = g;
                copy->isStatic = false;
                globalVar(copy);
                break;
            }
            {
                Field f;
                f.name = m->var.name;
                f.type = typeOf(m->var.type, m->line);
                if (f.type->cat == C_CLASS && f.type->cls == c)
                    fail("class " + c->name + " contains itself", m->line);
                if (m->var.init == cpp::VarDeclarator::Brace)
                {
                    f.initBraced = true;
                    f.initArgs = m->var.args;
                }
                else if (!m->var.args.empty())
                {
                    f.init = m->var.args[0];
                    f.initArgs = m->var.args;
                }
                c->fields.push_back(f);
            }
            break;
        case cpp::DK::Func:
            if (m->isDeleted)
                break;
            if (m->isTemplate)
                fail("member template (not yet)", m->line);
            declareMethod(c, m);
            break;
        case cpp::DK::Alias:
            fail("member type alias (not yet)", m->line);
        default:
            fail("this class member (not yet)", m->line);
        }
    }
    layoutClass(c);
}

void Gen::layoutClass(ClassInfo *c)
{
    // virtual functions: the base's table, overriders in their slots, new ones appended
    if (c->base)
        c->vslots = c->base->vslots;
    auto place = [&](Method *f)
    {
        for (size_t i = 0; i < c->vslots.size(); ++i)
            if ((c->vslots[i]->isDtor && f->isDtor) ||
                (c->vslots[i]->name == f->name && c->vslots[i]->params.size() == f->params.size()))
            {
                f->isVirtual = true;
                f->vslot = (int)i;
                c->vslots[i] = f;
                return;
            }
        if (f->isVirtual)
        {
            f->vslot = (int)c->vslots.size();
            c->vslots.push_back(f);
        }
    };
    if (c->dtor)
        place(c->dtor);
    for (auto &kv : c->methods)
        for (Method *f : kv.second)
            place(f);
    c->polymorphic = !c->vslots.empty();
    if (c->polymorphic && c->base && !c->base->polymorphic)
        fail("class " + c->name + " adds virtual functions to a base without any (not yet)", 0);

    int off = 0;
    if (c->base)
    {
        off = c->base->size;
        c->align = c->base->align;
    }
    else if (c->polymorphic)
    {
        off = 8; // the vtable pointer
        c->align = 8;
    }
    for (Field &f : c->fields)
    {
        off = alignUp(off, alignOf(f.type));
        f.off = off;
        off += sizeOf(f.type);
        if (alignOf(f.type) > c->align)
            c->align = alignOf(f.type);
    }
    c->size = alignUp(off == 0 ? 1 : off, c->align);
    if (c->polymorphic)
    {
        while (data.size() % 8)
            data.push_back('\0');
        c->vtableOff = (int)data.size();
        data.append(8 * c->vslots.size(), '\0'); // filled once the code is placed
    }
    // destructors: a user one, or one generated to destroy members and the base
    bool memberDtors = c->base && c->base->needsDtor;
    for (const Field &f : c->fields)
        if (f.type->cat == C_CLASS && f.type->cls->needsDtor)
            memberDtors = true;
        else if (f.type->cat == C_ARRAY && f.type->elem->cat == C_CLASS && f.type->elem->cls->needsDtor)
            fail("an array of objects with destructors as a member (not yet)", 0);
    if (!c->dtor && (memberDtors || (c->base && c->base->dtor && c->base->dtor->isVirtual)))
    {
        Method *d = newMethod();
        d->name = "~" + c->name;
        d->owner = c;
        d->isDtor = true;
        d->ret = tVoid();
        c->dtor = d;
        place(d);
    }
    c->needsDtor = c->dtor != nullptr;
    // the implicit default constructor: needed when there is anything to set
    if (c->ctors.empty())
    {
        bool work = c->polymorphic || (c->base && (c->base->implicitCtor || !c->base->ctors.empty()));
        for (const Field &f : c->fields)
        {
            NT el = f.type;
            while (el->cat == C_ARRAY)
                el = el->elem;
            if (f.init || f.initBraced || (el->cat == C_CLASS && (el->cls->implicitCtor || !el->cls->ctors.empty())))
                work = true;
        }
        if (work)
        {
            Method *m = newMethod();
            m->name = c->name;
            m->owner = c;
            m->isCtor = true;
            m->ret = tVoid();
            c->implicitCtor = m;
        }
    }
}

ClassInfo *Gen::instantiateClass(const std::string &name, const std::vector<cpp::TArg> &targs, int line)
{
    const cpp::DeclP &d = classTemplates_[name];
    auto bind = std::make_shared<Binding>();
    std::string key = name + "<";
    for (size_t i = 0; i < d->templateParams.size(); ++i)
    {
        if (i >= targs.size())
            fail("template " + name + " needs " + std::to_string(d->templateParams.size()) + " arguments", line);
        const std::string &p = d->templateParams[i];
        if (i)
            key += ",";
        if (targs[i].type)
        {
            // a name that is a value (a template's own N) parses as a type
            const cpp::TypeNameP &tt = targs[i].type;
            if (bind_ && tt->name.size() == 1 && bind_->values.count(tt->name[0]))
            {
                bind->values[p] = bind_->values[tt->name[0]];
                key += std::to_string(bind->values[p]);
                continue;
            }
            NT t = typeOf(tt, line);
            bind->types[p] = t;
            key += typeKey(t);
        }
        else
        {
            bind->values[p] = constInt(targs[i].expr);
            key += std::to_string(bind->values[p]);
        }
    }
    key += ">";
    auto it = classes_.find(key);
    if (it != classes_.end())
        return it->second.get();
    BindP saved = bind_;
    Method *savedCur = cur_;
    bind_ = bind;
    cur_ = nullptr;
    classDecl(d, key);
    bind_ = saved;
    cur_ = savedCur;
    return classes_[key].get();
}

Method *Gen::makeFunction(const cpp::DeclP &d, const BindP &bind)
{
    BindP saved = bind_;
    bind_ = bind;
    Method *f = newMethod();
    f->name = d->name[0];
    f->ret = typeOf(d->ret, d->line);
    for (const cpp::Param &pr : d->params)
    {
        NT pt = typeOf(pr.type, d->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        f->params.push_back(pt);
        f->defaults.push_back(pr.def);
    }
    f->decl = d;
    f->bind = bind;
    bind_ = saved;
    return f;
}

// A function template's instance for these arguments (null: they don't fit)
Method *Gen::instantiateFunc(const cpp::DeclP &d, int which, const std::vector<cpp::ExprP> &args,
                             const std::vector<cpp::TArg> &targs, bool explicitArgs, int line)
{
    auto bind = std::make_shared<Binding>();
    const std::vector<std::string> &ps = d->templateParams;
    if (explicitArgs)
        for (size_t i = 0; i < targs.size() && i < ps.size(); ++i)
        {
            if (targs[i].type)
                bind->types[ps[i]] = typeOf(targs[i].type, line);
            else
                bind->values[ps[i]] = constInt(targs[i].expr);
        }
    if (args.size() > d->params.size())
        return nullptr;
    // deduction: a parameter written T, T*, const T& ... takes T from its argument
    for (size_t i = 0; i < args.size(); ++i)
    {
        const cpp::TypeNameP &pt = d->params[i].type;
        if (!pt || pt->name.size() != 1 || pt->hasTargs)
            continue;
        const std::string &tn = pt->name[0];
        bool isParam = false;
        for (const std::string &p : ps)
            if (p == tn)
                isParam = true;
        if (!isParam || bind->types.count(tn))
            continue;
        NT at = typeOfExpr(args[i]);
        if (at->cat == C_REF)
            at = at->elem;
        for (int k = 0; k < pt->pointers; ++k)
        {
            if (at->cat != C_PTR)
                return nullptr;
            at = at->elem;
        }
        if (at->cat == C_INT && args[i]->k == cpp::EK::Char && pt->pointers == 0)
            at = tInt(K_I8);
        bind->types[tn] = at;
    }
    std::string key = d->name[0] + "<";
    for (const std::string &p : ps)
    {
        if (bind->types.count(p))
            key += typeKey(bind->types[p]) + ",";
        else if (bind->values.count(p))
            key += std::to_string(bind->values[p]) + ",";
        else
            return nullptr; // not deducible from these arguments
    }
    key += ">#" + std::to_string(which); // which template of that name
    auto it = funcInstances_.find(key);
    if (it != funcInstances_.end())
        return it->second;
    Method *f = makeFunction(d, bind);
    funcInstances_[key] = f;
    return f;
}

// The functions a call by name may mean: the plain ones and template instances
std::vector<Method *> Gen::functionCands(const std::string &name, const std::vector<cpp::ExprP> &args,
                                         const cpp::ExprP &callee, int line)
{
    std::vector<Method *> cands;
    bool explicitArgs = callee && callee->hasTargs;
    if (!explicitArgs)
    {
        auto it = funcs_.find(name);
        if (it != funcs_.end())
            cands = it->second;
    }
    auto t = funcTemplates_.find(name);
    if (t != funcTemplates_.end())
        for (size_t i = 0; i < t->second.size(); ++i)
        {
            std::vector<cpp::TArg> none;
            Method *m = instantiateFunc(t->second[i], (int)i, args, callee ? callee->targs : none, explicitArgs, line);
            if (m)
                cands.push_back(m);
        }
    return cands;
}

// ─── Program ───────────────────────────────────────────────────────────────

int Gen::importIndex(const std::string &dll, const std::string &name)
{
    for (int i = 0; i < (int)imports.size(); ++i)
        if (imports[i].dll == dll && imports[i].name == name)
            return i;
    imports.push_back({dll, name});
    return (int)imports.size() - 1;
}

int Gen::routine(const std::string &name)
{
    auto it = runtime_.find(name);
    if (it != runtime_.end())
        return it->second;
    int l = a.newLabel();
    runtime_[name] = l;
    if (name == "puts")
        routine("putchar");
    return l;
}

int Gen::stringData(const std::string &bytes)
{
    int off = (int)data.size();
    data += bytes;
    data.push_back('\0');
    return off;
}

void Gen::program(const cpp::Program &p)
{
    // the exception state: four 8-byte globals
    while (data.size() % 8)
        data.push_back('\0');
    ehTop_ = (int)data.size();
    ehObj_ = ehTop_ + 8;
    ehType_ = ehTop_ + 16;
    ehDtor_ = ehTop_ + 24;
    data.append(32, '\0');
    // types and every function first, so a call may come before the definition
    std::vector<cpp::DeclP> outOfClass;
    for (const cpp::DeclP &d : p.decls)
    {
        switch (d->k)
        {
        case cpp::DK::Class:
            if (d->isTemplate)
            {
                if (!d->forwardOnly)
                    classTemplates_[d->name[0]] = d;
                break;
            }
            if (!d->forwardOnly)
                classDecl(d);
            break;
        case cpp::DK::Func:
        {
            if (d->isTemplate)
            {
                if (d->name.size() != 1)
                    fail("a member template defined outside its class (not yet)", d->line);
                if (d->body)
                    funcTemplates_[d->name[0]].push_back(d);
                break;
            }
            if (d->name.size() == 2)
            {
                outOfClass.push_back(d); // Class::member defined outside the class
                break;
            }
            if (d->name.size() != 1)
                fail("function " + d->name.back(), d->line);
            if (d->variadic)
                fail("variadic function " + d->name[0], d->line);
            Method tmp;
            tmp.ret = typeOf(d->ret, d->line);
            for (const cpp::Param &pr : d->params)
            {
                NT pt = typeOf(pr.type, d->line);
                if (pt->cat == C_ARRAY)
                    pt = tPtr(pt->elem);
                tmp.params.push_back(pt);
                tmp.defaults.push_back(pr.def);
            }
            Method *same = nullptr;
            for (Method *f : funcs_[d->name[0]])
            {
                bool eq = f->params.size() == tmp.params.size();
                for (size_t i = 0; eq && i < tmp.params.size(); ++i)
                    eq = sameType(f->params[i], tmp.params[i]);
                if (eq)
                    same = f;
            }
            if (same)
            {
                if (d->body)
                {
                    if (same->decl && same->decl->body)
                        fail("function " + d->name[0] + " defined twice", d->line);
                    same->decl = d;
                    for (size_t i = 0; i < tmp.defaults.size(); ++i)
                        if (tmp.defaults[i])
                            same->defaults[i] = tmp.defaults[i];
                }
                break;
            }
            Method *f = newMethod();
            f->name = d->name[0];
            f->ret = tmp.ret;
            f->params = tmp.params;
            f->defaults = tmp.defaults;
            f->decl = d;
            funcs_[d->name[0]].push_back(f);
            break;
        }
        case cpp::DK::Var:
            if (d->name.size() == 2 || d->var.name.find("::") != std::string::npos)
            {
                outOfClass.push_back(d); // int Class::count = 0;
                break;
            }
            globalVar(d);
            break;
        case cpp::DK::UsingDirective:
        case cpp::DK::Empty:
        case cpp::DK::StaticAssert:
            break;
        default:
            fail("this declaration (not yet)", d->line);
        }
    }
    // out-of-class definitions: the body of a declared member
    for (const cpp::DeclP &d : outOfClass)
    {
        auto ci = classes_.find(d->name[0]);
        if (ci == classes_.end())
            fail("unknown class " + d->name[0], d->line);
        ClassInfo *c = ci->second.get();
        if (d->k == cpp::DK::Var)
        {
            auto s = c->statics.find(d->name[1]);
            if (s == c->statics.end())
                fail(d->name[1] + " is not a static member of " + c->name, d->line);
            Var &g = globals_[s->second];
            const cpp::VarDeclarator &v = d->var;
            if (!v.args.empty())
            {
                cpp::ExprP init = v.args[0];
                if (v.init == cpp::VarDeclarator::Brace || v.args.size() > 1)
                {
                    auto list = std::make_shared<cpp::Expr>();
                    list->k = cpp::EK::InitList;
                    list->kids = v.args;
                    init = list;
                }
                constInit(g.off, g.type, init, d->line);
            }
            continue;
        }
        std::vector<Method *> cands;
        if (d->isCtor || d->name[1] == c->name)
            cands = c->ctors;
        else if (d->isDtor || d->name[1][0] == '~')
            cands = {c->dtor};
        else
            cands = c->methods[d->name[1]];
        Method *target = nullptr;
        for (Method *f : cands)
        {
            if (!f || f->params.size() != d->params.size())
                continue;
            bool eq = true;
            for (size_t i = 0; eq && i < d->params.size(); ++i)
            {
                NT pt = typeOf(d->params[i].type, d->line);
                if (pt->cat == C_ARRAY)
                    pt = tPtr(pt->elem);
                eq = sameType(pt, f->params[i]);
            }
            if (eq)
                target = f;
        }
        if (!target)
            fail(c->name + "::" + d->name[1] + " was not declared in the class", d->line);
        if (target->decl && target->decl->body)
            fail(c->name + "::" + d->name[1] + " defined twice", d->line);
        auto merged = std::make_shared<cpp::Decl>(*target->decl);
        merged->body = d->body;
        merged->inits = d->inits;
        merged->params = d->params; // the definition's parameter names
        target->decl = merged;
    }

    Method *mainFn = nullptr;
    for (Method *f : funcs_["main"])
        mainFn = f;
    if (!mainFn || !mainFn->decl->body)
        fail("no main()", 0);
    if (!mainFn->params.empty())
        fail("main with parameters (not yet)", mainFn->decl->line);

    // entry: global objects are constructed, main runs, they are destroyed in
    // reverse, and main's result is the exit code
    entry = a.size();
    a.push(RBP);
    a.movRR(RBP, RSP);
    a.subRsp(32);
    scopes_.assign(1, Scope());
    depth_ = 0;
    for (auto &g : globalCtorInits_)
    {
        const cpp::DeclP &d = g.second;
        ThisSrc self;
        self.kind = TH_GLOBAL;
        self.off = g.first;
        NT t = typeOf(d->var.type, d->line);
        construct(self, t->cls, d->var.args, d->var.init == cpp::VarDeclarator::Brace, d->line);
    }
    a.subRsp(32);
    a.call(mainFn->label);
    a.addRsp(32);
    a.store(-8, RAX);
    for (int i = (int)globalObjects_.size() - 1; i >= 0; --i)
    {
        ThisSrc self;
        self.kind = TH_GLOBAL;
        self.off = globalObjects_[i].first;
        destroy(self, globalObjects_[i].second);
    }
    a.load(RCX, -8);
    a.callImport(importIndex("kernel32.dll", "ExitProcess"));

    // (instances made while generating code join the list)
    for (size_t mi = 0; mi < allMethods_.size(); ++mi)
    {
        Method *m = allMethods_[mi].get();
        if (!m->ret)
            deduceReturn(m);
        if (m->isPure && (!m->decl || !m->decl->body))
            continue;
        bool generated = !m->decl;
        if (!generated && !m->decl->body)
        {
            if (m->owner && (m->isCtor || m->isDtor) && m->decl->isDefault)
                generated = true;
            else
                fail("function " + m->name + " is declared but not defined", m->decl->line);
        }
        function(*m);
    }
    runtime();
    a.resolve();
    fillVtables();
}

void Gen::fillVtables()
{
    for (auto &kv : classes_)
    {
        ClassInfo *c = kv.second.get();
        for (size_t i = 0; i < c->vslots.size(); ++i)
        {
            Method *m = c->vslots[i];
            uint64_t v = m->isPure && (!m->decl || !m->decl->body) ? 0 : kCodeBase + (uint64_t)a.labelPos(m->label);
            for (int b = 0; b < 8; ++b)
                data[c->vtableOff + 8 * i + b] = (char)((v >> (8 * b)) & 255);
        }
    }
}

void Gen::globalVar(const cpp::DeclP &d)
{
    if (d->isExtern)
        fail("extern variable " + d->var.name, d->line);
    NT t = typeOf(d->var.type, d->line);
    const cpp::VarDeclarator &v = d->var;
    if (t->cat == C_REF)
        fail("a global reference (not yet)", d->line);
    cpp::ExprP init;
    if (v.args.size() == 1 && v.init != cpp::VarDeclarator::Brace)
        init = v.args[0];
    else if (!v.args.empty() || v.init == cpp::VarDeclarator::Brace)
    {
        auto list = std::make_shared<cpp::Expr>();
        list->k = cpp::EK::InitList;
        list->line = d->line;
        list->kids = v.args;
        if (v.args.size() == 1 && v.args[0]->k == cpp::EK::InitList)
            list = v.args[0];
        init = list;
    }
    if (t->cat == C_ARRAY && t->n == 0 && init)
        t = tArray(t->elem, init->k == cpp::EK::Str ? (int)init->str.size() + 1 : (int)init->kids.size());
    int align = alignOf(t);
    while (data.size() % align)
        data.push_back('\0');
    int off = (int)data.size();
    data.append(sizeOf(t), '\0');
    globals_[v.name] = Var{t, true, off};
    if (t->cat == C_CLASS && (!t->cls->ctors.empty() || t->cls->implicitCtor || t->cls->polymorphic))
    {
        globalCtorInits_.push_back({off, d}); // constructed by code before main
        if (t->cls->needsDtor)
            globalObjects_.push_back({off, t->cls});
        return;
    }
    if (t->cat == C_CLASS && t->cls->needsDtor)
        globalObjects_.push_back({off, t->cls});
    if (init)
        constInit(off, t, init, d->line);
}

// a global's initial bytes, from constants
void Gen::constInit(int off, const NT &t, const cpp::ExprP &init, int line)
{
    if (t->cat == C_ARRAY && t->elem->cat == C_INT && t->elem->kind == K_I8 && init->k == cpp::EK::Str)
    {
        for (size_t i = 0; i < init->str.size() && (int)i < t->n; ++i)
            data[off + i] = init->str[i];
        return;
    }
    if (t->cat == C_ARRAY || t->cat == C_CLASS)
    {
        if (init->k != cpp::EK::InitList)
            fail("initializer of an array or class", line);
        for (size_t i = 0; i < init->kids.size(); ++i)
        {
            if (t->cat == C_ARRAY)
            {
                if ((int)i >= t->n)
                    fail("too many initializers", line);
                constInit(off + (int)i * sizeOf(t->elem), t->elem, init->kids[i], line);
            }
            else
            {
                if (i >= t->cls->fields.size())
                    fail("too many initializers", line);
                const Field &f = t->cls->fields[i];
                constInit(off + f.off, f.type, init->kids[i], line);
            }
        }
        return;
    }
    if (t->cat == C_PTR)
        fail("a global pointer with an initial value (not yet)", line);
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList && e->kids.size() == 1)
        e = e->kids[0];
    if (e->k == cpp::EK::InitList && e->kids.empty())
        return;
    if (isFloat(t->kind))
    {
        double dv;
        if (e->k == cpp::EK::Float)
            dv = e->num;
        else if (e->k == cpp::EK::Unary && e->op == "-" && e->kids[0]->k == cpp::EK::Float)
            dv = -e->kids[0]->num;
        else
            dv = (double)constInt(e);
        uint64_t bits = t->kind == K_F64 ? ieeeBits(dv, 52, 1023) : ieeeBits(dv, 23, 127);
        for (int i = 0; i < kindSize(t->kind); ++i)
            data[off + i] = (char)((bits >> (8 * i)) & 255);
        return;
    }
    int64_t v = constInt(e);
    if (t->kind == K_BOOL)
        v = v != 0;
    for (int i = 0; i < kindSize(t->kind); ++i)
        data[off + i] = (char)((v >> (8 * i)) & 255);
}

void Gen::function(Method &m)
{
    BindP savedBind = bind_;
    bind_ = m.bind;
    a.bind(m.label);
    a.push(RBP);
    a.movRR(RBP, RSP);
    a.subRsp(0);
    int framePos = a.size() - 4;
    cur_ = &m;
    scopes_.assign(1, Scope());
    loops_.clear();
    temps_.clear();
    nextOff_ = 0;
    depth_ = 0;
    retLabel_ = a.newLabel();
    retType_ = m.ret;
    nrvoName_.clear();
    if (m.ret->cat == C_CLASS && m.decl && m.decl->body)
    {
        std::vector<cpp::ExprP> rets;
        bool other = false;
        std::vector<cpp::StmtP> todo = {m.decl->body};
        while (!todo.empty())
        {
            cpp::StmtP x = todo.back();
            todo.pop_back();
            if (!x)
                continue;
            if (x->k == cpp::SK::Return)
            {
                if (x->expr && x->expr->k == cpp::EK::Name && x->expr->name.size() == 1)
                    rets.push_back(x->expr);
                else
                    other = true;
            }
            for (const cpp::StmtP &y : x->body)
                todo.push_back(y);
            todo.push_back(x->then);
            todo.push_back(x->els);
            todo.push_back(x->init);
        }
        bool same = !rets.empty() && !other;
        for (const cpp::ExprP &r : rets)
            if (r->name[0] != rets[0]->name[0])
                same = false;
        for (const cpp::Param &pr : m.decl->params)
            if (!rets.empty() && pr.name == rets[0]->name[0])
                same = false;
        if (same)
            nrvoName_ = rets[0]->name[0];
    }
    // arguments: the first four arrive in registers and go to their home
    // slots above the return address; the rest are already there
    int slot = 0;
    auto home = [&](int i) { return 16 + 8 * i; };
    if (m.ret->cat == C_CLASS)
        retPtrOff_ = home(slot++);
    if (m.owner && !m.isStatic)
        thisOff_ = home(slot++);
    int nargs = slot + (int)m.params.size();
    for (int i = 0; i < nargs && i < 4; ++i)
        a.store(home(i), kArgRegs[i]);
    if (m.decl)
        for (size_t i = 0; i < m.params.size(); ++i)
        {
            NT pt = m.params[i];
            if (pt->cat == C_CLASS)
                pt = tRef(pt, false); // by value: a pointer to the caller's copy
            if (i < m.decl->params.size() && !m.decl->params[i].name.empty())
                scopes_.back().vars[m.decl->params[i].name] = Var{pt, false, home(slot + (int)i)};
        }
    if (m.isCtor)
        ctorPrologue(m);
    if (m.decl && m.decl->body)
        for (const cpp::StmtP &s : m.decl->body->body)
            stmt(s);
    destroyScopes(0);
    a.movImm(RAX, 0); // falling off the end (main returns 0)
    a.bind(retLabel_);
    if (m.isDtor)
        dtorEpilogue(m);
    if (m.ret->cat == C_CLASS)
        a.load(RAX, retPtrOff_);
    a.leave();
    a.ret();
    a.patch32(framePos, alignUp(-nextOff_, 16));
    cur_ = nullptr;
    bind_ = savedBind;
}

// A constructor's work before its body: the base, the vtable pointer, the members
void Gen::ctorPrologue(Method &m)
{
    ClassInfo *c = m.owner;
    std::vector<cpp::MemInit> inits;
    if (m.decl)
        inits = m.decl->inits;
    auto initFor = [&](const std::string &name) -> const cpp::MemInit *
    {
        for (const cpp::MemInit &mi : inits)
            if (mi.name == name)
                return &mi;
        return nullptr;
    };
    ThisSrc self;
    self.kind = TH_CUR;
    if (c->base)
    {
        const cpp::MemInit *bi = initFor(c->base->name);
        std::vector<cpp::ExprP> none;
        construct(self, c->base, bi ? bi->args : none, bi && bi->braced, m.decl ? m.decl->line : 0);
    }
    if (c->polymorphic)
    {
        a.load(RCX, thisOff_);
        a.leaData(RAX, c->vtableOff);
        a.storeRcx(8);
    }
    for (const Field &f : c->fields)
    {
        const cpp::MemInit *mi = initFor(f.name);
        std::vector<cpp::ExprP> args;
        bool braced = false;
        if (mi)
        {
            args = mi->args;
            braced = mi->braced;
        }
        else if (f.init || f.initBraced)
        {
            args = f.initArgs;
            braced = f.initBraced;
        }
        int line = m.decl ? m.decl->line : 0;
        if (f.type->cat == C_ARRAY && args.empty())
        {
            ThisSrc ts;
            ts.kind = TH_CUR;
            constructElements(ts, f.off, f.type, line);
            continue;
        }
        if (f.type->cat == C_CLASS)
        {
            if (args.size() == 1 && !braced)
            {
                NT at = typeOfExpr(args[0]);
                if (at->cat == C_CLASS && at->cls == f.type->cls && f.type->cls->ctors.empty())
                {
                    // a copy: memberwise
                    expr(args[0]);
                    a.movRR(RSI, RAX);
                    a.load(RDI, thisOff_);
                    if (f.off)
                        a.addImm(RDI, f.off);
                    copyBytes(sizeOf(f.type));
                    endFullExpr();
                    continue;
                }
            }
            a.load(RAX, thisOff_);
            if (f.off)
                a.addImm(RAX, f.off);
            int tmp = newSlot(tPtr(tVoid()));
            a.store(tmp, RAX);
            ThisSrc fs;
            fs.kind = TH_INDIRECT;
            fs.off = tmp;
            construct(fs, f.type->cls, args, braced, line);
            continue;
        }
        if (args.empty())
            continue; // zeroed memory
        if (f.type->cat == C_REF)
        {
            bindRef(f.type, args[0], line);
            a.movRR(RDX, RAX);
            a.load(RCX, thisOff_);
            if (f.off)
                a.addImm(RCX, f.off);
            a.movRR(RAX, RDX);
            a.storeRcx(8);
            endFullExpr();
            continue;
        }
        if (f.type->cat == C_ARRAY)
        {
            if (!braced)
                fail("initializing an array member", line);
            fail("an array member's initializer list (not yet)", line);
        }
        if (args.size() != 1)
            fail("initializer of member " + f.name, line);
        NT vt = expr(args[0]);
        if (f.type->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT))
            ;
        else
            convert(f.type, vt, line);
        a.movRR(RDX, RAX);
        a.load(RCX, thisOff_);
        if (f.off)
            a.addImm(RCX, f.off);
        a.movRR(RAX, RDX);
        a.storeRcx(sizeOf(f.type));
        endFullExpr();
    }
}

// Default-constructs the class elements of the array at `off` in base's object
void Gen::constructElements(const ThisSrc &base, int off, const NT &arr, int line)
{
    NT el = arr;
    int count = 1;
    while (el->cat == C_ARRAY)
    {
        count *= el->n;
        el = el->elem;
    }
    if (el->cat != C_CLASS || (el->cls->ctors.empty() && !el->cls->implicitCtor))
        return;
    if (count > 64)
        fail("an array of more than 64 objects with constructors (not yet)", line);
    for (int i = 0; i < count; ++i)
    {
        loadThis(base);
        a.addImm(RAX, off + i * el->cls->size);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc es;
        es.kind = TH_INDIRECT;
        es.off = tmp;
        std::vector<cpp::ExprP> none;
        construct(es, el->cls, none, false, line);
    }
}

// A destructor's work after its body: the members in reverse, then the base
void Gen::dtorEpilogue(Method &m)
{
    ClassInfo *c = m.owner;
    for (int i = (int)c->fields.size() - 1; i >= 0; --i)
    {
        const Field &f = c->fields[i];
        if (f.type->cat != C_CLASS || !f.type->cls->needsDtor)
            continue;
        a.load(RAX, thisOff_);
        if (f.off)
            a.addImm(RAX, f.off);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc fs;
        fs.kind = TH_INDIRECT;
        fs.off = tmp;
        destroy(fs, f.type->cls);
    }
    if (c->base && c->base->needsDtor)
    {
        a.load(RAX, thisOff_);
        int tmp = newSlot(tPtr(tVoid()));
        a.store(tmp, RAX);
        ThisSrc bs;
        bs.kind = TH_INDIRECT;
        bs.off = tmp;
        // the base part only: no virtual dispatch
        a.load(RCX, tmp);
        int pad = (depth_ + 4) % 2;
        if (pad)
            a.subRsp(8);
        a.subRsp(32);
        a.call(c->base->dtor->label);
        a.addRsp(32 + 8 * pad);
    }
}

// The runtime: routines the program uses, in machine code
void Gen::runtime()
{
    for (auto &kv : runtime_)
    {
        const std::string &name = kv.first;
        a.bind(kv.second);
        a.push(RBP);
        a.movRR(RBP, RSP);
        a.subRsp(64);
        if (name == "putchar")
        {
            // one byte to standard output; '\n' is written as "\r\n", as the
            // C runtime's text-mode stdout does
            a.movzx8(RCX);
            a.store(-24, RCX); // the result
            a.store(16, RCX);  // the bytes to write, in the home slot
            a.movImm(RAX, 1);
            a.store(-16, RAX); // how many
            int plain = a.newLabel();
            a.movImm(RAX, 10);
            a.alu(0x39, RCX, RAX);
            a.jcc(CC_NE, plain);
            a.movImm(RAX, 0x0A0D);
            a.store(16, RAX);
            a.movImm(RAX, 2);
            a.store(-16, RAX);
            a.bind(plain);
            a.movImm(RCX, -11); // STD_OUTPUT_HANDLE
            a.callImport(importIndex("kernel32.dll", "GetStdHandle"));
            a.movRR(RCX, RAX);
            a.lea(RDX, 16);
            a.load(R8, -16);
            a.lea(R9, -8); // bytes written
            a.movImm(RAX, 0);
            a.storeRsp(32, RAX); // no OVERLAPPED
            a.callImport(importIndex("kernel32.dll", "WriteFile"));
            a.load(RAX, -24);
        }
        else if (name == "puts")
        {
            // the string's bytes, then a newline
            a.store(16, RCX);
            int top = a.newLabel(), done = a.newLabel();
            a.bind(top);
            a.load(RCX, 16);
            a.loadRcx(1, false);
            a.test(RAX, RAX);
            a.jcc(CC_E, done);
            a.movRR(RCX, RAX);
            a.call(runtime_["putchar"]);
            a.load(RAX, 16);
            a.addImm(RAX, 1);
            a.store(16, RAX);
            a.jmp(top);
            a.bind(done);
            a.movImm(RCX, 10);
            a.call(runtime_["putchar"]);
            a.movImm(RAX, 0);
        }
        else if (name == "alloc")
        {
            // zeroed memory from the process heap
            a.store(16, RCX);
            a.callImport(importIndex("kernel32.dll", "GetProcessHeap"));
            a.movRR(RCX, RAX);
            a.movImm(RDX, 8); // HEAP_ZERO_MEMORY
            a.load(R8, 16);
            a.callImport(importIndex("kernel32.dll", "HeapAlloc"));
        }
        else if (name == "free")
        {
            a.store(16, RCX);
            int skip = a.newLabel();
            a.test(RCX, RCX);
            a.jcc(CC_E, skip);
            a.callImport(importIndex("kernel32.dll", "GetProcessHeap"));
            a.movRR(RCX, RAX);
            a.movImm(RDX, 0);
            a.load(R8, 16);
            a.callImport(importIndex("kernel32.dll", "HeapFree"));
            a.bind(skip);
            a.movImm(RAX, 0);
        }
        else if (name == "throw")
        {
            // the newest handler record: popped, its frame restored, its landing pad run
            int none = a.newLabel();
            a.leaData(RCX, ehTop_);
            a.loadRcx(8, false);
            a.test(RAX, RAX);
            a.jcc(CC_E, none);
            a.loadInd(RCX, RAX); // the record before it
            a.leaData(RDX, ehTop_);
            a.storeInd(RDX, RCX);
            a.loadDisp(RBP, RAX, 8);
            a.loadDisp(RSP, RAX, 16);
            a.loadDisp(RAX, RAX, 24);
            a.jmpReg(RAX);
            a.bind(none);
            // nothing catches it: abort's exit code
            a.movImm(RCX, 3);
            a.callImport(importIndex("kernel32.dll", "ExitProcess"));
        }
        else if (name == "pure")
        {
            // a pure virtual function called: exit code 3, as abort() gives
            a.movImm(RCX, 3);
            a.callImport(importIndex("kernel32.dll", "ExitProcess"));
        }
        a.leave();
        a.ret();
    }
}

// ─── Values ────────────────────────────────────────────────────────────────

Gen::Var *Gen::lookup(const std::string &name)
{
    for (int i = (int)scopes_.size() - 1; i >= 0; --i)
    {
        auto it = scopes_[i].vars.find(name);
        if (it != scopes_[i].vars.end())
            return &it->second;
    }
    auto g = globals_.find(name);
    return g == globals_.end() ? nullptr : &g->second;
}

int Gen::newSlot(const NT &t)
{
    nextOff_ -= alignUp(sizeOf(t), 8);
    return nextOff_;
}

void Gen::pushRax()
{
    a.push(RAX);
    ++depth_;
}

void Gen::popReg(int r)
{
    a.pop(r);
    --depth_;
}

// a call of a routine with its arguments in registers already
void Gen::callRoutine(int label)
{
    int pad = (depth_ + 4) % 2;
    if (pad)
        a.subRsp(8);
    a.subRsp(32);
    a.call(label);
    a.addRsp(32 + 8 * pad);
}

void Gen::wrap(Kind k, int r)
{
    switch (k)
    {
    case K_BOOL:
        if (r != RAX)
            a.movRR(RAX, r);
        a.test(RAX, RAX);
        a.setcc(CC_NE);
        if (r != RAX)
            a.movRR(r, RAX);
        break;
    case K_I8: a.movsx8(r); break;
    case K_U8: a.movzx8(r); break;
    case K_I16: a.movsx16(r); break;
    case K_U16: a.movzx16(r); break;
    case K_I32: a.movsxd(r); break;
    case K_U32: a.movzx32(r); break;
    default: break;
    }
}

void Gen::convKind(Kind from, Kind to)
{
    if (from == to)
        return;
    if (!isFloat(from) && !isFloat(to))
    {
        wrap(to);
        return;
    }
    if (isFloat(from) && isFloat(to))
    {
        a.toXmm(0, RAX, from == K_F64);
        a.sse(from == K_F64 ? 0xF2 : 0xF3, 0x5A, 0, 0); // cvtsd2ss / cvtss2sd
        a.fromXmm(RAX, 0, to == K_F64);
        return;
    }
    if (isFloat(to))
    {
        int pre = to == K_F64 ? 0xF2 : 0xF3;
        if (from == K_U64)
        {
            // an unsigned value from 2^63 up: halve it (keeping the low bit), convert, double
            int big = a.newLabel(), done = a.newLabel();
            a.test(RAX, RAX);
            a.jcc(0x8, big); // js
            a.sse(pre, 0x2A, 0, RAX, true);
            a.jmp(done);
            a.bind(big);
            a.movRR(RDX, RAX);
            a.movImm(RCX, 1);
            a.shiftCl(5, RDX);       // rdx = rax >> 1
            a.alu(0x21, RAX, RCX);   // rax &= 1
            a.alu(0x09, RDX, RAX);   // rdx |= rax
            a.sse(pre, 0x2A, 0, RDX, true);
            a.sse(pre, 0x58, 0, 0);  // x + x
            a.bind(done);
            a.fromXmm(RAX, 0, to == K_F64);
            return;
        }
        a.sse(pre, 0x2A, 0, RAX, true); // cvtsi2sd/ss xmm0, rax
        a.fromXmm(RAX, 0, to == K_F64);
        return;
    }
    // float -> integer: truncation toward zero
    if (to == K_BOOL)
    {
        truth(tInt(from));
        return;
    }
    a.toXmm(0, RAX, from == K_F64);
    a.sse(from == K_F64 ? 0xF2 : 0xF3, 0x2C, RAX, 0, true); // cvttsd2si / cvttss2si rax, xmm0
    wrap(to);
}

void Gen::truth(const NT &t)
{
    if (t->cat != C_INT || !isFloat(t->kind))
        return;
    bool d = t->kind == K_F64;
    a.toXmm(0, RAX, d);
    a.sse(0x66, 0x57, 1, 1);          // xorpd xmm1, xmm1
    a.sse(d ? 0x66 : 0, 0x2E, 0, 1);  // ucomisd/ss xmm0, xmm1
    a.byte(0x0F);
    a.byte(0x95);
    a.byte(0xC0); // setne al
    a.byte(0x0F);
    a.byte(0x9A);
    a.byte(0xC1); // setp cl (NaN is true)
    a.byte(0x08);
    a.byte(0xC8); // or al, cl
    a.movzx8(RAX);
}

void Gen::arithFloat(const std::string &op, Kind k, int line)
{
    bool d = k == K_F64;
    int pre = d ? 0xF2 : 0xF3;
    a.toXmm(0, RAX, d);
    a.toXmm(1, RCX, d);
    if (op == "+")
        a.sse(pre, 0x58, 0, 1);
    else if (op == "-")
        a.sse(pre, 0x5C, 0, 1);
    else if (op == "*")
        a.sse(pre, 0x59, 0, 1);
    else if (op == "/")
        a.sse(pre, 0x5E, 0, 1);
    else
        fail("operator " + op + " on floating point", line);
    a.fromXmm(RAX, 0, d);
}

// rax = (rax op rcx) for two floating-point values; NaN compares unequal
void Gen::compareFloat(const std::string &op, Kind k)
{
    bool d = k == K_F64;
    a.toXmm(0, RAX, d);
    a.toXmm(1, RCX, d);
    int pre = d ? 0x66 : 0;
    if (op == "<" || op == "<=")
        a.sse(pre, 0x2E, 1, 0); // ucomis b, a: a < b is b above a
    else
        a.sse(pre, 0x2E, 0, 1);
    if (op == "==" || op == "!=")
    {
        bool eq = op == "==";
        a.byte(0x0F);
        a.byte(eq ? 0x94 : 0x95);
        a.byte(0xC0); // sete / setne al
        a.byte(0x0F);
        a.byte(eq ? 0x9B : 0x9A);
        a.byte(0xC1); // setnp / setp cl
        a.byte(eq ? 0x20 : 0x08);
        a.byte(0xC8); // and / or al, cl
        a.movzx8(RAX);
        return;
    }
    a.setcc(op == "<" || op == ">" ? CC_A : CC_AE);
}

void Gen::convert(const NT &to, const NT &from, int line)
{
    if (to->cat == C_VOID)
        return;
    if (to->cat == C_PTR && from->cat == C_PTR)
    {
        bool ok = to->elem->cat == C_VOID || sameType(to->elem, from->elem) ||
                  (to->elem->cat == C_CLASS && from->elem->cat == C_CLASS && derivesFrom(from->elem->cls, to->elem->cls)) ||
                  from->elem->cat == C_VOID;
        if (!ok)
            fail("converting between unrelated pointer types", line);
        return;
    }
    if (!isScalar(to) || !isScalar(from))
    {
        if (to->cat == C_CLASS && from->cat == C_CLASS && derivesFrom(from->cls, to->cls))
            return;
        fail("this conversion", line);
    }
    if (to->cat == C_PTR)
        fail("converting an integer to a pointer", line);
    if (to->cat == C_INT)
        convKind(from->cat == C_INT ? from->kind : K_U64, to->kind);
}

NT Gen::valueAt(const NT &t)
{
    if (t->cat == C_ARRAY)
        return tPtr(t->elem); // decays to its first element's address
    if (t->cat == C_CLASS)
        return t;
    a.movRR(RCX, RAX);
    if (t->cat == C_PTR)
        a.loadRcx(8, false);
    else
        a.loadRcx(kindSize(t->kind), !isUnsigned(t->kind) && !isFloat(t->kind));
    return t;
}

// The type an expression would have: its code is generated and dropped
NT Gen::typeOfExpr(const cpp::ExprP &e)
{
    std::map<const Binding *, NT> &memo = typeMemo_[e.get()];
    auto known = memo.find(bind_.get());
    if (known != memo.end() && cur_ && !scopes_.empty())
        return known->second;
    Asm::Mark m = a.mark();
    int depth = depth_, next = nextOff_;
    size_t temps = temps_.size();
    NT t = expr(e);
    a.rewind(m);
    depth_ = depth;
    nextOff_ = next;
    temps_.resize(temps);
    memo[bind_.get()] = t;
    return t;
}

const Field *Gen::findField(ClassInfo *c, const std::string &name, int &off)
{
    for (ClassInfo *k = c; k; k = k->base)
        for (const Field &f : k->fields)
            if (f.name == name)
            {
                off = f.off;
                return &f;
            }
    return nullptr;
}

Method *Gen::findMethod(ClassInfo *c, const std::string &name, std::vector<Method *> &out)
{
    for (ClassInfo *k = c; k; k = k->base)
    {
        auto it = k->methods.find(name);
        if (it != k->methods.end())
        {
            out = it->second;
            return out.front();
        }
    }
    return nullptr;
}

void Gen::loadThis(const ThisSrc &s)
{
    switch (s.kind)
    {
    case TH_OBJ:
    {
        NT t = addr(s.e);
        if (t->cat != C_CLASS)
            fail("a member call on a non-object", s.e->line);
        break;
    }
    case TH_PTR:
    {
        NT t = expr(s.e);
        if (t->cat != C_PTR || t->elem->cat != C_CLASS)
            fail("-> on a non-object pointer", s.e->line);
        break;
    }
    case TH_CUR:
        a.load(RAX, thisOff_);
        break;
    case TH_LOCAL:
        a.lea(RAX, s.off);
        break;
    case TH_INDIRECT:
        a.load(RAX, s.off);
        break;
    case TH_GLOBAL:
        a.leaData(RAX, s.off);
        break;
    default:
        break;
    }
}

NT Gen::addr(const cpp::ExprP &e)
{
    switch (e->k)
    {
    case cpp::EK::Name:
    {
        if (e->name.size() == 2)
        {
            auto ci = classes_.find(e->name[0]);
            if (ci != classes_.end())
            {
                auto s = ci->second->statics.find(e->name[1]);
                if (s != ci->second->statics.end())
                {
                    Var &g = globals_[s->second];
                    a.leaData(RAX, g.off);
                    return g.type;
                }
            }
            fail("name " + e->name[0] + "::" + e->name[1], e->line);
        }
        if (e->name.size() != 1)
            fail("name " + e->name.back(), e->line);
        const std::string &n = e->name[0];
        Var *v = lookup(n);
        // a member of the current class, through this
        if (cur_ && cur_->owner && !cur_->isStatic && (!v || v->global))
        {
            bool local = false;
            for (int i = (int)scopes_.size() - 1; i >= 0; --i)
                if (scopes_[i].vars.count(n))
                    local = true;
            int off = 0;
            const Field *f = local ? nullptr : findField(cur_->owner, n, off);
            if (f)
            {
                a.load(RAX, thisOff_);
                if (off)
                    a.addImm(RAX, off);
                if (f->type->cat == C_REF)
                {
                    a.movRR(RCX, RAX);
                    a.loadRcx(8, false);
                    return f->type->elem;
                }
                return f->type;
            }
        }
        if (!v && cur_ && cur_->owner)
            for (ClassInfo *k = cur_->owner; k; k = k->base)
            {
                auto s = k->statics.find(n);
                if (s != k->statics.end())
                    v = &globals_[s->second];
            }
        if (!v)
            fail("unknown name " + n, e->line);
        if (v->global)
            a.leaData(RAX, v->off);
        else
            a.lea(RAX, v->off);
        if (v->type->cat == C_REF)
        {
            a.movRR(RCX, RAX);
            a.loadRcx(8, false);
            return v->type->elem;
        }
        return v->type;
    }
    case cpp::EK::This:
        fail("this is not an object (use *this)", e->line);
    case cpp::EK::Unary:
        if (e->op == "*")
        {
            NT p = expr(e->kids[0]);
            if (p->cat != C_PTR)
                fail("* of a non-pointer", e->line);
            if (p->elem->cat == C_VOID)
                fail("* of a void pointer", e->line);
            return p->elem;
        }
        break;
    case cpp::EK::Index:
    {
        {
            bool found = false;
            NT r = operatorCall("[]", e->kids, e->line, found);
            if (found)
            {
                if (r->cat == C_REF)
                    return r->elem;
                if (r->cat == C_CLASS)
                    return r;
                fail("operator[] returning a value, used as an object", e->line);
            }
        }
        NT b = expr(e->kids[0]);
        if (b->cat == C_REF)
            b = b->elem;
        if (b->cat != C_PTR)
            fail("[] of a non-pointer", e->line);
        pushRax();
        NT i = expr(e->kids[1]);
        if (i->cat != C_INT)
            fail("a non-integer index", e->line);
        a.imulImm(RAX, sizeOf(b->elem));
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.alu(0x01, RAX, RCX);
        return b->elem;
    }
    case cpp::EK::Member:
    {
        NT s;
        if (e->arrow)
        {
            NT p = expr(e->kids[0]);
            if (p->cat != C_PTR || p->elem->cat != C_CLASS)
                fail("-> on a non-object pointer", e->line);
            s = p->elem;
        }
        else
        {
            s = addr(e->kids[0]);
            if (s->cat != C_CLASS)
                fail(". on a non-object", e->line);
        }
        int off = 0;
        const Field *f = findField(s->cls, e->op, off);
        if (!f)
            fail("class " + s->cls->name + " has no data member " + e->op, e->line);
        if (off)
            a.addImm(RAX, off);
        if (f->type->cat == C_REF)
        {
            a.movRR(RCX, RAX);
            a.loadRcx(8, false);
            return f->type->elem;
        }
        return f->type;
    }
    case cpp::EK::Str:
        a.leaData(RAX, stringData(e->str));
        return tArray(tInt(K_I8), (int)e->str.size() + 1);
    case cpp::EK::Call:
    {
        NT t = call(e);
        if (t->cat == C_REF)
            return t->elem;
        if (t->cat == C_CLASS)
            return t; // a temporary object
        break;
    }
    case cpp::EK::Assign:
    {
        NT t = assign(e);
        if (t->cat == C_CLASS)
            return t;
        break;
    }
    case cpp::EK::Construct:
    case cpp::EK::Cast:
    {
        NT t = expr(e);
        if (t->cat == C_CLASS)
            return t; // a temporary object
        break;
    }
    case cpp::EK::Lambda:
        return lambda(e); // its closure, a temporary
    case cpp::EK::Cond:
    {
        int other = a.newLabel(), end = a.newLabel();
        expr(e->kids[0]);
        a.test(RAX, RAX);
        a.jcc(CC_E, other);
        NT t1 = addr(e->kids[1]);
        a.jmp(end);
        a.bind(other);
        addr(e->kids[2]);
        a.bind(end);
        return t1;
    }
    default:
        break;
    }
    // an operator on objects yields an object (or a reference to one)
    {
        NT t = typeOfExpr(e);
        if (t->cat == C_CLASS || t->cat == C_REF)
        {
            if (e->k == cpp::EK::Binary || e->k == cpp::EK::Unary)
            {
                bool found = false;
                NT r = operatorCall(e->op, e->kids, e->line, found);
                if (found)
                    return r->cat == C_REF ? r->elem : r;
            }
        }
    }
    fail("this expression is not an object", e->line);
}

void Gen::arith(const std::string &op, Kind k, int line)
{
    if (isFloat(k))
    {
        arithFloat(op, k, line);
        return;
    }
    bool u = isUnsigned(k);
    if (op == "+")
        a.alu(0x01, RAX, RCX);
    else if (op == "-")
        a.alu(0x29, RAX, RCX);
    else if (op == "*")
        a.imul(RAX, RCX);
    else if (op == "&")
        a.alu(0x21, RAX, RCX);
    else if (op == "|")
        a.alu(0x09, RAX, RCX);
    else if (op == "^")
        a.alu(0x31, RAX, RCX);
    else if (op == "/" || op == "%")
    {
        if (u)
        {
            a.alu(0x31, RDX, RDX);
            a.div(RCX);
        }
        else
        {
            a.cqo();
            a.idiv(RCX);
        }
        if (op == "%")
            a.movRR(RAX, RDX);
    }
    else if (op == "<<")
        a.shiftCl(4, RAX);
    else if (op == ">>")
        a.shiftCl(u ? 5 : 7, RAX);
    else
        fail("operator " + op, line);
    wrap(k);
}

NT Gen::binary(const cpp::ExprP &e)
{
    const std::string &op = e->op;
    if (op == "&&" || op == "||")
    {
        int shortCut = a.newLabel(), end = a.newLabel();
        truth(expr(e->kids[0]));
        a.test(RAX, RAX);
        a.jcc(op == "&&" ? CC_E : CC_NE, shortCut);
        truth(expr(e->kids[1]));
        a.test(RAX, RAX);
        a.setcc(CC_NE);
        a.jmp(end);
        a.bind(shortCut);
        a.movImm(RAX, op == "&&" ? 0 : 1);
        a.bind(end);
        return tInt(K_BOOL);
    }
    {
        bool found = false;
        NT r = operatorCall(op, e->kids, e->line, found);
        if (found)
            return r->cat == C_REF ? valueAt(r->elem) : r;
    }
    NT lt = expr(e->kids[0]);
    pushRax();
    NT rt = expr(e->kids[1]);
    a.movRR(RCX, RAX);
    popReg(RAX);
    if (lt->cat == C_REF)
        lt = lt->elem;
    if (rt->cat == C_REF)
        rt = rt->elem;
    if (!isScalar(lt) || !isScalar(rt))
        fail("operator " + op + " on an object without operator" + op, e->line);
    if ((op == "+" || op == "-") && (lt->cat == C_PTR || rt->cat == C_PTR))
    {
        if (lt->cat == C_PTR && rt->cat == C_INT)
        {
            a.imulImm(RCX, sizeOf(lt->elem));
            a.alu(op == "+" ? 0x01 : 0x29, RAX, RCX);
            return lt;
        }
        if (lt->cat == C_INT && rt->cat == C_PTR && op == "+")
        {
            a.imulImm(RAX, sizeOf(rt->elem));
            a.alu(0x01, RAX, RCX);
            return rt;
        }
        if (lt->cat == C_PTR && rt->cat == C_PTR && op == "-")
        {
            a.alu(0x29, RAX, RCX);
            a.cqo();
            a.movImm(RCX, sizeOf(lt->elem));
            a.idiv(RCX);
            return tInt(K_I64);
        }
        fail("this pointer arithmetic", e->line);
    }
    Kind lk = valKind(lt), rk = valKind(rt);
    if (op == "<<" || op == ">>")
    {
        Kind k = promote(lk);
        arith(op, k, e->line);
        return tInt(k);
    }
    Kind k = common(lk, rk);
    if (isFloat(k))
    {
        // both operands to k: rcx through rax
        convKind(lk, k);
        a.movRR(RDX, RAX);
        a.movRR(RAX, RCX);
        convKind(rk, k);
        a.movRR(RCX, RAX);
        a.movRR(RAX, RDX);
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=")
        {
            compareFloat(op, k);
            return tInt(K_BOOL);
        }
        arithFloat(op, k, e->line);
        return tInt(k);
    }
    if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=")
    {
        wrap(k, RAX);
        wrap(k, RCX);
        bool u = isUnsigned(k);
        int cc = op == "==" ? CC_E : op == "!=" ? CC_NE : op == "<" ? (u ? CC_B : CC_L)
               : op == ">" ? (u ? CC_A : CC_G) : op == "<=" ? (u ? CC_BE : CC_LE) : (u ? CC_AE : CC_GE);
        a.alu(0x39, RAX, RCX);
        a.setcc(cc);
        return tInt(K_BOOL);
    }
    if (lt->cat == C_PTR || rt->cat == C_PTR)
        fail("operator " + op + " on a pointer", e->line);
    wrap(k, RAX);
    wrap(k, RCX);
    arith(op, k, e->line);
    return tInt(k);
}

// [rdi] = [rsi], `size` bytes (rep movsb)
void Gen::copyBytes(int size)
{
    a.movImm(RCX, size);
    a.byte(0xF3);
    a.byte(0xA4);
}

NT Gen::assign(const cpp::ExprP &e)
{
    {
        NT lt0 = typeOfExpr(e->kids[0]);
        if (lt0->cat == C_REF)
            lt0 = lt0->elem;
        if (lt0->cat == C_CLASS)
        {
            std::vector<Method *> ops;
            if (e->op != "=" || findMethod(lt0->cls, "operator=", ops))
            {
                bool found = false;
                NT r = operatorCall(e->op, e->kids, e->line, found);
                if (!found)
                    fail("no operator" + e->op + " for " + lt0->cls->name, e->line);
                return r->cat == C_REF ? r->elem : r;
            }
        }
    }
    if (e->op == "=")
    {
        NT rt = expr(e->kids[1]);
        pushRax();
        NT lt = addr(e->kids[0]);
        if (lt->cat == C_CLASS)
        {
            if (rt->cat != C_CLASS || !derivesFrom(rt->cls, lt->cls))
                fail("assigning a different type to an object", e->line);
            a.movRR(RDI, RAX);
            popReg(RSI);
            pushRax();
            int skip = lt->cls->polymorphic ? 8 : 0; // the target keeps its own vtable
            if (skip)
            {
                a.addImm(RDI, 8);
                a.addImm(RSI, 8);
            }
            copyBytes(sizeOf(lt) - skip);
            popReg(RAX);
            return lt;
        }
        if (!isScalar(lt))
            fail("assignment to an array", e->line);
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.push(RCX);
        ++depth_;
        if (lt->cat == C_PTR && rt->cat == C_INT && e->kids[1]->k == cpp::EK::Int)
            ; // p = 0
        else
            convert(lt, rt, e->line);
        popReg(RCX);
        a.storeRcx(sizeOf(lt));
        return lt;
    }
    std::string op = e->op.substr(0, e->op.size() - 1);
    NT lt = addr(e->kids[0]);
    if (!isScalar(lt))
        fail("compound assignment to an object or array", e->line);
    pushRax(); // the address
    valueAt(lt);
    pushRax(); // the old value
    NT rt = expr(e->kids[1]);
    a.movRR(RCX, RAX);
    popReg(RAX);
    if (lt->cat == C_PTR)
    {
        if (rt->cat != C_INT || (op != "+" && op != "-"))
            fail("this pointer arithmetic", e->line);
        a.imulImm(RCX, sizeOf(lt->elem));
        a.alu(op == "+" ? 0x01 : 0x29, RAX, RCX);
    }
    else
    {
        Kind vk = lt->kind, rk = valKind(rt);
        Kind k = op == "<<" || op == ">>" ? promote(vk) : common(vk, rk);
        if (isFloat(k))
        {
            convKind(vk, k);
            a.movRR(RDX, RAX);
            a.movRR(RAX, RCX);
            convKind(rk, k);
            a.movRR(RCX, RAX);
            a.movRR(RAX, RDX);
            arithFloat(op, k, e->line);
            convKind(k, vk);
        }
        else
        {
            wrap(k, RAX);
            if (op != "<<" && op != ">>")
                wrap(k, RCX);
            arith(op, k, e->line);
            wrap(vk);
        }
    }
    popReg(RCX);
    a.storeRcx(sizeOf(lt));
    return lt;
}

NT Gen::incDec(const cpp::ExprP &e, bool inc, bool post)
{
    NT t = addr(e->kids[0]);
    if (!isScalar(t))
        fail("++/-- of an object or array", e->line);
    pushRax();
    valueAt(t);
    a.movRR(RDX, RAX); // the old value
    if (t->cat == C_INT && isFloat(t->kind))
    {
        a.movImm(RCX, (int64_t)ieeeBits(1.0, t->kind == K_F64 ? 52 : 23, t->kind == K_F64 ? 1023 : 127));
        arithFloat(inc ? "+" : "-", t->kind, e->line);
    }
    else
    {
        a.movImm(RCX, t->cat == C_PTR ? sizeOf(t->elem) : 1);
        a.alu(inc ? 0x01 : 0x29, RAX, RCX);
        if (t->cat == C_INT)
            wrap(t->kind);
    }
    popReg(RCX);
    a.storeRcx(sizeOf(t));
    if (post)
        a.movRR(RAX, RDX);
    return t;
}

// rax = the address a reference of type `ref` binds to: the object itself, or
// (a const reference to a value) a temporary holding the value
void Gen::bindRef(const NT &ref, const cpp::ExprP &e, int line)
{
    const NT &to = ref->elem;
    NT t = typeOfExpr(e);
    bool lvalue = e->k == cpp::EK::Name || e->k == cpp::EK::Member || e->k == cpp::EK::Index ||
                  (e->k == cpp::EK::Unary && e->op == "*") || t->cat == C_REF || t->cat == C_CLASS;
    if (e->k == cpp::EK::Call && t->cat != C_REF && t->cat != C_CLASS)
        lvalue = false;
    if (lvalue && (t->cat == C_CLASS || sameType(t->cat == C_REF ? t->elem : t, to)))
    {
        NT got = addr(e);
        if (to->cat == C_CLASS && (got->cat != C_CLASS || !derivesFrom(got->cls, to->cls)))
            fail("binding a reference to a different type", line);
        return;
    }
    if (!ref->isConst && to->cat != C_CLASS)
        fail("binding a non-const reference to a value", line);
    // a temporary holding the converted value
    NT v = expr(e);
    if (to->cat == C_CLASS)
    {
        if (v->cat != C_CLASS || !derivesFrom(v->cls, to->cls))
            fail("binding a reference to a different type", line);
        return; // a temporary object already
    }
    if (to->cat == C_PTR && v->cat == C_PTR)
        ;
    else
        convert(to, v, line);
    int slot = newSlot(to);
    a.lea(RCX, slot);
    a.storeRcx(sizeOf(to));
    a.lea(RAX, slot);
}

// Overload resolution: the cost of passing `arg` (of type argT) to `param`
int Gen::argCost(const NT &param, const cpp::ExprP &arg, const NT &argT)
{
    NT p = param->cat == C_REF ? param->elem : param;
    NT t = argT->cat == C_REF ? argT->elem : argT;
    if (sameType(p, t))
        return 0;
    if (p->cat == C_INT && t->cat == C_INT)
        return promote(t->kind) == p->kind || (t->kind == K_F32 && p->kind == K_F64) ? 1 : 2;
    if (p->cat == C_PTR && t->cat == C_PTR)
    {
        if (p->elem->cat == C_VOID)
            return 3;
        if (p->elem->cat == C_CLASS && t->elem->cat == C_CLASS && derivesFrom(t->elem->cls, p->elem->cls))
            return 2;
        if (t->elem->cat == C_VOID && arg->k == cpp::EK::Nullptr)
            return 1;
        return -1;
    }
    if (p->cat == C_PTR && t->cat == C_INT && arg->k == cpp::EK::Int && arg->str == "0")
        return 3;
    if (p->cat == C_CLASS && t->cat == C_CLASS && derivesFrom(t->cls, p->cls))
        return 2;
    if (p->cat == C_CLASS)
    {
        // a converting constructor taking it
        for (Method *c : p->cls->ctors)
            if (c->params.size() == 1 && !(c->decl && c->decl->isExplicit))
            {
                NT cp = c->params[0]->cat == C_REF ? c->params[0]->elem : c->params[0];
                if (sameType(cp, t) || (cp->cat == C_INT && t->cat == C_INT))
                    return 5;
            }
    }
    return -1;
}

Method *Gen::resolve(const std::vector<Method *> &cands, const std::vector<cpp::ExprP> &args, const std::string &what,
                     int line)
{
    if (cands.size() == 1 && cands[0]->params.size() == args.size())
        return cands[0];
    std::vector<NT> types;
    for (const cpp::ExprP &x : args)
        types.push_back(typeOfExpr(x));
    Method *best = nullptr;
    int bestCost = 1 << 30;
    bool tie = false;
    for (Method *m : cands)
    {
        if (args.size() > m->params.size())
            continue;
        bool ok = true;
        for (size_t i = args.size(); i < m->params.size(); ++i)
            if (!m->defaults[i])
                ok = false;
        int cost = 0;
        for (size_t i = 0; ok && i < args.size(); ++i)
        {
            int c = argCost(m->params[i], args[i], types[i]);
            if (c < 0)
                ok = false;
            cost += c;
        }
        if (!ok)
            continue;
        if (cost < bestCost)
        {
            best = m;
            bestCost = cost;
            tie = false;
        }
        else if (cost == bestCost)
            tie = true;
    }
    if (!best)
        fail("no " + what + " matches these arguments", line);
    if (tie)
        fail("ambiguous call of " + what, line);
    return best;
}

// A call: the result's place, this, then the arguments, in the argument
// registers / stack slots. Returns the result type (a class result: its
// address in rax).
NT Gen::callMethod(Method *m, const ThisSrc &self, const std::vector<cpp::ExprP> &argsIn, bool virt, int line,
                   const ThisSrc *result)
{
    if (!m->ret)
        deduceReturn(m);
    std::vector<cpp::ExprP> args = argsIn;
    for (size_t i = args.size(); i < m->params.size(); ++i)
        args.push_back(m->defaults[i]);
    bool hasThis = m->owner && !m->isStatic && self.kind != TH_NONE;
    if (m->owner && !m->isStatic && !hasThis)
        fail("calling member function " + m->name + " without an object", line);
    bool classRet = m->ret->cat == C_CLASS;
    ThisSrc place; // where the result is built
    if (classRet && result)
        place = *result;
    else if (classRet)
    {
        place.kind = TH_LOCAL; // a temporary
        place.off = newSlot(m->ret);
        if (m->ret->cls->needsDtor)
            temps_.push_back(Cleanup{place.off, m->ret->cls, 0});
    }
    int n = (classRet ? 1 : 0) + (hasThis ? 1 : 0) + (int)args.size();
    int onStack = n > 4 ? n - 4 : 0;
    int pad = (depth_ + onStack + 4) % 2;
    if (pad)
    {
        a.subRsp(8);
        ++depth_;
    }
    for (int i = (int)args.size() - 1; i >= 0; --i)
    {
        NT pt = m->params[i];
        if (pt->cat == C_REF)
            bindRef(pt, args[i], line);
        else if (pt->cat == C_CLASS)
        {
            // by value: a copy in the caller's frame, passed by address
            int slot = newSlot(pt);
            std::vector<cpp::ExprP> one = {args[i]};
            ThisSrc cs;
            cs.kind = TH_LOCAL;
            cs.off = slot;
            construct(cs, pt->cls, one, false, line);
            if (pt->cls->needsDtor)
                temps_.push_back(Cleanup{slot, pt->cls, 0});
            a.lea(RAX, slot);
        }
        else
        {
            NT at = expr(args[i]);
            if (pt->cat == C_PTR && at->cat == C_INT && args[i]->k == cpp::EK::Int)
                ; // 0 as a null pointer
            else
                convert(pt, at, line);
        }
        pushRax();
    }
    if (hasThis)
    {
        loadThis(self);
        pushRax();
    }
    if (classRet)
    {
        loadThis(place);
        pushRax();
    }
    for (int i = 0; i < n && i < 4; ++i)
        popReg(kArgRegs[i]);
    a.subRsp(32);
    if (virt && m->isVirtual)
    {
        int thisReg = kArgRegs[classRet ? 1 : 0];
        a.loadInd(RAX, thisReg);     // the vtable
        a.addImm(RAX, 8 * m->vslot);
        a.loadInd(RAX, RAX);
        a.callReg(RAX);
    }
    else
        a.call(m->label);
    a.addRsp(32 + 8 * (onStack + pad));
    depth_ -= onStack + pad;
    if (classRet)
        loadThis(place);
    return m->ret;
}

NT Gen::call(const cpp::ExprP &e, const ThisSrc *result)
{
    const cpp::ExprP &callee = e->kids[0];
    std::vector<cpp::ExprP> args(e->kids.begin() + 1, e->kids.end());
    // obj.f(...) / p->f(...)
    if (callee->k == cpp::EK::Member)
    {
        NT ot = typeOfExpr(callee->kids[0]);
        if (callee->arrow)
            ot = ot->cat == C_PTR ? ot->elem : ot;
        else if (ot->cat == C_REF)
            ot = ot->elem;
        if (ot->cat != C_CLASS)
            fail("a member call on a non-object", e->line);
        std::vector<Method *> cands;
        if (!findMethod(ot->cls, callee->op, cands))
            fail("class " + ot->cls->name + " has no member function " + callee->op, e->line);
        Method *m = resolve(cands, args, ot->cls->name + "::" + callee->op, e->line);
        ThisSrc self;
        self.kind = callee->arrow ? TH_PTR : TH_OBJ;
        self.e = callee->kids[0];
        return callMethod(m, self, args, true, e->line, result);
    }
    if (callee->k != cpp::EK::Name)
        fail("this call (not yet: function pointers)", e->line);
    // Class::f(...): a static member, or a base class's version
    if (callee->name.size() == 2)
    {
        auto ci = classes_.find(callee->name[0]);
        if (ci == classes_.end())
            fail("unknown class " + callee->name[0], e->line);
        std::vector<Method *> cands;
        if (!findMethod(ci->second.get(), callee->name[1], cands))
            fail("unknown member function " + callee->name[0] + "::" + callee->name[1], e->line);
        Method *m = resolve(cands, args, callee->name[0] + "::" + callee->name[1], e->line);
        ThisSrc self;
        if (!m->isStatic)
            self.kind = TH_CUR;
        return callMethod(m, self, args, false, e->line, result);
    }
    if (callee->name.size() != 1)
        fail("this call", e->line);
    const std::string &name = callee->name[0];
    // a member function of the current class
    if (cur_ && cur_->owner)
    {
        std::vector<Method *> cands;
        if (findMethod(cur_->owner, name, cands))
        {
            Method *m = resolve(cands, args, name, e->line);
            ThisSrc self;
            if (!m->isStatic)
                self.kind = TH_CUR;
            return callMethod(m, self, args, true, e->line, result);
        }
    }
    // a variable of class type: its operator()
    if (lookup(name) || (cur_ && cur_->owner && !cur_->isStatic))
    {
        int off = 0;
        Var *v = lookup(name);
        bool field = !v && cur_ && cur_->owner && findField(cur_->owner, name, off);
        if (v || field)
        {
            std::vector<cpp::ExprP> kids = {callee};
            kids.insert(kids.end(), args.begin(), args.end());
            bool found = false;
            NT r = operatorCall("()", kids, e->line, found);
            if (found)
                return r;
            fail(name + " is not a function", e->line);
        }
    }
    std::vector<Method *> cands = functionCands(name, args, callee, e->line);
    if (!cands.empty())
    {
        Method *m = resolve(cands, args, name, e->line);
        return callMethod(m, ThisSrc(), args, false, e->line, result);
    }
    // the C library routines the runtime provides
    int label = -1;
    std::vector<NT> params;
    NT ret;
    if (name == "sqrt" || name == "fabs" || name == "floor" || name == "ceil" || name == "trunc")
    {
        if (args.size() != 1)
            fail(name + " takes 1 argument", e->line);
        NT at = expr(args[0]);
        convert(tInt(K_F64), at, e->line);
        if (name == "fabs")
        {
            a.movImm(RCX, 0x7FFFFFFFFFFFFFFFLL);
            a.alu(0x21, RAX, RCX);
            return tInt(K_F64);
        }
        a.toXmm(0, RAX, true);
        if (name == "sqrt")
            a.sse(0xF2, 0x51, 0, 0);
        else
        {
            // roundsd xmm0, xmm0, mode (SSE4.1): 1 down, 2 up, 3 toward zero
            a.byte(0x66);
            a.byte(0x0F);
            a.byte(0x3A);
            a.byte(0x0B);
            a.byte(0xC0);
            a.byte(name == "floor" ? 1 : name == "ceil" ? 2 : 3);
        }
        a.fromXmm(RAX, 0, true);
        return tInt(K_F64);
    }
    if (name == "putchar")
    {
        label = routine("putchar");
        params = {tInt(K_I32)};
        ret = tInt(K_I32);
    }
    else if (name == "puts")
    {
        label = routine("puts");
        params = {tPtr(tInt(K_I8))};
        ret = tInt(K_I32);
    }
    else if (name == "malloc")
    {
        label = routine("alloc");
        params = {tInt(K_U64)};
        ret = tPtr(tVoid());
    }
    else if (name == "free")
    {
        label = routine("free");
        params = {tPtr(tVoid())};
        ret = tVoid();
    }
    else
        fail("unknown function " + name, e->line);
    if (args.size() != params.size())
        fail(name + " takes " + std::to_string(params.size()) + " arguments", e->line);
    NT at = expr(args[0]);
    if (!(params[0]->cat == C_PTR && at->cat == C_PTR))
        convert(params[0], at, e->line);
    a.movRR(RCX, RAX);
    callRoutine(label);
    return ret;
}

// An operator on an object: a member operator<op> of the first operand's
// class, or a free operator<op> function. `found` is false when neither
// exists (the built-in operator applies).
NT Gen::operatorCall(const std::string &op, const std::vector<cpp::ExprP> &kids, int line, bool &found)
{
    found = false;
    std::vector<NT> types;
    bool anyClass = false;
    for (const cpp::ExprP &k : kids)
    {
        NT t = typeOfExpr(k);
        if (t->cat == C_REF)
            t = t->elem;
        types.push_back(t);
        if (t->cat == C_CLASS)
            anyClass = true;
    }
    if (!anyClass)
        return tVoid();
    std::string name = "operator" + op;
    if (types[0]->cat == C_CLASS)
    {
        std::vector<Method *> all, cands;
        findMethod(types[0]->cls, name, all);
        for (Method *m : all)
            if (m->params.size() + 1 == kids.size() ||
                (op == "()" || op == "[]"))
                cands.push_back(m);
        if (!cands.empty())
        {
            std::vector<cpp::ExprP> args(kids.begin() + 1, kids.end());
            Method *m = resolve(cands, args, types[0]->cls->name + "::" + name, line);
            ThisSrc self;
            self.kind = TH_OBJ;
            self.e = kids[0];
            found = true;
            return callMethod(m, self, args, false, line);
        }
    }
    std::vector<Method *> cands = functionCands(name, kids, nullptr, line);
    std::vector<Method *> fit;
    for (Method *m : cands)
        if (m->params.size() == kids.size())
            fit.push_back(m);
    if (fit.empty())
        return tVoid();
    Method *m = resolve(fit, kids, name, line);
    found = true;
    return callMethod(m, ThisSrc(), kids, false, line);
}

// The names an expression or statement uses (free-variable candidates)
void collectNames(const cpp::ExprP &e, std::vector<std::string> &out);
void collectNames(const cpp::StmtP &s, std::vector<std::string> &out)
{
    if (!s)
        return;
    collectNames(s->expr, out);
    collectNames(s->cond2, out);
    collectNames(s->step, out);
    for (const cpp::VarDeclarator &d : s->decls)
        for (const cpp::ExprP &x : d.args)
            collectNames(x, out);
    for (const cpp::StmtP &x : s->body)
        collectNames(x, out);
    collectNames(s->init, out);
    collectNames(s->then, out);
    collectNames(s->els, out);
    collectNames(s->condDecl, out);
    for (const cpp::Catch &c : s->catches)
        collectNames(c.body, out);
}
void collectNames(const cpp::ExprP &e, std::vector<std::string> &out)
{
    if (!e)
        return;
    if (e->k == cpp::EK::Name && e->name.size() == 1)
        out.push_back(e->name[0]);
    for (const cpp::ExprP &k : e->kids)
        collectNames(k, out);
    if (e->lambda)
        collectNames(e->lambda->body, out);
}

// A type's record for catch matching: 8 bytes in .data holding the .data
// offset of its base class's record (-1: none)
int Gen::typeInfo(const NT &tIn)
{
    NT t = tIn->cat == C_REF ? tIn->elem : tIn;
    std::string key = typeKey(t);
    auto it = typeInfo_.find(key);
    if (it != typeInfo_.end())
        return it->second;
    int64_t base = -1;
    if (t->cat == C_CLASS && t->cls->base)
        base = typeInfo(tClass(t->cls->base));
    while (data.size() % 8)
        data.push_back('\0');
    int off = (int)data.size();
    for (int i = 0; i < 8; ++i)
        data.push_back((char)((base >> (8 * i)) & 255));
    typeInfo_[key] = off;
    return off;
}

int Gen::pushHandler(int landing)
{
    int rec = newSlot(tArray(tInt(K_I64), 4)); // prev, rbp, rsp, landing address
    a.leaData(RCX, ehTop_);
    a.loadRcx(8, false);
    a.store(rec, RAX);
    a.store(rec + 8, RBP);
    a.store(rec + 16, RSP);
    a.leaLabel(RAX, landing);
    a.store(rec + 24, RAX);
    a.lea(RAX, rec);
    a.leaData(RCX, ehTop_);
    a.storeRcx(8);
    return rec;
}

void Gen::popHandler(int rec)
{
    a.load(RAX, rec);
    a.leaData(RCX, ehTop_);
    a.storeRcx(8);
}

// An object with a destructor gets a handler that destroys it when an
// exception passes, then lets the exception go on
void Gen::protect(Cleanup &c)
{
    int landing = a.newLabel(), skip = a.newLabel();
    c.ehRec = pushHandler(landing);
    a.jmp(skip);
    a.bind(landing);
    ThisSrc s;
    s.kind = TH_LOCAL;
    s.off = c.off;
    destroy(s, c.cls);
    a.call(routine("throw"));
    a.bind(skip);
}

void Gen::throwExpr(const cpp::ExprP &e)
{
    if (e->kids.empty())
    {
        // throw; : the exception the innermost handler is handling, again
        if (catchSaves_.empty())
            fail("throw; outside a catch", e->line);
        int save = catchSaves_.back();
        for (int i = 0; i < 3; ++i)
        {
            a.load(RAX, save + 8 * i);
            a.leaData(RCX, ehObj_ + 8 * i);
            a.storeRcx(8);
        }
        a.call(routine("throw"));
        return;
    }
    NT t = typeOfExpr(e->kids[0]);
    if (t->cat == C_REF)
        t = t->elem;
    if (t->cat == C_ARRAY)
        t = tPtr(t->elem);
    // the exception object, on the heap
    a.movImm(RCX, sizeOf(t));
    callRoutine(routine("alloc"));
    int slot = newSlot(tPtr(tVoid()));
    a.store(slot, RAX);
    if (t->cat == C_CLASS)
    {
        ThisSrc s;
        s.kind = TH_INDIRECT;
        s.off = slot;
        construct(s, t->cls, {e->kids[0]}, false, e->line);
    }
    else
    {
        NT v = expr(e->kids[0]);
        if (!(t->cat == C_PTR && v->cat == C_PTR))
            convert(t, v, e->line);
        a.load(RCX, slot);
        a.storeRcx(sizeOf(t));
    }
    endFullExpr();
    a.load(RAX, slot);
    a.leaData(RCX, ehObj_);
    a.storeRcx(8);
    a.movImm(RAX, typeInfo(t));
    a.leaData(RCX, ehType_);
    a.storeRcx(8);
    if (t->cat == C_CLASS && t->cls->needsDtor)
        a.leaLabel(RAX, t->cls->dtor->label);
    else
        a.movImm(RAX, 0);
    a.leaData(RCX, ehDtor_);
    a.storeRcx(8);
    a.call(routine("throw"));
}

void Gen::tryStmt(const cpp::StmtP &s)
{
    int landing = a.newLabel(), end = a.newLabel();
    int rec = pushHandler(landing);
    scopes_.emplace_back();
    scopes_.back().cleanups.push_back(Cleanup{rec, nullptr, rec});
    stmt(s->then);
    scopes_.back().cleanups.clear();
    scopes_.pop_back();
    popHandler(rec);
    a.jmp(end);

    // an exception arrived (the throw popped the record): find its handler
    a.bind(landing);
    int save = newSlot(tArray(tInt(K_I64), 3)); // object, type, destructor
    for (int i = 0; i < 3; ++i)
    {
        a.leaData(RCX, ehObj_ + 8 * i);
        a.loadRcx(8, false);
        a.store(save + 8 * i, RAX);
    }
    for (const cpp::Catch &c : s->catches)
    {
        int next = a.newLabel();
        NT ct;
        if (c.type)
        {
            ct = typeOf(c.type, s->line);
            NT want = ct->cat == C_REF ? ct->elem : ct;
            // does the thrown type (or one of its bases) match?
            int top = a.newLabel(), match = a.newLabel();
            a.load(RAX, save + 8);
            a.bind(top);
            a.movImm(RCX, typeInfo(want));
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_E, match);
            a.leaData(RCX, 0);
            a.alu(0x01, RCX, RAX);
            a.loadInd(RAX, RCX); // the base's record
            a.movImm(RCX, -1);
            a.alu(0x39, RAX, RCX);
            a.jcc(CC_E, next);
            a.jmp(top);
            a.bind(match);
        }
        scopes_.emplace_back();
        if (c.type && !c.name.empty())
        {
            NT want = ct->cat == C_REF ? ct->elem : ct;
            if (want->cat == C_CLASS || ct->cat == C_REF)
            {
                // the variable refers to the exception object itself
                a.load(RAX, save);
                int off = newSlot(tPtr(tVoid()));
                a.store(off, RAX);
                scopes_.back().vars[c.name] = Var{tRef(want, false), false, off};
            }
            else
            {
                int off = newSlot(want);
                a.load(RCX, save);
                a.loadRcx(sizeOf(want), want->cat == C_INT && !isUnsigned(want->kind) && !isFloat(want->kind));
                a.lea(RCX, off);
                a.storeRcx(sizeOf(want));
                scopes_.back().vars[c.name] = Var{want, false, off};
            }
        }
        catchSaves_.push_back(save);
        stmt(c.body);
        catchSaves_.pop_back();
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        // the exception is over: destroyed and freed
        int noDtor = a.newLabel();
        a.load(RAX, save + 16);
        a.test(RAX, RAX);
        a.jcc(CC_E, noDtor);
        a.load(RCX, save);
        int pad = (depth_ + 4) % 2;
        if (pad)
            a.subRsp(8);
        a.subRsp(32);
        a.callReg(RAX);
        a.addRsp(32 + 8 * pad);
        a.bind(noDtor);
        a.load(RCX, save);
        callRoutine(routine("free"));
        a.jmp(end);
        a.bind(next);
    }
    // no handler here: on to the next one out
    for (int i = 0; i < 3; ++i)
    {
        a.load(RAX, save + 8 * i);
        a.leaData(RCX, ehObj_ + 8 * i);
        a.storeRcx(8);
    }
    a.call(routine("throw"));
    a.bind(end);
}

// The closure class of a lambda: a field per capture, operator() for the body
ClassInfo *Gen::closureClass(const cpp::ExprP &e, std::vector<std::pair<std::string, bool>> &caps)
{
    const cpp::Lambda &l = *e->lambda;
    // what it captures: the explicit list, then (with = or &) every name its
    // body uses that is a local of the enclosing function
    for (const std::string &c : l.captures)
    {
        if (c == "this")
            fail("capturing this (not yet)", e->line);
        bool byRef = c[0] == '&';
        caps.push_back({byRef ? c.substr(1) : c, byRef});
    }
    if (l.captureAllByRef || l.captureAllByValue)
    {
        std::vector<std::string> used;
        collectNames(l.body, used);
        std::vector<std::string> own;
        for (const cpp::Param &pr : l.params)
            own.push_back(pr.name);
        for (const std::string &n : used)
        {
            bool skip = false;
            for (const std::string &o : own)
                if (o == n)
                    skip = true;
            for (const auto &c : caps)
                if (c.first == n)
                    skip = true;
            if (skip)
                continue;
            bool local = false;
            for (const Scope &sc : scopes_)
                if (sc.vars.count(n))
                    local = true;
            if (local)
                caps.push_back({n, l.captureAllByRef});
        }
    }
    std::map<const Binding *, ClassInfo *> &known = closures_[e.get()];
    auto it = known.find(bind_.get());
    if (it != known.end())
        return it->second;

    auto info = std::make_unique<ClassInfo>();
    info->name = "lambda#" + std::to_string(++lambdaCount_);
    info->bind = bind_;
    ClassInfo *c = info.get();
    classes_[c->name] = std::move(info);
    for (const auto &cap : caps)
    {
        Var *v = lookup(cap.first);
        if (!v || v->global)
            fail("capturing " + cap.first + " (not a local variable)", e->line);
        NT t = v->type->cat == C_REF ? v->type->elem : v->type;
        Field f;
        f.name = cap.first;
        f.type = cap.second ? tRef(t, false) : t;
        if (!cap.second && t->cat == C_ARRAY)
            fail("capturing an array by value (not yet)", e->line);
        c->fields.push_back(f);
    }
    // operator(): the body, with its parameters
    auto d = std::make_shared<cpp::Decl>();
    d->k = cpp::DK::Func;
    d->line = e->line;
    d->name = {"operator()"};
    d->params = l.params;
    d->body = l.body;
    d->ret = l.ret;
    Method *m = newMethod();
    m->name = "operator()";
    m->owner = c;
    m->decl = d;
    m->bind = bind_;
    for (const cpp::Param &pr : l.params)
    {
        if (pr.type && pr.type->isAuto())
            fail("a generic lambda (auto parameter: not yet)", e->line);
        NT pt = typeOf(pr.type, e->line);
        if (pt->cat == C_ARRAY)
            pt = tPtr(pt->elem);
        m->params.push_back(pt);
        m->defaults.push_back(pr.def);
    }
    if (l.ret)
        m->ret = typeOf(l.ret, e->line); // else deduced from its returns when first called
    c->methods["operator()"].push_back(m);
    layoutClass(c);
    known[bind_.get()] = c;
    return c;
}

// A lambda expression: its closure object, a temporary
NT Gen::lambda(const cpp::ExprP &e)
{
    std::vector<std::pair<std::string, bool>> caps;
    ClassInfo *c = closureClass(e, caps);
    NT t = tClass(c);
    int slot = newSlot(t);
    a.movImm(RAX, 0);
    for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
        a.store(slot + k, RAX);
    for (size_t i = 0; i < caps.size() && i < c->fields.size(); ++i)
    {
        const Field &f = c->fields[i];
        auto name = std::make_shared<cpp::Expr>();
        name->k = cpp::EK::Name;
        name->line = e->line;
        name->name = {caps[i].first};
        if (f.type->cat == C_REF)
        {
            addr(name); // the variable's address
            a.lea(RCX, slot + f.off);
            a.storeRcx(8);
            continue;
        }
        if (f.type->cat == C_CLASS)
        {
            ThisSrc fs;
            fs.kind = TH_LOCAL;
            fs.off = slot + f.off;
            construct(fs, f.type->cls, {name}, false, e->line);
            continue;
        }
        expr(name);
        a.lea(RCX, slot + f.off);
        a.storeRcx(sizeOf(f.type));
    }
    if (c->needsDtor)
        temps_.push_back(Cleanup{slot, c, 0});
    a.lea(RAX, slot);
    return t;
}

// A function whose return type comes from its return statements (a lambda
// without `-> T`): its body is generated once only to see them
void Gen::deduceReturn(Method *m)
{
    Method *savedCur = cur_;
    std::vector<Scope> savedScopes = scopes_;
    std::vector<Loop> savedLoops = loops_;
    std::vector<Cleanup> savedTemps = temps_;
    int savedNext = nextOff_, savedDepth = depth_, savedRet = retLabel_, savedRetPtr = retPtrOff_,
        savedThis = thisOff_;
    NT savedRetType = retType_;
    std::string savedNrvo = nrvoName_;
    BindP savedBind = bind_;
    bool savedDeducing = deducing_;
    NT savedDeduced = deducedRet_;
    Asm::Mark mark = a.mark();

    deducing_ = true;
    deducedRet_ = nullptr;
    m->ret = tVoid();
    function(*m);
    NT found = deducedRet_ ? deducedRet_ : tVoid();

    a.rewind(mark);
    cur_ = savedCur;
    scopes_ = savedScopes;
    loops_ = savedLoops;
    temps_ = savedTemps;
    nextOff_ = savedNext;
    depth_ = savedDepth;
    retLabel_ = savedRet;
    retPtrOff_ = savedRetPtr;
    thisOff_ = savedThis;
    retType_ = savedRetType;
    nrvoName_ = savedNrvo;
    bind_ = savedBind;
    deducing_ = savedDeducing;
    deducedRet_ = savedDeduced;
    m->ret = found;
}

// Constructs an object of class c where `self` says
void Gen::construct(const ThisSrc &self, ClassInfo *c, const std::vector<cpp::ExprP> &args, bool braced, int line)
{
    // a prvalue of the class (T(...), or a call returning T) is built in place
    if (args.size() == 1 && !(braced && args[0]->k == cpp::EK::InitList))
    {
        const cpp::ExprP &x = args[0];
        if ((x->k == cpp::EK::Construct || x->k == cpp::EK::Cast) && x->type)
        {
            NT t = typeOf(x->type, line);
            if (t->cat == C_CLASS && t->cls == c)
            {
                construct(self, c, x->kids, x->braced, line);
                return;
            }
        }
        if (x->k == cpp::EK::Call && (self.kind == TH_LOCAL || self.kind == TH_INDIRECT || self.kind == TH_GLOBAL))
        {
            NT t = typeOfExpr(x);
            if (t->cat == C_CLASS && t->cls == c)
            {
                call(x, &self);
                return;
            }
        }
    }
    if (!c->ctors.empty())
    {
        std::vector<cpp::ExprP> as = args;
        if (braced && as.size() == 1 && as[0]->k == cpp::EK::InitList)
            as = as[0]->kids;
        // copying an object of the class with no user copy constructor: memberwise
        if (as.size() == 1)
        {
            NT at = typeOfExpr(as[0]);
            NT bt = at->cat == C_REF ? at->elem : at;
            bool userCopy = false;
            for (Method *k : c->ctors)
                if (k->params.size() == 1 && k->params[0]->cat == C_REF && k->params[0]->elem->cat == C_CLASS &&
                    k->params[0]->elem->cls == c)
                    userCopy = true;
            if (bt->cat == C_CLASS && bt->cls == c && !userCopy)
            {
                addr(as[0]);
                a.movRR(RSI, RAX);
                pushRax();
                loadThis(self);
                a.movRR(RDI, RAX);
                popReg(RSI);
                copyBytes(c->size);
                return;
            }
        }
        Method *m = resolve(c->ctors, as, c->name + " constructor", line);
        callMethod(m, self, as, false, line);
        return;
    }
    if (args.empty() || (braced && args.size() == 1 && args[0]->k == cpp::EK::InitList && args[0]->kids.empty()))
    {
        if (c->implicitCtor)
            callMethod(c->implicitCtor, self, {}, false, line);
        return; // zeroed memory
    }
    // copy, or aggregate initialization {a, b, ...}
    if (args.size() == 1 && !(braced && args[0]->k == cpp::EK::InitList))
    {
        NT at = typeOfExpr(args[0]);
        NT bt = at->cat == C_REF ? at->elem : at;
        if (bt->cat == C_CLASS && derivesFrom(bt->cls, c))
        {
            addr(args[0]);
            pushRax();
            loadThis(self);
            a.movRR(RDI, RAX);
            popReg(RSI);
            copyBytes(c->size);
            return;
        }
    }
    if (c->polymorphic || c->base)
        fail("aggregate initialization of " + c->name + " (it has a base or virtual functions)", line);
    std::vector<cpp::ExprP> items = args;
    if (items.size() == 1 && items[0]->k == cpp::EK::InitList)
        items = items[0]->kids;
    if (items.size() > c->fields.size())
        fail("too many initializers for " + c->name, line);
    for (size_t i = 0; i < items.size(); ++i)
    {
        const Field &f = c->fields[i];
        if (f.type->cat == C_CLASS)
        {
            loadThis(self);
            if (f.off)
                a.addImm(RAX, f.off);
            int tmp = newSlot(tPtr(tVoid()));
            a.store(tmp, RAX);
            ThisSrc fs;
            fs.kind = TH_INDIRECT;
            fs.off = tmp;
            std::vector<cpp::ExprP> one = {items[i]};
            construct(fs, f.type->cls, one, items[i]->k == cpp::EK::InitList, line);
            continue;
        }
        if (!isScalar(f.type))
            fail("initializing member " + f.name, line);
        NT vt = expr(items[i]);
        if (f.type->cat == C_PTR && (vt->cat == C_PTR || vt->cat == C_INT))
            ;
        else
            convert(f.type, vt, line);
        pushRax();
        loadThis(self);
        if (f.off)
            a.addImm(RAX, f.off);
        a.movRR(RCX, RAX);
        popReg(RAX);
        a.storeRcx(sizeOf(f.type));
    }
}

void Gen::destroy(const ThisSrc &self, ClassInfo *c)
{
    if (!c->needsDtor)
        return;
    loadThis(self);
    a.movRR(RCX, RAX);
    callRoutine(c->dtor->label);
}

// destructors of the scopes above `downTo`, innermost first (rax is kept)
void Gen::destroyScopes(size_t downTo)
{
    bool any = false;
    for (size_t i = downTo; i < scopes_.size(); ++i)
        if (!scopes_[i].cleanups.empty())
            any = true;
    if (!any)
        return;
    pushRax();
    for (size_t i = scopes_.size(); i-- > downTo;)
        for (size_t k = scopes_[i].cleanups.size(); k-- > 0;)
        {
            const Cleanup &c = scopes_[i].cleanups[k];
            if (c.ehRec)
                popHandler(c.ehRec);
            if (!c.cls)
                continue;
            ThisSrc s;
            s.kind = TH_LOCAL;
            s.off = c.off;
            destroy(s, c.cls);
        }
    popReg(RAX);
}

// the temporaries of a full-expression die at its end (rax is kept)
void Gen::endFullExpr()
{
    if (temps_.empty())
        return;
    std::vector<Cleanup> t;
    t.swap(temps_);
    pushRax();
    for (size_t k = t.size(); k-- > 0;)
    {
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = t[k].off;
        destroy(s, t[k].cls);
    }
    popReg(RAX);
}

NT Gen::expr(const cpp::ExprP &e)
{
    switch (e->k)
    {
    case cpp::EK::Int:
    {
        Kind k;
        int64_t v = literalValue(e->str, k);
        a.movImm(RAX, v);
        return tInt(k);
    }
    case cpp::EK::Char:
        a.movImm(RAX, (int64_t)(signed char)(int)e->num);
        return tInt(K_I8);
    case cpp::EK::Float:
        if (e->isFloatSuffix)
        {
            a.movImm(RAX, (int64_t)ieeeBits(e->num, 23, 127));
            return tInt(K_F32);
        }
        a.movImm(RAX, (int64_t)ieeeBits(e->num, 52, 1023));
        return tInt(K_F64);
    case cpp::EK::Bool:
        a.movImm(RAX, e->num != 0 ? 1 : 0);
        return tInt(K_BOOL);
    case cpp::EK::Nullptr:
        a.movImm(RAX, 0);
        return tPtr(tVoid());
    case cpp::EK::This:
        if (!cur_ || !cur_->owner || cur_->isStatic)
            fail("this outside a member function", e->line);
        a.load(RAX, thisOff_);
        return tPtr(tClass(cur_->owner));
    case cpp::EK::Name:
        if (e->name.size() == 1 && bind_ && bind_->values.count(e->name[0]) && !lookup(e->name[0]))
        {
            a.movImm(RAX, bind_->values[e->name[0]]); // a template's value parameter
            return tInt(K_I32);
        }
        return valueAt(addr(e));
    case cpp::EK::Index:
    case cpp::EK::Member:
    case cpp::EK::Str:
        return valueAt(addr(e));
    case cpp::EK::Binary:
        return binary(e);
    case cpp::EK::Comma:
    {
        NT t = tVoid();
        for (const cpp::ExprP &x : e->kids)
            t = expr(x);
        return t;
    }
    case cpp::EK::Assign:
        return assign(e);
    case cpp::EK::Unary:
    {
        const std::string &op = e->op;
        if (op != "&")
        {
            bool found = false;
            NT r = operatorCall(op, e->kids, e->line, found);
            if (found)
                return r->cat == C_REF ? valueAt(r->elem) : r;
        }
        if (op == "++" || op == "--")
            return incDec(e, op == "++", false);
        if (op == "&")
            return tPtr(addr(e->kids[0]));
        if (op == "*")
            return valueAt(addr(e));
        NT t = expr(e->kids[0]);
        if (op == "!")
        {
            truth(t);
            a.test(RAX, RAX);
            a.setcc(CC_E);
            return tInt(K_BOOL);
        }
        if (t->cat != C_INT)
            fail("operator " + op + " on a non-integer", e->line);
        if (isFloat(t->kind))
        {
            if (op == "-")
            {
                // flip the sign bit
                a.movImm(RCX, t->kind == K_F64 ? (int64_t)0x8000000000000000ULL : 0x80000000LL);
                a.alu(0x31, RAX, RCX);
            }
            else if (op != "+")
                fail("operator " + op + " on floating point", e->line);
            return t;
        }
        Kind pk = promote(t->kind);
        if (op == "-")
            a.neg(RAX);
        else if (op == "~")
            a.notr(RAX);
        else if (op != "+")
            fail("operator " + op, e->line);
        wrap(pk);
        return tInt(pk);
    }
    case cpp::EK::Postfix:
        return incDec(e, e->op == "++", true);
    case cpp::EK::Cond:
    {
        NT s1 = typeOfExpr(e->kids[1]), s2 = typeOfExpr(e->kids[2]);
        if (s1->cat == C_REF)
            s1 = s1->elem;
        if (s2->cat == C_REF)
            s2 = s2->elem;
        bool ints = s1->cat == C_INT && s2->cat == C_INT;
        Kind k = ints ? (s1->kind == s2->kind ? s1->kind : common(s1->kind, s2->kind)) : K_VOID;
        int other = a.newLabel(), end = a.newLabel();
        truth(expr(e->kids[0]));
        a.test(RAX, RAX);
        a.jcc(CC_E, other);
        NT t1 = expr(e->kids[1]);
        if (ints)
            convKind(valKind(t1->cat == C_REF ? t1->elem : t1), k);
        a.jmp(end);
        a.bind(other);
        NT t2 = expr(e->kids[2]);
        if (ints)
            convKind(valKind(t2->cat == C_REF ? t2->elem : t2), k);
        a.bind(end);
        if (ints)
            return tInt(k);
        return t1->cat == C_PTR ? t1 : t2;
    }
    case cpp::EK::Call:
    {
        NT t = call(e);
        if (t->cat == C_REF)
            return valueAt(t->elem);
        return t;
    }
    case cpp::EK::Cast:
    case cpp::EK::Construct:
    {
        NT t = typeOf(e->type, e->line);
        if (t->cat == C_CLASS)
        {
            // T(args) / T{args}: a temporary object
            int slot = newSlot(t);
            a.movImm(RAX, 0);
            for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
                a.store(slot + k, RAX);
            ThisSrc s;
            s.kind = TH_LOCAL;
            s.off = slot;
            construct(s, t->cls, e->kids, e->braced, e->line);
            if (t->cls->needsDtor)
                temps_.push_back(Cleanup{slot, t->cls, 0});
            a.lea(RAX, slot);
            return t;
        }
        if (e->kids.size() != 1)
        {
            if (e->kids.empty() && t->cat == C_INT)
            {
                a.movImm(RAX, 0); // int()
                return t;
            }
            fail("this conversion", e->line);
        }
        NT from = expr(e->kids[0]);
        if (t->cat == C_VOID)
            return t;
        if (t->cat == C_PTR && (from->cat == C_PTR || from->cat == C_INT))
            return t; // a pointer cast reinterprets
        if (t->cat == C_INT && from->cat == C_PTR)
        {
            wrap(t->kind);
            return t;
        }
        convert(t, from, e->line);
        return t;
    }
    case cpp::EK::Lambda:
        return lambda(e);
    case cpp::EK::Throw:
        throwExpr(e);
        return tVoid();
    case cpp::EK::SizeofT:
        a.movImm(RAX, sizeOf(typeOf(e->type, e->line)));
        return tInt(K_U64);
    case cpp::EK::SizeofE:
    {
        NT t = typeOfExpr(e->kids[0]);
        if (t->cat == C_REF)
            t = t->elem;
        // an array name decays in typeOfExpr; ask for the object's type instead
        if (e->kids[0]->k == cpp::EK::Name || e->kids[0]->k == cpp::EK::Member || e->kids[0]->k == cpp::EK::Index)
        {
            Asm::Mark m = a.mark();
            int depth = depth_;
            t = addr(e->kids[0]);
            a.rewind(m);
            depth_ = depth;
        }
        a.movImm(RAX, sizeOf(t));
        return tInt(K_U64);
    }
    case cpp::EK::New:
    {
        NT t = typeOf(e->type, e->line);
        if (e->newArray)
        {
            if (e->braced)
                fail("new[] with an initializer list (not yet)", e->line);
            if (t->cat == C_CLASS && (t->cls->needsDtor || !t->cls->ctors.empty() || t->cls->implicitCtor))
                fail("new[] of objects with constructors or destructors (not yet)", e->line);
            NT n = expr(e->kids[0]);
            if (n->cat != C_INT)
                fail("a non-integer array size", e->line);
            a.imulImm(RAX, sizeOf(t));
            a.movRR(RCX, RAX);
            callRoutine(routine("alloc"));
            return tPtr(t);
        }
        a.movImm(RCX, sizeOf(t));
        callRoutine(routine("alloc"));
        if (t->cat == C_CLASS)
        {
            int slot = newSlot(tPtr(t));
            a.store(slot, RAX);
            ThisSrc s;
            s.kind = TH_INDIRECT;
            s.off = slot;
            construct(s, t->cls, e->kids, e->braced, e->line);
            a.load(RAX, slot);
            return tPtr(t);
        }
        if (!e->kids.empty())
        {
            if (e->kids.size() != 1)
                fail("new with several values", e->line);
            int slot = newSlot(tPtr(t));
            a.store(slot, RAX);
            NT v = expr(e->kids[0]);
            if (!(t->cat == C_PTR && v->cat == C_PTR))
                convert(t, v, e->line);
            a.load(RCX, slot);
            a.storeRcx(sizeOf(t));
            a.load(RAX, slot);
        }
        return tPtr(t);
    }
    case cpp::EK::Delete:
    {
        NT p = expr(e->kids[0]);
        if (p->cat != C_PTR)
            fail("delete of a non-pointer", e->line);
        if (p->elem->cat == C_CLASS && p->elem->cls->needsDtor)
        {
            int slot = newSlot(p);
            a.store(slot, RAX);
            int skip = a.newLabel();
            a.test(RAX, RAX);
            a.jcc(CC_E, skip);
            ClassInfo *c = p->elem->cls;
            a.movRR(RCX, RAX);
            if (c->dtor->isVirtual)
            {
                // the dynamic type's destructor
                int pad = (depth_ + 4) % 2;
                if (pad)
                    a.subRsp(8);
                a.subRsp(32);
                a.loadInd(RAX, RCX);
                a.addImm(RAX, 8 * c->dtor->vslot);
                a.loadInd(RAX, RAX);
                a.callReg(RAX);
                a.addRsp(32 + 8 * pad);
            }
            else
                callRoutine(c->dtor->label);
            a.bind(skip);
            a.load(RAX, slot);
        }
        a.movRR(RCX, RAX);
        callRoutine(routine("free"));
        return tVoid();
    }
    default:
        fail("this expression (not yet)", e->line);
    }
}

void Gen::cond(const cpp::ExprP &e, int falseLabel)
{
    NT t = expr(e);
    if (t->cat == C_REF)
        t = t->elem;
    if (!isScalar(t))
        fail("an object as a condition", e->line);
    truth(t);
    endFullExpr();
    a.test(RAX, RAX);
    a.jcc(CC_E, falseLabel);
}

// A local's initial value, stored in place (the slot is zeroed first)
void Gen::localInit(int off, const NT &t, const cpp::ExprP &init, int line)
{
    if (t->cat == C_ARRAY && t->elem->cat == C_INT && t->elem->kind == K_I8 && init->k == cpp::EK::Str)
    {
        for (size_t i = 0; i < init->str.size() && (int)i < t->n; ++i)
        {
            a.lea(RCX, off + (int)i);
            a.movImm(RAX, (unsigned char)init->str[i]);
            a.storeRcx(1);
        }
        return;
    }
    if (t->cat == C_ARRAY)
    {
        if (init->k != cpp::EK::InitList)
            fail("initializer of an array", line);
        for (size_t i = 0; i < init->kids.size(); ++i)
        {
            if ((int)i >= t->n)
                fail("too many initializers", line);
            localInit(off + (int)i * sizeOf(t->elem), t->elem, init->kids[i], line);
        }
        return;
    }
    if (t->cat == C_CLASS)
    {
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = off;
        std::vector<cpp::ExprP> args = {init};
        bool braced = init->k == cpp::EK::InitList;
        if (braced)
            args = init->kids;
        construct(s, t->cls, args, braced, line);
        return;
    }
    cpp::ExprP e = init;
    if (e->k == cpp::EK::InitList)
    {
        if (e->kids.size() > 1)
            fail("too many initializers", line);
        if (e->kids.empty())
            return; // {}: zero
        e = e->kids[0];
    }
    NT from = expr(e);
    if (from->cat == C_REF)
        from = from->elem;
    if (t->cat == C_PTR && (from->cat == C_PTR || (from->cat == C_INT && e->k == cpp::EK::Int)))
        convert(t, from->cat == C_PTR ? from : t, line);
    else
        convert(t, from, line);
    a.lea(RCX, off);
    a.storeRcx(sizeOf(t));
}

void Gen::declare(const std::string &name, const NT &tIn, const cpp::ExprP &init, bool braced,
                  const std::vector<cpp::ExprP> &args, int line)
{
    NT t = tIn;
    if (t->cat == C_ARRAY && t->n == 0)
    {
        if (!init)
            fail("array without a size", line);
        t = tArray(t->elem, init->k == cpp::EK::Str ? (int)init->str.size() + 1 : (int)init->kids.size());
    }
    if (t->cat == C_VOID)
        fail("a void variable", line);
    if (t->cat == C_ARRAY && t->elem->cat == C_CLASS &&
        (t->elem->cls->needsDtor || !t->elem->cls->ctors.empty() || t->elem->cls->implicitCtor))
        fail("an array of objects with constructors or destructors (not yet)", line);
    if (t->cat == C_REF)
    {
        if (!init)
            fail("a reference without an initializer", line);
        bindRef(t, init, line);
        int off = newSlot(tPtr(tVoid()));
        a.store(off, RAX);
        endFullExpr();
        scopes_.back().vars[name] = Var{t, false, off};
        return;
    }
    int off = newSlot(t);
    a.movImm(RAX, 0);
    for (int k = 0; k < alignUp(sizeOf(t), 8); k += 8)
        a.store(off + k, RAX);
    if (t->cat == C_CLASS)
    {
        if (name == nrvoName_ && retType_->cat == C_CLASS && t->cls == retType_->cls)
        {
            // the named return value: built in the caller's place from the start
            ThisSrc rs;
            rs.kind = TH_INDIRECT;
            rs.off = retPtrOff_;
            construct(rs, t->cls, args, braced, line);
            endFullExpr();
            scopes_.back().vars[name] = Var{tRef(t, false), false, retPtrOff_};
            return;
        }
        ThisSrc s;
        s.kind = TH_LOCAL;
        s.off = off;
        construct(s, t->cls, args, braced, line);
    }
    else if (init)
        localInit(off, t, init, line);
    endFullExpr();
    scopes_.back().vars[name] = Var{t, false, off};
    if (t->cat == C_CLASS && t->cls->needsDtor)
    {
        Cleanup c{off, t->cls, 0};
        protect(c);
        scopes_.back().cleanups.push_back(c);
    }
}

void Gen::stmt(const cpp::StmtP &s)
{
    switch (s->k)
    {
    case cpp::SK::Expr:
        expr(s->expr);
        endFullExpr();
        break;
    case cpp::SK::Empty:
        break;
    case cpp::SK::Decl:
        if (s->isStatic)
            fail("static local variable (not yet)", s->line);
        for (const cpp::VarDeclarator &d : s->decls)
        {
            if (!d.bindings.empty())
                fail("structured binding", s->line);
            cpp::ExprP first = d.args.empty() ? nullptr : d.args[0];
            NT t = d.type && d.type->isAuto() ? autoType(d.type, first, s->line) : typeOf(d.type, s->line);
            cpp::ExprP init;
            bool braced = d.init == cpp::VarDeclarator::Brace;
            if (d.args.size() == 1 && !braced)
                init = d.args[0];
            else if (!d.args.empty() || braced)
            {
                auto list = std::make_shared<cpp::Expr>();
                list->k = cpp::EK::InitList;
                list->line = s->line;
                list->kids = d.args;
                if (d.args.size() == 1 && d.args[0]->k == cpp::EK::InitList)
                    list = d.args[0];
                init = list;
            }
            std::vector<cpp::ExprP> args = d.args;
            if (braced && args.size() == 1 && args[0]->k == cpp::EK::InitList)
                args = args[0]->kids;
            declare(d.name, t, init, braced, args, s->line);
        }
        break;
    case cpp::SK::Block:
        scopes_.emplace_back();
        for (const cpp::StmtP &x : s->body)
            stmt(x);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    case cpp::SK::If:
    {
        if (s->condDecl)
            fail("a declaration as the condition", s->line);
        scopes_.emplace_back();
        if (s->init)
            stmt(s->init);
        int other = a.newLabel(), end = a.newLabel();
        cond(s->expr, other);
        stmt(s->then);
        a.jmp(end);
        a.bind(other);
        if (s->els)
            stmt(s->els);
        a.bind(end);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    }
    case cpp::SK::While:
    {
        if (s->condDecl)
            fail("a declaration as the condition", s->line);
        int top = a.newLabel(), end = a.newLabel();
        a.bind(top);
        cond(s->expr, end);
        loops_.push_back(Loop{end, top, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.jmp(top);
        a.bind(end);
        break;
    }
    case cpp::SK::Do:
    {
        int top = a.newLabel(), next = a.newLabel(), end = a.newLabel();
        a.bind(top);
        loops_.push_back(Loop{end, next, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.bind(next);
        cond(s->expr, end);
        a.jmp(top);
        a.bind(end);
        break;
    }
    case cpp::SK::For:
    {
        scopes_.emplace_back();
        if (s->init)
            stmt(s->init);
        int top = a.newLabel(), next = a.newLabel(), end = a.newLabel(), out = a.newLabel();
        a.bind(top);
        if (s->cond2)
            cond(s->cond2, end);
        loops_.push_back(Loop{out, next, scopes_.size()});
        stmt(s->then);
        loops_.pop_back();
        a.bind(next);
        if (s->step)
        {
            expr(s->step);
            endFullExpr();
        }
        a.jmp(top);
        a.bind(out);
        a.bind(end);
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        break;
    }
    case cpp::SK::Switch:
    {
        if (s->condDecl || s->init)
            fail("switch with a declaration", s->line);
        NT st = expr(s->expr);
        if (st->cat != C_INT)
            fail("switch on a non-integer", s->line);
        endFullExpr();
        Kind k = promote(st->kind);
        int slot = newSlot(tInt(K_I64));
        a.store(slot, RAX);
        int end = a.newLabel(), deflt = -1;
        std::vector<int> labels;
        for (const cpp::StmtP &x : s->body)
        {
            if (x->k == cpp::SK::Case)
            {
                int l = a.newLabel();
                labels.push_back(l);
                NT ct = expr(x->expr);
                Kind cmpK = common(k, ct->kind);
                wrap(cmpK);
                a.movRR(RCX, RAX);
                a.load(RAX, slot);
                wrap(cmpK);
                a.alu(0x39, RAX, RCX);
                a.jcc(CC_E, l);
            }
            else if (x->k == cpp::SK::Default)
            {
                deflt = a.newLabel();
                labels.push_back(deflt);
            }
        }
        a.jmp(deflt >= 0 ? deflt : end);
        scopes_.emplace_back();
        // break leaves the switch; continue still belongs to the enclosing loop
        int cont = loops_.empty() ? -1 : loops_.back().continueLabel;
        loops_.push_back(Loop{end, cont, scopes_.size() - 1});
        size_t next = 0;
        for (const cpp::StmtP &x : s->body)
        {
            if (x->k == cpp::SK::Case || x->k == cpp::SK::Default)
                a.bind(labels[next++]);
            else
                stmt(x);
        }
        loops_.pop_back();
        destroyScopes(scopes_.size() - 1);
        scopes_.pop_back();
        a.bind(end);
        break;
    }
    case cpp::SK::Try:
        tryStmt(s);
        break;
    case cpp::SK::Break:
        if (loops_.empty())
            fail("break outside a loop", s->line);
        destroyScopes(loops_.back().scopeDepth);
        a.jmp(loops_.back().breakLabel);
        break;
    case cpp::SK::Continue:
    {
        int i = (int)loops_.size() - 1;
        if (i < 0 || loops_[i].continueLabel < 0)
            fail("continue outside a loop", s->line);
        // a switch's entry carries the enclosing loop's continue label
        size_t depth = loops_[i].scopeDepth;
        for (int k = i; k >= 0; --k)
            if (loops_[k].continueLabel == loops_[i].continueLabel)
                depth = loops_[k].scopeDepth;
        destroyScopes(depth);
        a.jmp(loops_[i].continueLabel);
        break;
    }
    case cpp::SK::Return:
        if (deducing_)
        {
            if (s->expr && !deducedRet_)
            {
                NT t = typeOfExpr(s->expr);
                if (t->cat == C_REF)
                    t = t->elem;
                if (t->cat == C_ARRAY)
                    t = tPtr(t->elem);
                deducedRet_ = t;
            }
            a.jmp(retLabel_);
            break;
        }
        if (s->expr)
        {
            if (retType_->cat == C_CLASS && !nrvoName_.empty() && s->expr->k == cpp::EK::Name &&
                s->expr->name[0] == nrvoName_)
                ; // already there
            else if (retType_->cat == C_CLASS)
            {
                // build the result in the caller's place
                a.load(RAX, retPtrOff_);
                int slot = newSlot(tPtr(tVoid()));
                a.store(slot, RAX);
                ThisSrc rs;
                rs.kind = TH_INDIRECT;
                rs.off = slot;
                std::vector<cpp::ExprP> one = {s->expr};
                bool braced = s->expr->k == cpp::EK::InitList;
                if (braced)
                    one = s->expr->kids;
                construct(rs, retType_->cls, one, braced, s->line);
            }
            else if (retType_->cat == C_REF)
                bindRef(retType_, s->expr, s->line);
            else
            {
                NT t = expr(s->expr);
                if (t->cat == C_REF)
                    t = t->elem;
                if (retType_->cat == C_PTR && (t->cat == C_PTR || (t->cat == C_INT && s->expr->k == cpp::EK::Int)))
                    convert(retType_, t->cat == C_PTR ? t : retType_, s->line);
                else if (retType_->cat != C_VOID)
                    convert(retType_, t, s->line);
            }
            endFullExpr();
        }
        destroyScopes(0);
        a.jmp(retLabel_);
        break;
    default:
        fail("this statement (not yet)", s->line);
    }
}

} // namespace

std::string compileExe(const std::string &path, const std::string &source)
{
    cpp::Preprocessed pp = cpp::preprocess(path, source);
    cpp::Program prog = cpp::parse(pp);
    Gen g;
    g.program(prog);
    return writePe(g.a, g.entry, g.imports, g.data);
}

} // namespace native

int nativeCompileFile(const std::string &path, const std::string &outPath)
{
    std::ifstream in(path, std::ios::binary);
    if (!in)
    {
        std::cerr << path << ": error: cannot open\n";
        return 1;
    }
    std::ostringstream ss;
    ss << in.rdbuf();
    try
    {
        std::string exe = native::compileExe(path, ss.str());
        std::ofstream out(outPath, std::ios::binary);
        out << exe;
        return out ? 0 : 1;
    }
    catch (const cpp::Unsupported &u)
    {
        std::cerr << (u.file.empty() ? path : u.file) << ":" << u.line << ": error: " << u.what() << "\n";
        return 1;
    }
}
