// <system_error> for Quantum's C/C++ front-end: the error_code the
// <filesystem> overloads fill in. Operations here report failure through
// their result, so a code is always clear.
#pragma once
#include <string>

namespace std
{
class error_code
{
  public:
    error_code() {}
    error_code(int v) : v_(v) {}
    void clear() { v_ = 0; }
    int value() const { return v_; }
    std::string message() const { return v_ ? "error " + std::to_string(v_) : "success"; }
    explicit operator bool() const { return v_ != 0; }

  private:
    int v_ = 0;
};
} // namespace std
