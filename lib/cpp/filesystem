// <filesystem> for Quantum's C/C++ front-end. Paths are kept as their native
// string; decomposition and the file-system queries are the VM's __q_fs_*
// natives, so results match the host's std::filesystem exactly.
#pragma once
#include <string>
#include <vector>
#include <system_error>

std::string __q_fs_part(const std::string &op, const std::string &p);
std::string __q_fs_join(const std::string &a, const std::string &b);
std::string __q_fs_replace_ext(const std::string &p, const std::string &ext);
std::string __q_fs_relative_lex(const std::string &p, const std::string &base);
std::string __q_fs_query(const std::string &op, const std::string &p);
int __q_fs_kind(const std::string &p);
std::vector<std::string> __q_fs_list(const std::string &p, bool recursive);
bool __q_fs_mkdirs(const std::string &p);
int __q_fs_remove(const std::string &p, bool all);
bool __q_fs_copy(const std::string &from, const std::string &to, bool overwrite);
double __q_fs_mtime(const std::string &p);

namespace std
{
namespace filesystem
{
class path
{
  public:
    path() {}
    path(const std::string &s) : s_(s) {}
    path(const char *s) : s_(s) {}

    const std::string &string() const { return s_; }
    std::string u8string() const { return s_; }
    std::string generic_string() const { return __q_fs_part("generic", s_); }
    const char *c_str() const { return s_.c_str(); }
    bool empty() const { return s_.empty(); }

    path parent_path() const { return path(__q_fs_part("parent", s_)); }
    path filename() const { return path(__q_fs_part("filename", s_)); }
    path stem() const { return path(__q_fs_part("stem", s_)); }
    path extension() const { return path(__q_fs_part("extension", s_)); }
    path root_path() const { return path(__q_fs_part("root", s_)); }
    path lexically_normal() const { return path(__q_fs_part("normal", s_)); }
    path lexically_relative(const path &base) const { return path(__q_fs_relative_lex(s_, base.s_)); }
    bool has_parent_path() const { return !__q_fs_part("parent", s_).empty(); }
    bool has_filename() const { return !__q_fs_part("filename", s_).empty(); }
    bool has_extension() const { return !__q_fs_part("extension", s_).empty(); }
    bool is_absolute() const { return __q_fs_part("absolute?", s_) == "1"; }
    bool is_relative() const { return !is_absolute(); }

    path &replace_extension(const path &ext = path())
    {
        s_ = __q_fs_replace_ext(s_, ext.s_);
        return *this;
    }
    path &operator/=(const path &o)
    {
        s_ = __q_fs_join(s_, o.s_);
        return *this;
    }
    path &operator+=(const std::string &o)
    {
        s_ += o;
        return *this;
    }
    path operator/(const path &o) const { return path(__q_fs_join(s_, o.s_)); }
    bool operator==(const path &o) const { return s_ == o.s_; }
    bool operator!=(const path &o) const { return s_ != o.s_; }
    bool operator<(const path &o) const { return s_ < o.s_; }

  private:
    std::string s_;
};

inline path u8path(const std::string &s) { return path(s); }

class filesystem_error : public std::runtime_error
{
  public:
    filesystem_error(const std::string &what) : std::runtime_error(what) {}
};

enum class directory_options
{
    none,
    skip_permission_denied
};
enum class copy_options
{
    none,
    skip_existing,
    overwrite_existing
};

// 0 none, 1 regular file, 2 directory, 3 other
inline bool exists(const path &p) { return __q_fs_kind(p.string()) != 0; }
inline bool exists(const path &p, std::error_code &ec)
{
    ec.clear();
    return exists(p);
}
inline bool is_regular_file(const path &p) { return __q_fs_kind(p.string()) == 1; }
inline bool is_regular_file(const path &p, std::error_code &ec)
{
    ec.clear();
    return is_regular_file(p);
}
inline bool is_directory(const path &p) { return __q_fs_kind(p.string()) == 2; }
inline bool is_directory(const path &p, std::error_code &ec)
{
    ec.clear();
    return is_directory(p);
}
inline bool is_empty(const path &p) { return __q_fs_query("empty?", p.string()) == "1"; }
inline bool is_empty(const path &p, std::error_code &ec)
{
    ec.clear();
    return is_empty(p);
}
inline path absolute(const path &p) { return path(__q_fs_query("absolute", p.string())); }
inline path absolute(const path &p, std::error_code &ec)
{
    ec.clear();
    return absolute(p);
}
inline path weakly_canonical(const path &p) { return path(__q_fs_query("weakly_canonical", p.string())); }
inline path weakly_canonical(const path &p, std::error_code &ec)
{
    ec.clear();
    return weakly_canonical(p);
}
inline path canonical(const path &p) { return path(__q_fs_query("canonical", p.string())); }
inline path relative(const path &p, const path &base) { return path(__q_fs_relative_lex(absolute(p).string(), absolute(base).string())); }
inline path relative(const path &p) { return relative(p, path(__q_fs_query("cwd", ""))); }
inline path relative(const path &p, const path &base, std::error_code &ec)
{
    ec.clear();
    return relative(p, base);
}
inline path current_path() { return path(__q_fs_query("cwd", "")); }
inline bool create_directories(const path &p) { return __q_fs_mkdirs(p.string()); }
inline bool create_directories(const path &p, std::error_code &ec)
{
    ec.clear();
    return create_directories(p);
}
inline bool remove(const path &p) { return __q_fs_remove(p.string(), false) > 0; }
inline bool remove(const path &p, std::error_code &ec)
{
    ec.clear();
    return remove(p);
}
inline int remove_all(const path &p) { return __q_fs_remove(p.string(), true); }
inline int remove_all(const path &p, std::error_code &ec)
{
    ec.clear();
    return remove_all(p);
}
inline bool copy_file(const path &from, const path &to, copy_options o = copy_options::none)
{
    return __q_fs_copy(from.string(), to.string(), o == copy_options::overwrite_existing);
}
inline bool copy_file(const path &from, const path &to, copy_options o, std::error_code &ec)
{
    ec.clear();
    return copy_file(from, to, o);
}

// file_time_type: ticks since the epoch; only compared and printed
class file_time_type
{
  public:
    file_time_type() {}
    file_time_type(long long t) : t_(t) {}
    static file_time_type min() { return file_time_type(-9223372036854775807LL); }
    long long count() const { return t_; }
    bool operator<(const file_time_type &o) const { return t_ < o.t_; }
    bool operator>(const file_time_type &o) const { return t_ > o.t_; }
    bool operator==(const file_time_type &o) const { return t_ == o.t_; }

  private:
    long long t_ = 0;
};
inline file_time_type last_write_time(const path &p) { return file_time_type((long long)__q_fs_mtime(p.string())); }
inline file_time_type last_write_time(const path &p, std::error_code &ec)
{
    ec.clear();
    return last_write_time(p);
}

class directory_entry
{
  public:
    directory_entry() {}
    directory_entry(const path &p) : p_(p) {}
    const filesystem::path &path() const { return p_; }
    bool is_regular_file() const { return filesystem::is_regular_file(p_); }
    bool is_directory() const { return filesystem::is_directory(p_); }
    bool exists() const { return filesystem::exists(p_); }

  private:
    filesystem::path p_;
};

// The listing is taken when the iterator is made; iteration walks it.
class directory_iterator
{
  public:
    directory_iterator() {}
    directory_iterator(const path &p) { load(p, false); }
    directory_iterator(const path &p, std::error_code &ec)
    {
        ec.clear();
        load(p, false);
    }
    directory_iterator(const path &p, directory_options, std::error_code &ec)
    {
        ec.clear();
        load(p, false);
    }
    std::vector<directory_entry>::const_iterator begin() const { return entries_.begin(); }
    std::vector<directory_entry>::const_iterator end() const { return entries_.end(); }

  protected:
    void load(const path &p, bool recursive)
    {
        for (const std::string &s : __q_fs_list(p.string(), recursive))
            entries_.push_back(directory_entry(filesystem::path(s)));
    }
    std::vector<directory_entry> entries_;
};

class recursive_directory_iterator : public directory_iterator
{
  public:
    recursive_directory_iterator() {}
    recursive_directory_iterator(const path &p) { load(p, true); }
    recursive_directory_iterator(const path &p, std::error_code &ec)
    {
        ec.clear();
        load(p, true);
    }
    recursive_directory_iterator(const path &p, directory_options, std::error_code &ec)
    {
        ec.clear();
        load(p, true);
    }
};
} // namespace filesystem
} // namespace std
