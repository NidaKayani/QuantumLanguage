// <regex> for Quantum's C/C++ front-end. A regex is a handle to a pattern
// compiled by the VM (__q_re_* natives, ECMAScript syntax as std::regex); a
// match records each group's position and length in the searched string.
#pragma once
#include <stdexcept>
#include <string>
#include <vector>

int __q_re_compile(const std::string &pattern, int flags);
std::vector<int> __q_re_exec(int handle, const std::string &s, int start, int mode);
std::string __q_re_replace(int handle, const std::string &s, const std::string &fmt, bool firstOnly);

namespace std
{
class regex_error : public std::runtime_error
{
  public:
    regex_error(const std::string &what) : std::runtime_error(what) {}
};

namespace regex_constants
{
// syntax options (bits passed to __q_re_compile)
const int ECMAScript = 0;
const int icase = 1;
const int multiline = 2;
const int nosubs = 4;
const int optimize = 0;
// match / format flags
const int match_default = 0;
const int match_continuous = 1;
const int match_prev_avail = 0;
const int format_default = 0;
const int format_first_only = 2;
} // namespace regex_constants

class regex
{
  public:
    typedef int flag_type;
    static const int ECMAScript = 0;
    static const int icase = 1;
    static const int multiline = 2;
    static const int nosubs = 4;
    static const int optimize = 0;

    regex() {}
    regex(const std::string &pattern, int flags = 0) : h_(compile(pattern, flags)) {}
    regex(const char *pattern, int flags = 0) : h_(compile(std::string(pattern), flags)) {}
    int handle() const { return h_; }

  private:
    static int compile(const std::string &pattern, int flags)
    {
        int h = __q_re_compile(pattern, flags);
        if (h < 0)
            throw regex_error("Invalid regular expression: " + pattern);
        return h;
    }
    int h_ = -1;
};

class ssub_match
{
  public:
    ssub_match() {}
    ssub_match(const std::string &text, bool matched) : text_(text), matched(matched) {}
    std::string str() const { return text_; }
    size_t length() const { return text_.size(); }
    operator std::string() const { return text_; }
    bool operator==(const std::string &o) const { return text_ == o; }
    bool operator!=(const std::string &o) const { return text_ != o; }
    bool matched = false;

  private:
    std::string text_;
};

class smatch
{
  public:
    smatch() {}
    bool empty() const { return pos_.empty(); }
    bool ready() const { return true; }
    size_t size() const { return pos_.size(); }
    long position(size_t i = 0) const { return i < pos_.size() ? pos_[i] : -1; }
    long length(size_t i = 0) const { return i < len_.size() && pos_[i] >= 0 ? len_[i] : 0; }
    std::string str(size_t i = 0) const
    {
        return i < pos_.size() && pos_[i] >= 0 ? subject_.substr(pos_[i], len_[i]) : std::string();
    }
    ssub_match operator[](size_t i) const { return ssub_match(str(i), i < pos_.size() && pos_[i] >= 0); }
    ssub_match prefix() const { return ssub_match(pos_.empty() ? subject_ : subject_.substr(0, pos_[0]), true); }
    ssub_match suffix() const
    {
        return ssub_match(pos_.empty() ? std::string() : subject_.substr(pos_[0] + len_[0]), true);
    }

    // [pos0, len0, pos1, len1, ...] from __q_re_exec, -1 for a group that didn't take part
    void assign(const std::string &subject, const std::vector<int> &groups)
    {
        subject_ = subject;
        pos_.clear();
        len_.clear();
        for (size_t i = 0; i + 1 < groups.size(); i += 2)
        {
            pos_.push_back(groups[i]);
            len_.push_back(groups[i + 1]);
        }
    }

  private:
    std::string subject_;
    std::vector<long> pos_;
    std::vector<long> len_;
};

// mode 0: search, 1: the whole string must match
inline bool regex_search(const std::string &s, smatch &m, const regex &re, int flags = 0)
{
    std::vector<int> g = __q_re_exec(re.handle(), s, 0, (flags & regex_constants::match_continuous) ? 2 : 0);
    m.assign(s, g);
    return !g.empty();
}
inline bool regex_search(const std::string &s, const regex &re, int flags = 0)
{
    return !__q_re_exec(re.handle(), s, 0, (flags & regex_constants::match_continuous) ? 2 : 0).empty();
}
inline bool regex_match(const std::string &s, smatch &m, const regex &re, int flags = 0)
{
    std::vector<int> g = __q_re_exec(re.handle(), s, 0, 1);
    m.assign(s, g);
    return !g.empty();
}
inline bool regex_match(const std::string &s, const regex &re, int flags = 0)
{
    return !__q_re_exec(re.handle(), s, 0, 1).empty();
}
inline std::string regex_replace(const std::string &s, const regex &re, const std::string &fmt, int flags = 0)
{
    return __q_re_replace(re.handle(), s, fmt, (flags & regex_constants::format_first_only) != 0);
}

// Every match in [b, e) in turn; the default-constructed one is the end.
class sregex_iterator
{
  public:
    sregex_iterator() {}
    sregex_iterator(std::string::const_iterator b, std::string::const_iterator e, const regex &re)
        : subject_(b, e), h_(re.handle()), done_(false)
    {
        find(0);
    }
    const smatch &operator*() const { return m_; }
    const smatch *operator->() const { return &m_; }
    sregex_iterator &operator++()
    {
        long next = m_.position(0) + m_.length(0);
        find(m_.length(0) == 0 ? next + 1 : next);
        return *this;
    }
    bool operator==(const sregex_iterator &o) const { return done_ && o.done_; }
    bool operator!=(const sregex_iterator &o) const { return !(*this == o); }

  private:
    void find(long start)
    {
        if (done_ || start > (long)subject_.size())
        {
            done_ = true;
            return;
        }
        std::vector<int> g = __q_re_exec(h_, subject_, (int)start, 0);
        if (g.empty())
        {
            done_ = true;
            return;
        }
        m_.assign(subject_, g);
    }
    std::string subject_;
    int h_ = -1;
    bool done_ = true;
    smatch m_;
};
} // namespace std
