// <cstring> for Quantum's native backend.
#pragma once

inline size_t strlen(const char *s)
{
    size_t n = 0;
    while (s[n])
        ++n;
    return n;
}
inline int strcmp(const char *a, const char *b)
{
    while (*a && *a == *b)
    {
        ++a;
        ++b;
    }
    return (int)(unsigned char)*a - (int)(unsigned char)*b;
}
inline int strncmp(const char *a, const char *b, size_t n)
{
    for (size_t i = 0; i < n; ++i)
    {
        if (a[i] != b[i] || !a[i])
            return (int)(unsigned char)a[i] - (int)(unsigned char)b[i];
    }
    return 0;
}
inline char *strcpy(char *d, const char *s)
{
    size_t i = 0;
    for (; s[i]; ++i)
        d[i] = s[i];
    d[i] = 0;
    return d;
}
inline char *strncpy(char *d, const char *s, size_t n)
{
    size_t i = 0;
    for (; i < n && s[i]; ++i)
        d[i] = s[i];
    for (; i < n; ++i)
        d[i] = 0;
    return d;
}
inline char *strcat(char *d, const char *s)
{
    strcpy(d + strlen(d), s);
    return d;
}
inline const char *strchr(const char *s, int c)
{
    for (;; ++s)
    {
        if (*s == (char)c)
            return s;
        if (!*s)
            return nullptr;
    }
}
inline const char *strrchr(const char *s, int c)
{
    const char *last = nullptr;
    for (;; ++s)
    {
        if (*s == (char)c)
            last = s;
        if (!*s)
            return last;
    }
}
inline const char *strstr(const char *h, const char *n)
{
    size_t ln = strlen(n);
    for (; *h; ++h)
        if (strncmp(h, n, ln) == 0)
            return h;
    return ln == 0 ? h : nullptr;
}
inline void *memcpy(void *d, const void *s, size_t n)
{
    char *dd = (char *)d;
    const char *ss = (const char *)s;
    for (size_t i = 0; i < n; ++i)
        dd[i] = ss[i];
    return d;
}
inline void *memmove(void *d, const void *s, size_t n)
{
    char *dd = (char *)d;
    const char *ss = (const char *)s;
    if (dd < ss)
        for (size_t i = 0; i < n; ++i)
            dd[i] = ss[i];
    else
        for (size_t i = n; i > 0; --i)
            dd[i - 1] = ss[i - 1];
    return d;
}
inline void *memset(void *d, int c, size_t n)
{
    char *dd = (char *)d;
    for (size_t i = 0; i < n; ++i)
        dd[i] = (char)c;
    return d;
}
inline int memcmp(const void *a, const void *b, size_t n)
{
    const unsigned char *x = (const unsigned char *)a, *y = (const unsigned char *)b;
    for (size_t i = 0; i < n; ++i)
        if (x[i] != y[i])
            return (int)x[i] - (int)y[i];
    return 0;
}

