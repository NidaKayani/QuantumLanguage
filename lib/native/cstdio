inline int fclose(FILE *f)
{
    if (!f || f->fd != 0)
        return 0;
    CloseHandle(f->handle);
    delete f->in;
    delete f;
    return 0;
}

inline int fputs(const char *s, FILE *f)
{
    std::__fileWrite(f, s, (long long)std::__strlen(s));
    return 1;
}

inline int fputc(int c, FILE *f)
{
    char ch = (char)c;
    std::__fileWrite(f, &ch, 1);
    return c;
}

inline size_t fwrite(const void *p, size_t size, size_t count, FILE *f)
{
    std::__fileWrite(f, (const char *)p, (long long)(size * count));
    return count;
}

// the next byte from a file's buffer, refilled from a pipe as it empties
inline int __fileByte(FILE *f)
{
    if (f->pipe && (!f->in || f->pos >= f->in->size()))
    {
        char buf[4096];
        DWORD got = 0;
        if (!ReadFile(f->handle, buf, sizeof(buf), &got, nullptr) || got == 0)
            return -1;
        if (!f->in)
            f->in = new std::string();
        f->in->assign(buf, (size_t)got);
        f->pos = 0;
    }
    if (!f->in || f->pos >= f->in->size())
        return -1;
    return (unsigned char)(*f->in)[f->pos++];
}

inline int fgetc(FILE *f)
{
    int c;
    if (f->pipe && f->pending >= 0)
    {
        c = f->pending;
        f->pending = -1;
    }
    else
        c = __fileByte(f);
    if (c == 13 && f->pipe)
    {
        // text mode: CR LF reads as LF
        int n = __fileByte(f);
        if (n == 10)
            c = 10;
        else
            f->pending = n;
    }
    if (c < 0)
        f->eof = true;
    return c;
}

// a command's output to read (cmd.exe /c command, as the C runtime runs it)
inline FILE *_popen(const char *command, const char *mode)
{
    if (mode[0] != 'r')
        return nullptr;
    SECURITY_ATTRIBUTES sa;
    sa.nLength = sizeof(sa);
    sa.lpSecurityDescriptor = nullptr;
    sa.bInheritHandle = TRUE;
    HANDLE rd = nullptr, wr = nullptr;
    if (!CreatePipe(&rd, &wr, &sa, 0))
        return nullptr;
    SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);
    STARTUPINFOA si;
    char *z = (char *)&si;
    for (size_t i = 0; i < sizeof(si); ++i)
        z[i] = 0;
    si.cb = sizeof(si);
    si.dwFlags = STARTF_USESTDHANDLES;
    si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
    si.hStdOutput = wr;
    si.hStdError = GetStdHandle(STD_ERROR_HANDLE);
    PROCESS_INFORMATION pi;
    std::string cmd = std::string("cmd.exe /c ") + command;
    if (!CreateProcessA(nullptr, &cmd[0], nullptr, nullptr, TRUE, 0, nullptr, nullptr, &si, &pi))
    {
        CloseHandle(rd);
        CloseHandle(wr);
        return nullptr;
    }
    CloseHandle(wr);
    CloseHandle(pi.hThread);
    FILE *f = new FILE();
    f->fd = 0;
    f->handle = rd;
    f->eof = false;
    f->in = nullptr;
    f->pos = 0;
    f->proc = pi.hProcess;
    f->pipe = true;
    f->pending = -1;
    return f;
}

inline int _pclose(FILE *f)
{
    if (!f || !f->pipe)
        return -1;
    WaitForSingleObject(f->proc, 0xFFFFFFFF);
    DWORD code = 0;
    GetExitCodeProcess(f->proc, &code);
    CloseHandle(f->proc);
    CloseHandle(f->handle);
    delete f->in;
    delete f;
    return (int)code;
}

inline size_t fread(void *p, size_t size, size_t count, FILE *f)
{
    char *out = (char *)p;
    size_t want = size * count, got = 0;
    while (got < want)
    {
        int c = fgetc(f);
        if (c == -1)
            break;
        out[got++] = (char)c;
    }
    return size ? got / size : 0;
}

inline char *fgets(char *buf, int n, FILE *f)
{
    int i = 0;
    while (i < n - 1)
    {
        int c = fgetc(f);
        if (c == -1)
            break;
        buf[i++] = (char)c;
        if (c == '\n')
            break;
    }
    if (i == 0)
        return nullptr;
    buf[i] = 0;
    return buf;
}

