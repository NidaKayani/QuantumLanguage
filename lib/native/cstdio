// <cstdio> for Quantum's native backend. printf, fprintf, sprintf and
// snprintf are built into the compiler: it packs the arguments (8 bytes each,
// with their kinds) and calls __printf_to / __snprintf_to here.
#pragma once
#include <fstream>
#include <windows.h>

struct FILE
{
    int fd;        // 1 / 2: the console; 0: a file
    HANDLE handle; // a file
    bool eof;
    std::string *in; // a file open for reading: its bytes
    size_t pos;
    HANDLE proc;     // _popen: the child process (its output arrives on handle)
    bool pipe;
    int pending;     // _popen text mode: a byte read ahead (-1: none)
};

FILE __stdin_file = {0, nullptr, false, nullptr, 0};
FILE __stdout_file = {1, nullptr, false, nullptr, 0};
FILE __stderr_file = {2, nullptr, false, nullptr, 0};
FILE *stdin = &__stdin_file;
FILE *stdout = &__stdout_file;
FILE *stderr = &__stderr_file;

namespace std
{

inline void __fileWrite(FILE *f, const char *s, long long n)
{
    if (f->fd == 1)
        cout.write(s, n);
    else if (f->fd == 2)
        cerr.write(s, n);
    else if (f->handle)
    {
        DWORD done = 0;
        WriteFile(f->handle, s, (DWORD)n, &done, nullptr);
    }
}

inline int __printf_to(FILE *f, const char *fmt, const unsigned long long *args, const char *kinds)
{
    string out = __vformat(fmt, args, kinds);
    __fileWrite(f, out.c_str(), (long long)out.size());
    return (int)out.size();
}

inline int __snprintf_to(char *buf, long long cap, const char *fmt, const unsigned long long *args, const char *kinds)
{
    string out = __vformat(fmt, args, kinds);
    if (cap > 0)
    {
        long long n = (long long)out.size() < cap - 1 ? (long long)out.size() : cap - 1;
        for (long long i = 0; i < n; ++i)
            buf[i] = out[i];
        buf[n] = 0;
    }
    return (int)out.size();
}

} // namespace std

inline FILE *fopen(const char *path, const char *mode)
{
    bool write = mode[0] == 'w' || mode[0] == 'a';
    wchar_t *w = std::__widePath(std::string(path));
    HANDLE h;
    if (write)
        h = CreateFileW(w, GENERIC_WRITE, FILE_SHARE_READ, nullptr, mode[0] == 'a' ? OPEN_ALWAYS : CREATE_ALWAYS,
                        FILE_ATTRIBUTE_NORMAL, nullptr);
    else
        h = CreateFileW(w, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
                        FILE_ATTRIBUTE_NORMAL, nullptr);
    delete[] w;
    if (h == (HANDLE)(long long)-1)
        return nullptr;
    FILE *f = new FILE();
    f->fd = 0;
    f->handle = h;
    f->eof = false;
    f->in = nullptr;
    f->pos = 0;
    if (mode[0] == 'a')
        SetFilePointerEx(h, 0, nullptr, 2);
    if (!write)
    {
        long long size = 0;
        GetFileSizeEx(h, &size);
        f->in = new std::string((size_t)size, (char)0);
        DWORD got = 0;
        if (size > 0)
            ReadFile(h, &(*f->in)[0], (DWORD)size, &got, nullptr);
    }
    return f;
}

// a standard stream onto a file ("NUL" too): the process's handle changes,
// which console input and output use
inline FILE *freopen(const char *path, const char *mode, FILE *stream)
{
    bool write = mode[0] == 'w' || mode[0] == 'a';
    wchar_t *w = std::__widePath(std::string(path));
    HANDLE h = write ? CreateFileW(w, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
                                   mode[0] == 'a' ? OPEN_ALWAYS : CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr)
                     : CreateFileW(w, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
                                   FILE_ATTRIBUTE_NORMAL, nullptr);
    delete[] w;
    if (h == (HANDLE)(long long)-1)
        return nullptr;
    if (stream == stdin)
        SetStdHandle(STD_INPUT_HANDLE, h);
    else if (stream == stdout)
        SetStdHandle(STD_OUTPUT_HANDLE, h);
    else if (stream == stderr)
        SetStdHandle(STD_ERROR_HANDLE, h);
    else
    {
        stream->handle = h;
        stream->fd = 0;
    }
    stream->in = nullptr;
    stream->pos = 0;
    stream->eof = false;
    return stream;
}
inline int freopen_s(FILE **out, const char *path, const char *mode, FILE *stream)
{
    FILE *f = freopen(path, mode, stream);
    if (out)
        *out = f;
    return f ? 0 : 1;
}

inline int remove(const char *path)
{
    wchar_t *w = std::__widePath(std::string(path));
    bool ok = DeleteFileW(w) != 0;
    delete[] w;
    return ok ? 0 : -1;
}
inline int rename(const char *from, const char *to)
{
    wchar_t *a = std::__widePath(std::string(from));
    wchar_t *b = std::__widePath(std::string(to));
    bool ok = MoveFileExW(a, b, 0) != 0;
    delete[] a;
    delete[] b;
    return ok ? 0 : -1;
}
