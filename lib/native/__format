// Number formatting for Quantum's native library: printf's conversions,
// exact. A double is mant * 2^exp; its decimal digits come from big-integer
// arithmetic on that exact value, rounded half to even like the C runtime.
#pragma once
#include <string>

namespace std
{

// An unsigned big integer: 32-bit limbs, least significant first
struct __big
{
    unsigned *d;
    int n;   // limbs in use
    int cap; // limbs allocated

    __big() : d(nullptr), n(0), cap(0) {}
    ~__big() { delete[] d; }
    void reserve(int c)
    {
        if (c <= cap)
            return;
        unsigned *nd = new unsigned[c];
        for (int i = 0; i < n; ++i)
            nd[i] = d[i];
        delete[] d;
        d = nd;
        cap = c;
    }
    void set(unsigned long long v)
    {
        reserve(2);
        n = 0;
        while (v)
        {
            d[n++] = (unsigned)(v & 0xFFFFFFFFULL);
            v >>= 32;
        }
    }
    void copyFrom(const __big &o)
    {
        reserve(o.n);
        for (int i = 0; i < o.n; ++i)
            d[i] = o.d[i];
        n = o.n;
    }
    bool zero() const { return n == 0; }
    void trim()
    {
        while (n > 0 && d[n - 1] == 0)
            --n;
    }
    void mulSmall(unsigned m)
    {
        unsigned long long carry = 0;
        for (int i = 0; i < n; ++i)
        {
            unsigned long long t = (unsigned long long)d[i] * m + carry;
            d[i] = (unsigned)(t & 0xFFFFFFFFULL);
            carry = t >> 32;
        }
        if (carry)
        {
            reserve(n + 1);
            d[n++] = (unsigned)carry;
        }
    }
    void addSmall(unsigned a)
    {
        unsigned long long carry = a;
        for (int i = 0; i < n && carry; ++i)
        {
            unsigned long long t = (unsigned long long)d[i] + carry;
            d[i] = (unsigned)(t & 0xFFFFFFFFULL);
            carry = t >> 32;
        }
        if (carry)
        {
            reserve(n + 1);
            d[n++] = (unsigned)carry;
        }
    }
    void shl(int bits)
    {
        if (n == 0 || bits == 0)
            return;
        int words = bits / 32, r = bits % 32;
        reserve(n + words + 1);
        d[n + words] = 0;
        for (int i = n - 1; i >= 0; --i)
        {
            unsigned long long v = (unsigned long long)d[i] << r;
            d[i + words + 1] |= (unsigned)(v >> 32);
            d[i + words] = (unsigned)(v & 0xFFFFFFFFULL);
        }
        for (int i = 0; i < words; ++i)
            d[i] = 0;
        n += words + 1;
        trim();
    }
    // the remainder of dividing by m (the quotient replaces it)
    unsigned divSmall(unsigned m)
    {
        unsigned long long rem = 0;
        for (int i = n - 1; i >= 0; --i)
        {
            unsigned long long cur = (rem << 32) | d[i];
            d[i] = (unsigned)(cur / m);
            rem = cur % m;
        }
        trim();
        return (unsigned)rem;
    }
    int bitLength() const
    {
        if (n == 0)
            return 0;
        int b = 32 * (n - 1);
        unsigned top = d[n - 1];
        while (top)
        {
            ++b;
            top >>= 1;
        }
        return b;
    }
    bool bit(int i) const
    {
        int w = i / 32;
        return w < n && ((d[w] >> (i % 32)) & 1);
    }
};

inline int __bigcmp(const __big &a, const __big &b)
{
    if (a.n != b.n)
        return a.n < b.n ? -1 : 1;
    for (int i = a.n - 1; i >= 0; --i)
        if (a.d[i] != b.d[i])
            return a.d[i] < b.d[i] ? -1 : 1;
    return 0;
}

// a -= b (a >= b)
inline void __bigsub(__big &a, const __big &b)
{
    long long borrow = 0;
    for (int i = 0; i < a.n; ++i)
    {
        long long t = (long long)a.d[i] - (i < b.n ? (long long)b.d[i] : 0) - borrow;
        borrow = t < 0 ? 1 : 0;
        if (t < 0)
            t += 4294967296LL;
        a.d[i] = (unsigned)t;
    }
    a.trim();
}

// q = num / den, num becomes the remainder (binary long division)
inline void __bigdiv(__big &num, const __big &den, __big &q)
{
    q.set(0);
    int bits = num.bitLength() - den.bitLength();
    if (bits < 0)
        return;
    __big shifted;
    shifted.copyFrom(den);
    shifted.shl(bits);
    q.reserve(bits / 32 + 2);
    for (int i = 0; i < bits / 32 + 2; ++i)
        q.d[i] = 0;
    q.n = bits / 32 + 2;
    for (int i = bits; i >= 0; --i)
    {
        if (__bigcmp(num, shifted) >= 0)
        {
            __bigsub(num, shifted);
            q.d[i / 32] |= 1u << (i % 32);
        }
        // shifted >>= 1
        for (int k = 0; k < shifted.n; ++k)
        {
            unsigned next = k + 1 < shifted.n ? shifted.d[k + 1] : 0;
            shifted.d[k] = (shifted.d[k] >> 1) | (next << 31);
        }
        shifted.trim();
    }
    q.trim();
}

inline void __bigpow10(__big &b, int k)
{
    for (int i = 0; i < k; ++i)
        b.mulSmall(10);
}

// The exact parts of a finite double v > 0: v = mant * 2^exp
inline void __split(double v, unsigned long long &mant, int &exp)
{
    // scale into [2^52, 2^53) with exact multiplications by powers of two
    exp = 0;
    while (v >= 9007199254740992.0)
    {
        v *= 0.5;
        ++exp;
    }
    while (v < 4503599627370496.0 && exp > -1074)
    {
        v *= 2;
        --exp;
    }
    mant = (unsigned long long)v;
}

// The digits of round(v / 10^last) (v > 0, finite), half to even
inline string __roundedDigits(double v, int last)
{
    unsigned long long mant;
    int exp;
    __split(v, mant, exp);
    __big num, den;
    num.set(mant);
    den.set(1);
    if (exp > 0)
        num.shl(exp);
    else
        den.shl(-exp);
    if (last < 0)
        __bigpow10(num, -last);
    else
        __bigpow10(den, last);
    __big q;
    __bigdiv(num, den, q); // num: the remainder
    num.shl(1);
    int c = __bigcmp(num, den);
    if (c > 0 || (c == 0 && q.bit(0)))
        q.addSmall(1);
    if (q.zero())
        return "0";
    string digits;
    while (!q.zero())
        digits += (char)('0' + q.divSmall(10));
    string out;
    for (size_t i = digits.size(); i > 0; --i)
        out += digits[i - 1];
    return out;
}

// %e digits: `prec + 1` significant digits and the exponent (v > 0)
inline string __sciDigits(double v, int prec, int &exp10)
{
    int k = 0;
    double t = v;
    while (t >= 10)
    {
        t /= 10;
        ++k;
    }
    while (t < 1)
    {
        t *= 10;
        --k;
    }
    for (int tries = 0; tries < 4; ++tries)
    {
        string d = __roundedDigits(v, k - prec);
        if ((int)d.size() == prec + 2)
        {
            ++k; // rounding carried, or k was low
            continue;
        }
        if ((int)d.size() < prec + 1)
        {
            --k;
            continue;
        }
        exp10 = k;
        return d;
    }
    exp10 = k;
    return __roundedDigits(v, k - prec);
}

// A double as printf's %e / %f / %g (and %E %F %G) would write it, without
// width padding. `alt` is the # flag.
inline string __fmtDouble(double v, char conv, int prec, bool alt, bool plus, bool space)
{
    string sign;
    bool neg = v < 0 || (v == 0 && 1 / v < 0);
    if (v != v)
        neg = false;
    if (neg)
    {
        sign = "-";
        v = -v;
    }
    else if (plus)
        sign = "+";
    else if (space)
        sign = " ";
    bool upper = conv == 'E' || conv == 'F' || conv == 'G';
    if (v != v)
        return sign + (upper ? "NAN" : "nan");
    if (v > 1.7976931348623157e308)
        return sign + (upper ? "INF" : "inf");
    if (prec < 0)
        prec = 6;
    char c = conv;
    if (c >= 'A' && c <= 'Z')
        c = (char)(c - 'A' + 'a');
    if (c == 'g')
    {
        int p = prec == 0 ? 1 : prec;
        int x = 0;
        if (v != 0)
            __sciDigits(v, p - 1, x);
        if (p > x && x >= -4)
        {
            c = 'f';
            prec = p - 1 - x;
        }
        else
        {
            c = 'e';
            prec = p - 1;
        }
        string body = __fmtDouble(v, upper ? (char)(c - 'a' + 'A') : c, prec, alt, false, false);
        if (!alt)
        {
            // trailing zeros of the fraction go, then a bare point
            size_t e = body.find(upper ? 'E' : 'e');
            string mant = e == string::npos ? body : body.substr(0, e);
            string tail = e == string::npos ? string() : body.substr(e);
            if (mant.find('.') != string::npos)
            {
                while (!mant.empty() && mant.back() == '0')
                    mant.pop_back();
                if (!mant.empty() && mant.back() == '.')
                    mant.pop_back();
            }
            body = mant + tail;
        }
        return sign + body;
    }
    if (c == 'e')
    {
        string d;
        int x = 0;
        if (v == 0)
            d = string((size_t)prec + 1, '0');
        else
            d = __sciDigits(v, prec, x);
        string out = sign;
        out += d[0];
        if (prec > 0 || alt)
            out += '.';
        out += d.substr(1);
        out += upper ? 'E' : 'e';
        out += x < 0 ? '-' : '+';
        int ax = x < 0 ? -x : x;
        if (ax < 10)
            out += '0';
        out += to_string(ax);
        return out;
    }
    // %f: round(v * 10^prec), the point placed `prec` digits from the end
    string d = v == 0 ? string("0") : __roundedDigits(v, -prec);
    while ((int)d.size() < prec + 1)
        d = "0" + d;
    string out = sign + d.substr(0, d.size() - prec);
    if (prec > 0 || alt)
        out += '.';
    out += d.substr(d.size() - prec);
    return out;
}

// One argument for __vformat: an 8-byte slot and its kind
//   'd' signed integer, 'u' unsigned integer, 'f' double (its bits), 'p' pointer
inline string __fmtInt(unsigned long long u, bool negative, char conv, int prec, bool alt, bool plus, bool space)
{
    string digits;
    unsigned base = conv == 'x' || conv == 'X' ? 16 : conv == 'o' ? 8 : 10;
    const char *set = conv == 'X' ? "0123456789ABCDEF" : "0123456789abcdef";
    while (u)
    {
        digits = set[u % base] + digits;
        u /= base;
    }
    if (prec < 0)
        prec = 1;
    while ((int)digits.size() < prec)
        digits = "0" + digits;
    string prefix;
    if (negative)
        prefix = "-";
    else if (plus && conv != 'u' && base == 10)
        prefix = "+";
    else if (space && conv != 'u' && base == 10)
        prefix = " ";
    if (alt && base == 16 && digits != "0" && !digits.empty())
        prefix += conv == 'X' ? "0X" : "0x";
    if (alt && base == 8 && (digits.empty() || digits[0] != '0'))
        digits = "0" + digits;
    return prefix + digits;
}

inline double __bitsToDouble(unsigned long long bits)
{
    double v = 0;
    unsigned long long *p = (unsigned long long *)&v;
    *p = bits;
    return v;
}

// printf's formatting of `args` (one 8-byte slot each, kinds as above)
inline string __vformat(const char *fmt, const unsigned long long *args, const char *kinds)
{
    string out;
    int ai = 0;
    for (const char *p = fmt; *p; ++p)
    {
        if (*p != '%')
        {
            out += *p;
            continue;
        }
        ++p;
        if (*p == '%')
        {
            out += '%';
            continue;
        }
        bool left = false, plus = false, space = false, alt = false, zero = false;
        while (*p == '-' || *p == '+' || *p == ' ' || *p == '#' || *p == '0')
        {
            if (*p == '-')
                left = true;
            else if (*p == '+')
                plus = true;
            else if (*p == ' ')
                space = true;
            else if (*p == '#')
                alt = true;
            else
                zero = true;
            ++p;
        }
        int width = 0;
        if (*p == '*')
        {
            width = (int)(long long)args[ai++];
            if (width < 0)
            {
                left = true;
                width = -width;
            }
            ++p;
        }
        else
            while (*p >= '0' && *p <= '9')
                width = width * 10 + (*p++ - '0');
        int prec = -1;
        if (*p == '.')
        {
            ++p;
            prec = 0;
            if (*p == '*')
            {
                prec = (int)(long long)args[ai++];
                ++p;
            }
            else
                while (*p >= '0' && *p <= '9')
                    prec = prec * 10 + (*p++ - '0');
        }
        while (*p == 'l' || *p == 'h' || *p == 'z' || *p == 'j' || *p == 't' || *p == 'L')
            ++p;
        char conv = *p;
        string body;
        bool numeric = true;
        if (conv == 'd' || conv == 'i')
        {
            long long v = (long long)args[ai];
            char k = kinds[ai++];
            if (k == 'u')
                v = (long long)args[ai - 1];
            unsigned long long u = v < 0 ? (unsigned long long)0 - (unsigned long long)v : (unsigned long long)v;
            body = __fmtInt(u, v < 0, 'd', prec, alt, plus, space);
        }
        else if (conv == 'u' || conv == 'x' || conv == 'X' || conv == 'o')
        {
            unsigned long long u = args[ai];
            char k = kinds[ai++];
            if (k == 'd' && (long long)u < 0)
                u = u; // as the unsigned value of the same bits
            body = __fmtInt(u, false, conv, prec, alt, false, false);
        }
        else if (conv == 'e' || conv == 'E' || conv == 'f' || conv == 'F' || conv == 'g' || conv == 'G')
            body = __fmtDouble(__bitsToDouble(args[ai++]), conv, prec, alt, plus, space);
        else if (conv == 'c')
        {
            body += (char)args[ai++];
            numeric = false;
        }
        else if (conv == 's')
        {
            const char *s = (const char *)args[ai++];
            if (!s)
                s = "(null)";
            size_t len = 0;
            while (s[len] && (prec < 0 || (int)len < prec))
                ++len;
            body = string(s, len);
            numeric = false;
        }
        else if (conv == 'p')
        {
            body = __fmtInt(args[ai++], false, 'X', 16, false, false, false);
            numeric = false;
        }
        else
        {
            out += '%';
            out += conv;
            continue;
        }
        if ((int)body.size() < width)
        {
            size_t pad = (size_t)width - body.size();
            if (left)
                body += string(pad, ' ');
            else if (zero && numeric && prec < 0 || (zero && numeric && (conv == 'e' || conv == 'E' || conv == 'f' || conv == 'F' || conv == 'g' || conv == 'G')))
            {
                // zeros after the sign / 0x
                size_t at = 0;
                if (!body.empty() && (body[0] == '-' || body[0] == '+' || body[0] == ' '))
                    at = 1;
                if (body.size() > at + 1 && body[at] == '0' && (body[at + 1] == 'x' || body[at + 1] == 'X'))
                    at += 2;
                body = body.substr(0, at) + string(pad, '0') + body.substr(at);
            }
            else
                body = string(pad, ' ') + body;
        }
        out += body;
    }
    return out;
}

// The double nearest the number at the start of s (strtod's job): decimal
// digits, a point, an exponent; inf / nan. `used` is how many characters it
// took (0: none). Exact: the decimal value is a big integer times a power of
// ten, divided down and rounded half to even once.
inline double __parseDouble(const string &s, size_t &used)
{
    size_t i = 0;
    used = 0;
    while (i < s.size() && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r' || s[i] == '\v' || s[i] == '\f'))
        ++i;
    bool neg = false;
    if (i < s.size() && (s[i] == '+' || s[i] == '-'))
    {
        neg = s[i] == '-';
        ++i;
    }
    auto lower = [&](size_t k) -> char { return k < s.size() ? (char)(s[k] | 32) : (char)0; };
    if (lower(i) == 'i' && lower(i + 1) == 'n' && lower(i + 2) == 'f')
    {
        used = i + 3;
        if (lower(i + 3) == 'i' && lower(i + 4) == 'n' && lower(i + 5) == 'i' && lower(i + 6) == 't' && lower(i + 7) == 'y')
            used = i + 8;
        return neg ? -__bitsToDouble(0x7FF0000000000000ULL) : __bitsToDouble(0x7FF0000000000000ULL);
    }
    if (lower(i) == 'n' && lower(i + 1) == 'a' && lower(i + 2) == 'n')
    {
        used = i + 3;
        return __bitsToDouble(neg ? 0xFFF8000000000000ULL : 0x7FF8000000000000ULL);
    }
    if (i + 1 < s.size() && s[i] == '0' && lower(i + 1) == 'x')
    {
        // hex: 0x1.8p3 (mantissa in hex digits, a binary exponent)
        auto hexDigit = [&](size_t k) -> int
        {
            char c = lower(k);
            return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
        };
        size_t j = i + 2;
        unsigned long long mant = 0;
        int binExp = 0;
        bool sticky = false, anyHex = false;
        for (; hexDigit(j) >= 0; ++j)
        {
            anyHex = true;
            int d = hexDigit(j);
            if ((mant >> 60) == 0)
                mant = mant * 16 + (unsigned)d;
            else
            {
                binExp += 4;
                if (d)
                    sticky = true;
            }
        }
        if (j < s.size() && s[j] == '.')
            for (++j; hexDigit(j) >= 0; ++j)
            {
                anyHex = true;
                int d = hexDigit(j);
                if ((mant >> 60) == 0)
                {
                    mant = mant * 16 + (unsigned)d;
                    binExp -= 4;
                }
                else if (d)
                    sticky = true;
            }
        if (anyHex)
        {
            if (lower(j) == 'p')
            {
                size_t k = j + 1;
                bool eneg = false;
                if (k < s.size() && (s[k] == '+' || s[k] == '-'))
                {
                    eneg = s[k] == '-';
                    ++k;
                }
                if (k < s.size() && s[k] >= '0' && s[k] <= '9')
                {
                    int e = 0;
                    for (; k < s.size() && s[k] >= '0' && s[k] <= '9'; ++k)
                        if (e < 100000)
                            e = e * 10 + (s[k] - '0');
                    binExp += eneg ? -e : e;
                    j = k;
                }
            }
            used = j;
            unsigned long long sign = neg ? 0x8000000000000000ULL : 0;
            if (mant == 0)
                return __bitsToDouble(sign);
            while (!(mant >> 63))
            {
                mant <<= 1;
                --binExp;
            }
            // value = mant * 2^binExp, mant in [2^63, 2^64): keep 53 bits
            int biased = binExp + 63 + 1023, shift = 11;
            if (biased <= 0)
            {
                shift += 1 - biased; // subnormal: fewer bits
                biased = 0;
            }
            if (shift > 64)
                return __bitsToDouble(sign);
            unsigned long long kept = shift == 64 ? 0 : mant >> shift;
            unsigned long long rem = shift == 64 ? mant : mant & ((1ULL << shift) - 1);
            unsigned long long half = 1ULL << (shift - 1);
            if (rem > half || (rem == half && (sticky || (kept & 1))))
                ++kept;
            if (biased == 0)
                return __bitsToDouble(sign | kept); // a carry into bit 52 makes it normal
            if (kept >> 53)
            {
                kept >>= 1;
                ++biased;
            }
            if (biased >= 2047)
                return __bitsToDouble(sign | 0x7FF0000000000000ULL);
            return __bitsToDouble(sign | ((unsigned long long)biased << 52) | (kept & ((1ULL << 52) - 1)));
        }
    }
    __big m;
    m.set(0);
    int digits = 0, exp10 = 0;
    bool any = false, sticky = false;
    while (i < s.size() && s[i] >= '0' && s[i] <= '9')
    {
        any = true;
        if (digits < 800)
        {
            if (digits > 0 || s[i] != '0')
            {
                m.mulSmall(10);
                m.addSmall((unsigned)(s[i] - '0'));
                ++digits;
            }
        }
        else
        {
            ++exp10; // beyond 800 digits: they only decide rounding
            if (s[i] != '0')
                sticky = true;
        }
        ++i;
    }
    if (i < s.size() && s[i] == '.')
    {
        ++i;
        while (i < s.size() && s[i] >= '0' && s[i] <= '9')
        {
            any = true;
            if (digits < 800)
            {
                if (digits > 0 || s[i] != '0')
                {
                    m.mulSmall(10);
                    m.addSmall((unsigned)(s[i] - '0'));
                    ++digits;
                }
                --exp10;
            }
            else if (s[i] != '0')
                sticky = true;
            ++i;
        }
    }
    if (!any)
        return 0;
    used = i;
    if (i < s.size() && (s[i] == 'e' || s[i] == 'E'))
    {
        size_t k = i + 1;
        bool eneg = false;
        if (k < s.size() && (s[k] == '+' || s[k] == '-'))
        {
            eneg = s[k] == '-';
            ++k;
        }
        if (k < s.size() && s[k] >= '0' && s[k] <= '9')
        {
            int e = 0;
            while (k < s.size() && s[k] >= '0' && s[k] <= '9')
            {
                if (e < 100000)
                    e = e * 10 + (s[k] - '0');
                ++k;
            }
            exp10 += eneg ? -e : e;
            used = k;
        }
    }
    if (m.zero())
        return neg ? -0.0 : 0.0;
    if (exp10 > 400)
        return neg ? -__bitsToDouble(0x7FF0000000000000ULL) : __bitsToDouble(0x7FF0000000000000ULL);
    if (exp10 < -400 - digits)
        return neg ? -0.0 : 0.0;
    // q * 2^bin = the value (q an integer of at least 64 bits when divided)
    __big q;
    int bin = 0;
    if (exp10 >= 0)
    {
        __bigpow10(m, exp10);
        q.copyFrom(m);
    }
    else
    {
        __big den;
        den.set(1);
        __bigpow10(den, -exp10);
        int k = 64 + den.bitLength() - m.bitLength();
        if (k < 0)
            k = 0;
        m.shl(k);
        bin = -k;
        __bigdiv(m, den, q);
        if (!m.zero())
            sticky = true;
    }
    // the top 54 bits (53 and a rounding bit), the rest sticky
    int bits = q.bitLength();
    int shift = bits - 54;
    unsigned long long top = 0;
    for (int b = bits - 1; b >= 0 && b >= shift; --b)
        top = (top << 1) | (q.bit(b) ? 1ULL : 0ULL);
    if (shift < 0)
        top <<= -shift;
    for (int b = 0; b < shift; ++b)
        if (q.bit(b))
        {
            sticky = true;
            break;
        }
    int lead = bin + shift + 53; // the exponent of the leading bit
    if (lead < -1022)
    {
        int extra = -1022 - lead;
        if (extra > 60)
            extra = 60;
        for (int b = 0; b < extra; ++b)
        {
            if (top & 1)
                sticky = true;
            top >>= 1;
        }
        lead = -1022;
    }
    unsigned long long mant = top >> 1;
    if ((top & 1) && (sticky || (mant & 1)))
        ++mant;
    if (mant >> 53)
    {
        mant >>= 1;
        ++lead;
    }
    if (lead > 1023)
        return neg ? -__bitsToDouble(0x7FF0000000000000ULL) : __bitsToDouble(0x7FF0000000000000ULL);
    unsigned long long out;
    if (mant >> 52)
        out = ((unsigned long long)(lead + 1023) << 52) | (mant & 0xFFFFFFFFFFFFFULL);
    else
        out = mant; // subnormal
    if (neg)
        out |= 0x8000000000000000ULL;
    return __bitsToDouble(out);
}

} // namespace std
