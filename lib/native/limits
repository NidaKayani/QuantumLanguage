// <limits> for Quantum's native backend: std::numeric_limits<T>, its static
// functions answered by helpers overloaded on T (no specializations needed).
#pragma once

namespace std
{

inline double __nl_bits(unsigned long long b) { return *(double *)&b; }
inline float __nl_bits32(unsigned b) { return *(float *)&b; }

inline double __nl_max(double) { return __nl_bits(0x7FEFFFFFFFFFFFFFULL); }
inline double __nl_min(double) { return __nl_bits(0x0010000000000000ULL); }
inline double __nl_lowest(double) { return -__nl_bits(0x7FEFFFFFFFFFFFFFULL); }
inline double __nl_epsilon(double) { return __nl_bits(0x3CB0000000000000ULL); }
inline double __nl_infinity(double) { return __nl_bits(0x7FF0000000000000ULL); }
inline double __nl_nan(double) { return __nl_bits(0x7FF8000000000000ULL); }
inline double __nl_denorm(double) { return __nl_bits(1ULL); }
inline int __nl_digits(double) { return 53; }
inline int __nl_digits10(double) { return 15; }
inline bool __nl_integer(double) { return false; }

inline float __nl_max(float) { return __nl_bits32(0x7F7FFFFFU); }
inline float __nl_min(float) { return __nl_bits32(0x00800000U); }
inline float __nl_lowest(float) { return -__nl_bits32(0x7F7FFFFFU); }
inline float __nl_epsilon(float) { return __nl_bits32(0x34000000U); }
inline float __nl_infinity(float) { return __nl_bits32(0x7F800000U); }
inline float __nl_nan(float) { return __nl_bits32(0x7FC00000U); }
inline float __nl_denorm(float) { return __nl_bits32(1U); }
inline int __nl_digits(float) { return 24; }
inline int __nl_digits10(float) { return 6; }
inline bool __nl_integer(float) { return false; }

#define __NL_INT(T, MIN, MAX, DIGITS, D10)                                                                             \
    inline T __nl_max(T) { return MAX; }                                                                               \
    inline T __nl_min(T) { return MIN; }                                                                               \
    inline T __nl_lowest(T) { return MIN; }                                                                            \
    inline T __nl_epsilon(T) { return 0; }                                                                             \
    inline T __nl_infinity(T) { return 0; }                                                                            \
    inline T __nl_nan(T) { return 0; }                                                                                 \
    inline T __nl_denorm(T) { return 0; }                                                                              \
    inline int __nl_digits(T) { return DIGITS; }                                                                       \
    inline int __nl_digits10(T) { return D10; }                                                                       \
    inline bool __nl_integer(T) { return true; }

__NL_INT(bool, false, true, 1, 0)
__NL_INT(char, (char)-128, (char)127, 7, 2)
__NL_INT(unsigned char, (unsigned char)0, (unsigned char)255, 8, 2)
__NL_INT(short, (short)-32768, (short)32767, 15, 4)
__NL_INT(unsigned short, (unsigned short)0, (unsigned short)65535, 16, 4)
__NL_INT(int, -2147483647 - 1, 2147483647, 31, 9)
__NL_INT(unsigned, 0U, 4294967295U, 32, 9)
__NL_INT(long long, -9223372036854775807LL - 1, 9223372036854775807LL, 63, 18)
__NL_INT(unsigned long long, 0ULL, 18446744073709551615ULL, 64, 19)
#undef __NL_INT

template <typename T>
struct numeric_limits
{
    static T max() { return __nl_max((T)0); }
    static T min() { return __nl_min((T)0); }
    static T lowest() { return __nl_lowest((T)0); }
    static T epsilon() { return __nl_epsilon((T)0); }
    static T infinity() { return __nl_infinity((T)0); }
    static T quiet_NaN() { return __nl_nan((T)0); }
    static T signaling_NaN() { return __nl_nan((T)0); }
    static T denorm_min() { return __nl_denorm((T)0); }
};

} // namespace std
