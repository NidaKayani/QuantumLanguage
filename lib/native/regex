// successive matches, as the standard's regex_iterator steps
class sregex_iterator
{
  public:
    sregex_iterator() : first_(nullptr), last_(nullptr), re_(nullptr), flags_(0), done_(true) {}
    sregex_iterator(const char *first, const char *last, const regex &re,
                    unsigned flags = regex_constants::match_default)
        : first_(first), last_(last), re_(&re), flags_(flags), done_(false)
    {
        if (!__rx_search(first_, last_, first_, &m_, *re_, flags_, 0))
            done_ = true;
    }
    const match_results &operator*() const { return m_; }
    const match_results *operator->() const { return &m_; }
    sregex_iterator &operator++()
    {
        const char *start = m_[0].second;
        unsigned fl = flags_ | regex_constants::match_prev_avail;
        if (m_[0].first == m_[0].second)
        {
            if (start == last_)
            {
                done_ = true;
                return *this;
            }
            if (__rx_search(first_, last_, start, &m_, *re_,
                            fl | regex_constants::match_not_null | regex_constants::match_continuous, 0))
            {
                m_.begin_ = first_;
                return *this;
            }
            ++start;
        }
        if (!__rx_search(first_, last_, start, &m_, *re_, fl, 0))
            done_ = true;
        else
            m_.begin_ = first_;
        return *this;
    }
    bool operator==(const sregex_iterator &o) const
    {
        if (done_ || o.done_)
            return done_ == o.done_;
        return m_[0].first == o.m_[0].first && m_[0].second == o.m_[0].second;
    }
    bool operator!=(const sregex_iterator &o) const { return !(*this == o); }

  private:
    const char *first_;
    const char *last_;
    const regex *re_;
    unsigned flags_;
    bool done_;
    match_results m_;
};
typedef sregex_iterator cregex_iterator;

// one piece a token iterator gives (as a sub_match would)
struct __rx_token
{
    string s;
    bool matched = true;
    string str() const { return s; }
    long long length() const { return (long long)s.size(); }
    operator string() const { return s; }
    bool operator==(const string &o) const { return s == o; }
    bool operator!=(const string &o) const { return s != o; }
};

// the pieces between matches (submatch -1) or one group of each match
class sregex_token_iterator
{
  public:
    sregex_token_iterator() : i_(0) {}
    sregex_token_iterator(const char *first, const char *last, const regex &re, int sub = 0) : i_(0)
    {
        const char *pos = first;
        for (sregex_iterator it(first, last, re), end; it != end; ++it)
        {
            if (sub == -1)
                parts_.push_back(__rx_token{string(pos, (size_t)((*it)[0].first - pos))});
            else
                parts_.push_back(__rx_token{(*it)[(size_t)sub].str()});
            pos = (*it)[0].second;
        }
        if (sub == -1 && (pos != last || !parts_.empty() || first == last))
            parts_.push_back(__rx_token{string(pos, (size_t)(last - pos))});
        if (sub == -1 && first == last)
            parts_.clear();
    }
    const __rx_token &operator*() const { return parts_[i_]; }
    const __rx_token *operator->() const { return &parts_[i_]; }
    sregex_token_iterator &operator++()
    {
        ++i_;
        return *this;
    }
    bool operator==(const sregex_token_iterator &o) const { return i_ >= parts_.size() && o.i_ >= o.parts_.size(); }
    bool operator!=(const sregex_token_iterator &o) const { return !(*this == o); }

  private:
    vector<__rx_token> parts_;
    size_t i_;
};

inline string regex_replace(const string &s, const regex &re, const string &fmt,
                            unsigned flags = regex_constants::format_default)
{
    string out;
    const char *first = s.data(), *last = s.data() + s.size();
    const char *pos = first;
    bool any = false;
    for (sregex_iterator it(first, last, re, flags & 255), end; it != end; ++it)
    {
        any = true;
        if (!(flags & regex_constants::format_no_copy))
            out.append(pos, (size_t)((*it)[0].first - pos));
        out += it->format(fmt);
        pos = (*it)[0].second;
        if (flags & regex_constants::format_first_only)
            break;
    }
    if (!(flags & regex_constants::format_no_copy))
        out.append(pos, (size_t)(last - pos));
    (void)any;
    return out;
}
inline string regex_replace(const string &s, const regex &re, const char *fmt,
                            unsigned flags = regex_constants::format_default)
{
    return regex_replace(s, re, string(fmt), flags);
}

