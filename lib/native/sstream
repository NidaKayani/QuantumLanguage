// <sstream> for Quantum's native backend: streams over a string.
#pragma once
#include <iostream>

namespace std
{

class stringstream : public __stream
{
  public:
    stringstream() : pos_(0) {}
    explicit stringstream(const string &s) : buf_(s), pos_(0) {}
    explicit stringstream(int) : pos_(0) {}
    void write(const char *s, long long n) override { buf_.append(s, (size_t)n); }
    int __getc() override { return pos_ < buf_.size() ? (unsigned char)buf_[pos_++] : -1; }
    int __peekc() override { return pos_ < buf_.size() ? (unsigned char)buf_[pos_] : -1; }
    string __rest() override
    {
        string r = buf_.substr(pos_);
        pos_ = buf_.size();
        return r;
    }
    long long __tell(bool put) override { return put ? (long long)buf_.size() : (long long)pos_; }
    bool __seek(bool put, long long off, int dir) override
    {
        if (put)
            return false;
        long long base = dir == beg ? 0 : dir == cur ? (long long)pos_ : (long long)buf_.size();
        if (base + off < 0 || base + off > (long long)buf_.size())
            return false;
        pos_ = (size_t)(base + off);
        return true;
    }
    string str() const { return buf_; }
    void str(const string &s)
    {
        buf_ = s;
        pos_ = 0;
    }

  private:
    string buf_;
    size_t pos_;
};

typedef stringstream ostringstream;
typedef stringstream istringstream;

} // namespace std
