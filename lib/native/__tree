// The balanced (AVL) search tree behind <map> and <set>: nodes keyed by
// kv.first, compared with <, linked to their parents so iterators can walk
// both ways. Nodes never move: references to elements stay valid until they
// are erased.
#pragma once
#include <utility>

namespace std
{

template <typename K, typename V>
struct __tnode
{
    pair<K, V> kv;
    __tnode *left;
    __tnode *right;
    __tnode *parent;
    int height;
    explicit __tnode(pair<K, V> &&x) : kv(std::move(x)), left(nullptr), right(nullptr), parent(nullptr), height(1) {}
};

template <typename K, typename V>
class __tree
{
  public:
    typedef __tnode<K, V> Node;

    __tree() : root_(nullptr), size_(0) {}
    ~__tree() { clear(); }

    Node *root_;
    size_t size_;

    void clear()
    {
        drop(root_);
        root_ = nullptr;
        size_ = 0;
    }
    void copyFrom(const __tree &o)
    {
        for (Node *n = o.first(); n; n = next(n))
        {
            bool added = false;
            insert(n->kv, added);
        }
    }
    void swap(__tree &o)
    {
        Node *r = root_;
        size_t n = size_;
        root_ = o.root_;
        size_ = o.size_;
        o.root_ = r;
        o.size_ = n;
    }
    void takeFrom(__tree &o)
    {
        root_ = o.root_;
        size_ = o.size_;
        o.root_ = nullptr;
        o.size_ = 0;
    }

    Node *find(const K &k) const
    {
        Node *n = root_;
        while (n)
        {
            if (k < n->kv.first)
                n = n->left;
            else if (n->kv.first < k)
                n = n->right;
            else
                return n;
        }
        return nullptr;
    }
    // the first node whose key is not less than k (upper: greater than k)
    Node *lowerBound(const K &k) const
    {
        Node *n = root_, *r = nullptr;
        while (n)
        {
            if (n->kv.first < k)
                n = n->right;
            else
            {
                r = n;
                n = n->left;
            }
        }
        return r;
    }
    Node *upperBound(const K &k) const
    {
        Node *n = root_, *r = nullptr;
        while (n)
        {
            if (k < n->kv.first)
            {
                r = n;
                n = n->left;
            }
            else
                n = n->right;
        }
        return r;
    }
    Node *first() const
    {
        Node *n = root_;
        while (n && n->left)
            n = n->left;
        return n;
    }
    Node *last() const
    {
        Node *n = root_;
        while (n && n->right)
            n = n->right;
        return n;
    }
    static Node *next(Node *n)
    {
        if (n->right)
        {
            n = n->right;
            while (n->left)
                n = n->left;
            return n;
        }
        Node *p = n->parent;
        while (p && n == p->right)
        {
            n = p;
            p = p->parent;
        }
        return p;
    }
    static Node *prev(Node *n)
    {
        if (n->left)
        {
            n = n->left;
            while (n->right)
                n = n->right;
            return n;
        }
        Node *p = n->parent;
        while (p && n == p->left)
        {
            n = p;
            p = p->parent;
        }
        return p;
    }

    // the node with kv's key: the one there, or kv added
    Node *insert(pair<K, V> kv, bool &added)
    {
        Node *p = nullptr, *n = root_;
        bool left = false;
        while (n)
        {
            p = n;
            if (kv.first < n->kv.first)
            {
                n = n->left;
                left = true;
            }
            else if (n->kv.first < kv.first)
            {
                n = n->right;
                left = false;
            }
            else
            {
                added = false;
                return n;
            }
        }
        Node *x = new Node(std::move(kv));
        x->parent = p;
        if (!p)
            root_ = x;
        else if (left)
            p->left = x;
        else
            p->right = x;
        ++size_;
        added = true;
        rebalance(p);
        return x;
    }

    // a node for kv even when its key is there: after the equal ones
    Node *insertMulti(pair<K, V> kv)
    {
        Node *p = nullptr, *n = root_;
        bool left = false;
        while (n)
        {
            p = n;
            left = kv.first < n->kv.first;
            n = left ? n->left : n->right;
        }
        Node *x = new Node(std::move(kv));
        x->parent = p;
        if (!p)
            root_ = x;
        else if (left)
            p->left = x;
        else
            p->right = x;
        ++size_;
        rebalance(p);
        return x;
    }

    void erase(Node *z)
    {
        Node *from;
        if (!z->left || !z->right)
        {
            Node *c = z->left ? z->left : z->right;
            if (c)
                c->parent = z->parent;
            replace(z->parent, z, c);
            from = z->parent;
        }
        else
        {
            Node *y = z->right; // the successor takes z's place
            while (y->left)
                y = y->left;
            if (y->parent != z)
            {
                from = y->parent;
                if (y->right)
                    y->right->parent = y->parent;
                replace(y->parent, y, y->right);
                y->right = z->right;
                y->right->parent = y;
            }
            else
                from = y;
            y->left = z->left;
            y->left->parent = y;
            y->parent = z->parent;
            replace(z->parent, z, y);
            y->height = z->height;
        }
        delete z;
        --size_;
        rebalance(from);
    }

  private:
    static int h(Node *n) { return n ? n->height : 0; }
    static void fix(Node *n)
    {
        int a = h(n->left), b = h(n->right);
        n->height = (a > b ? a : b) + 1;
    }
    void replace(Node *p, Node *old, Node *now)
    {
        if (!p)
            root_ = now;
        else if (p->left == old)
            p->left = now;
        else
            p->right = now;
    }
    Node *rotateRight(Node *y)
    {
        Node *x = y->left;
        y->left = x->right;
        if (x->right)
            x->right->parent = y;
        x->parent = y->parent;
        replace(y->parent, y, x);
        x->right = y;
        y->parent = x;
        fix(y);
        fix(x);
        return x;
    }
    Node *rotateLeft(Node *y)
    {
        Node *x = y->right;
        y->right = x->left;
        if (x->left)
            x->left->parent = y;
        x->parent = y->parent;
        replace(y->parent, y, x);
        x->left = y;
        y->parent = x;
        fix(y);
        fix(x);
        return x;
    }
    void rebalance(Node *n)
    {
        while (n)
        {
            fix(n);
            int bal = h(n->left) - h(n->right);
            if (bal > 1)
            {
                if (h(n->left->left) < h(n->left->right))
                    rotateLeft(n->left);
                n = rotateRight(n);
            }
            else if (bal < -1)
            {
                if (h(n->right->right) < h(n->right->left))
                    rotateRight(n->right);
                n = rotateLeft(n);
            }
            n = n->parent;
        }
    }
    static void drop(Node *n)
    {
        while (n)
        {
            drop(n->left);
            Node *r = n->right;
            delete n;
            n = r;
        }
    }
};

// an iterator over a tree's nodes in key order; end() is null (-- from it:
// the last node)
template <typename K, typename V>
class __titer
{
  public:
    __titer() : n_(nullptr), t_(nullptr) {}
    __titer(__tnode<K, V> *n, const __tree<K, V> *t) : n_(n), t_(t) {}
    pair<K, V> &operator*() const { return n_->kv; }
    pair<K, V> *operator->() const { return &n_->kv; }
    __titer &operator++()
    {
        n_ = __tree<K, V>::next(n_);
        return *this;
    }
    __titer operator++(int)
    {
        __titer old = *this;
        n_ = __tree<K, V>::next(n_);
        return old;
    }
    __titer &operator--()
    {
        n_ = n_ ? __tree<K, V>::prev(n_) : t_->last();
        return *this;
    }
    __titer operator--(int)
    {
        __titer old = *this;
        --*this;
        return old;
    }
    bool operator==(const __titer &o) const { return n_ == o.n_; }
    bool operator!=(const __titer &o) const { return n_ != o.n_; }
    __tnode<K, V> *n_;
    const __tree<K, V> *t_;
};

// in reverse: base_ is the node after the current one (null: the end)
template <typename K, typename V>
class __rtiter
{
  public:
    __rtiter(__tnode<K, V> *base, const __tree<K, V> *t) : base_(base), t_(t) {}
    __tnode<K, V> *__cur() const { return base_ ? __tree<K, V>::prev(base_) : t_->last(); }
    pair<K, V> &operator*() const { return __cur()->kv; }
    pair<K, V> *operator->() const { return &__cur()->kv; }
    __rtiter &operator++()
    {
        base_ = __cur();
        return *this;
    }
    bool operator==(const __rtiter &o) const { return base_ == o.base_; }
    bool operator!=(const __rtiter &o) const { return base_ != o.base_; }
    __tnode<K, V> *base_;
    const __tree<K, V> *t_;
};

// a set's: the keys only
template <typename K>
class __tsiter
{
  public:
    __tsiter() : n_(nullptr), t_(nullptr) {}
    __tsiter(__tnode<K, char> *n, const __tree<K, char> *t) : n_(n), t_(t) {}
    const K &operator*() const { return n_->kv.first; }
    const K *operator->() const { return &n_->kv.first; }
    __tsiter &operator++()
    {
        n_ = __tree<K, char>::next(n_);
        return *this;
    }
    __tsiter operator++(int)
    {
        __tsiter old = *this;
        n_ = __tree<K, char>::next(n_);
        return old;
    }
    __tsiter &operator--()
    {
        n_ = n_ ? __tree<K, char>::prev(n_) : t_->last();
        return *this;
    }
    bool operator==(const __tsiter &o) const { return n_ == o.n_; }
    bool operator!=(const __tsiter &o) const { return n_ != o.n_; }
    __tnode<K, char> *n_;
    const __tree<K, char> *t_;
};

} // namespace std
