// <atomic> for Quantum's native backend: a value of up to 8 bytes kept in a
// 64-bit word. Plain loads and stores of an aligned word are atomic on x86-64
// (and the generated code never keeps one in a register); exchange, fetch-add
// and compare-exchange are the compiler's builtins, xchg / lock xadd /
// lock cmpxchg. Every operation is sequentially consistent. A pointer is
// held the same way (its arithmetic is not supported).
#pragma once

namespace std
{

enum memory_order
{
    memory_order_relaxed,
    memory_order_consume,
    memory_order_acquire,
    memory_order_release,
    memory_order_acq_rel,
    memory_order_seq_cst
};

template <typename T>
class atomic
{
  public:
    atomic() : w_(0) {}
    atomic(T v) : w_(__to(v)) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;

    T load(memory_order = memory_order_seq_cst) const { return __from(w_); }
    void store(T v, memory_order = memory_order_seq_cst) { __atomic_xchg(&w_, __to(v)); }
    T exchange(T v, memory_order = memory_order_seq_cst) { return __from(__atomic_xchg(&w_, __to(v))); }
    bool compare_exchange_strong(T &expected, T desired, memory_order = memory_order_seq_cst)
    {
        long long want = __to(expected);
        long long old = __atomic_cas(&w_, want, __to(desired));
        if (old == want)
            return true;
        expected = __from(old);
        return false;
    }
    bool compare_exchange_weak(T &expected, T desired, memory_order o = memory_order_seq_cst)
    {
        return compare_exchange_strong(expected, desired, o);
    }
    T fetch_add(T v, memory_order = memory_order_seq_cst) { return __from(__atomic_add(&w_, __to(v))); }
    T fetch_sub(T v, memory_order = memory_order_seq_cst) { return __from(__atomic_add(&w_, -__to(v))); }
    operator T() const { return load(); }
    T operator=(T v)
    {
        store(v);
        return v;
    }
    T operator++() { return fetch_add(1) + 1; }
    T operator++(int) { return fetch_add(1); }
    T operator--() { return fetch_sub(1) - 1; }
    T operator--(int) { return fetch_sub(1); }
    T operator+=(T v) { return fetch_add(v) + v; }
    T operator-=(T v) { return fetch_sub(v) - v; }
    bool is_lock_free() const { return true; }

  private:
    long long w_;
    static long long __to(T v) { return (long long)v; }
    static T __from(long long w) { return (T)w; }
};

typedef atomic<bool> atomic_bool;
typedef atomic<int> atomic_int;
typedef atomic<long long> atomic_llong;
typedef atomic<unsigned long long> atomic_ullong;
typedef atomic<size_t> atomic_size_t;

inline void atomic_thread_fence(memory_order) { long long x = 0; __atomic_xchg(&x, 0); }

} // namespace std
