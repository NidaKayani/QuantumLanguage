// <filesystem> for Quantum's native backend, as MinGW's libstdc++ behaves on
// Windows: '/' and '\' both separate, '\' is the preferred separator, a
// root-name is "C:" or "\\server"; the queries are the wide Win32 calls.
// Paths are kept as UTF-8 text.
#pragma once
#include <string>
#include <vector>
#include <memory>
#include <system_error>
#include <stdexcept>
#include <windows.h>

namespace std
{
namespace filesystem
{

inline bool __is_sep(char c) { return c == '/' || c == '\\'; }

// UTF-8 to the UTF-16 the wide Win32 calls take, and back
inline std::wstring __wide(const string &s)
{
    std::wstring w;
    if (s.empty())
        return w;
    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), nullptr, 0);
    w.resize((size_t)n);
    MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), &w[0], n);
    return w;
}
inline int __wlen(const wchar_t *w)
{
    int n = 0;
    while (w && w[n])
        ++n;
    return n;
}
inline string __narrow(const wchar_t *w, int len)
{
    string s;
    if (len <= 0)
        return s;
    int n = WideCharToMultiByte(CP_UTF8, 0, w, len, nullptr, 0, nullptr, nullptr);
    s.resize((size_t)n);
    WideCharToMultiByte(CP_UTF8, 0, w, len, &s[0], n, nullptr, nullptr);
    return s;
}

class path
{
  public:
    static const char preferred_separator = '\\';
    path() {}
    path(const string &s) : s_(s) {}
    path(const char *s) : s_(s) {}
    path(const std::wstring &w) : s_(__narrow(w.c_str(), (int)w.size())) {}
    path(const wchar_t *w) : s_(__narrow(w, __wlen(w))) {}

    const string &native() const { return s_; }
    const string &string() const { return s_; }
    std::string u8string() const { return s_; }
    std::string generic_string() const
    {
        std::string g = s_;
        for (size_t i = 0; i < g.size(); ++i)
            if (g[i] == '\\')
                g[i] = '/';
        return g;
    }
    std::string generic_u8string() const { return generic_string(); }
    std::wstring wstring() const { return __wide(s_); }
    std::wstring generic_wstring() const { return __wide(generic_string()); }
    std::string u8string_() const { return s_; }
    const char *c_str() const { return s_.c_str(); }
    operator std::string() const { return s_; }
    bool empty() const { return s_.empty(); }
    void clear() { s_.clear(); }

    // the parts: root-name, root-directory, the relative part's start
    size_t __rootNameLen() const
    {
        if (s_.size() >= 2 && s_[1] == ':' &&
            ((s_[0] >= 'A' && s_[0] <= 'Z') || (s_[0] >= 'a' && s_[0] <= 'z')))
            return 2;
        if (s_.size() > 2 && __is_sep(s_[0]) && __is_sep(s_[1]) && !__is_sep(s_[2]))
        {
            size_t i = 2;
            while (i < s_.size() && !__is_sep(s_[i]))
                ++i;
            return i;
        }
        return 0;
    }
    bool has_root_name() const { return __rootNameLen() > 0; }
    bool has_root_directory() const
    {
        size_t r = __rootNameLen();
        return r < s_.size() && __is_sep(s_[r]);
    }
    size_t __relStart() const
    {
        size_t i = __rootNameLen();
        while (i < s_.size() && __is_sep(s_[i]))
            ++i;
        return i;
    }
    path root_name() const { return path(s_.substr(0, __rootNameLen())); }
    path root_directory() const { return has_root_directory() ? path(s_.substr(__rootNameLen(), 1)) : path(); }
    path root_path() const
    {
        size_t r = __rootNameLen();
        return path(s_.substr(0, has_root_directory() ? r + 1 : r));
    }
    path relative_path() const { return path(s_.substr(__relStart())); }
    bool has_relative_path() const { return __relStart() < s_.size(); }
    bool is_absolute() const { return has_root_name() && has_root_directory(); }
    bool is_relative() const { return !is_absolute(); }

    path filename() const
    {
        size_t rel = __relStart();
        if (rel >= s_.size() || __is_sep(s_[s_.size() - 1]))
            return path();
        size_t i = s_.size();
        while (i > rel && !__is_sep(s_[i - 1]))
            --i;
        return path(s_.substr(i));
    }
    bool has_filename() const { return !filename().empty(); }
    path parent_path() const
    {
        size_t rel = __relStart();
        if (rel >= s_.size())
            return *this;
        size_t end = s_.size();
        if (!__is_sep(s_[end - 1]))
            while (end > rel && !__is_sep(s_[end - 1]))
                --end; // the last element off
        while (end > rel && __is_sep(s_[end - 1]))
            --end; // its separators too
        if (end < rel)
            end = rel;
        if (end == rel)
            return root_path().empty() ? path() : path(s_.substr(0, rel > 0 && __is_sep(s_[rel - 1]) ? __rootNameLen() + 1 : rel));
        return path(s_.substr(0, end));
    }
    bool has_parent_path() const { return !parent_path().empty(); }
    path stem() const
    {
        std::string f = filename().s_;
        if (f == "." || f == "..")
            return path(f);
        size_t dot = f.rfind('.');
        return path(dot == std::string::npos || dot == 0 ? f : f.substr(0, dot));
    }
    path extension() const
    {
        std::string f = filename().s_;
        if (f == "." || f == "..")
            return path();
        size_t dot = f.rfind('.');
        return path(dot == std::string::npos || dot == 0 ? std::string() : f.substr(dot));
    }
    bool has_stem() const { return !stem().empty(); }
    bool has_extension() const { return !extension().empty(); }

    path &replace_extension(const path &ext = path())
    {
        std::string e = extension().s_;
        if (!e.empty())
            s_.erase(s_.size() - e.size());
        if (!ext.s_.empty())
        {
            if (ext.s_[0] != '.')
                s_ += '.';
            s_ += ext.s_;
        }
        return *this;
    }
    path &replace_filename(const path &f)
    {
        std::string n = filename().s_;
        s_.erase(s_.size() - n.size());
        s_ += f.s_;
        return *this;
    }
    path &remove_filename()
    {
        std::string n = filename().s_;
        s_.erase(s_.size() - n.size());
        return *this;
    }
    path &make_preferred()
    {
        for (size_t i = 0; i < s_.size(); ++i)
            if (s_[i] == '/')
                s_[i] = '\\';
        return *this;
    }

    path &operator/=(const path &p)
    {
        if (p.is_absolute() || (p.has_root_name() && p.root_name().s_ != root_name().s_))
        {
            s_ = p.s_;
            return *this;
        }
        std::string rest = p.s_.substr(p.__rootNameLen());
        if (p.has_root_directory())
        {
            s_ = root_name().s_ + rest;
            return *this;
        }
        if (has_filename() || (!has_root_directory() && is_absolute()))
            s_ += '\\';
        s_ += rest;
        return *this;
    }
    path operator/(const path &p) const
    {
        path r = *this;
        r /= p;
        return r;
    }
    path &operator+=(const path &p)
    {
        s_ += p.s_;
        return *this;
    }
    path &operator+=(const std::string &p)
    {
        s_ += p;
        return *this;
    }
    path &operator+=(const char *p)
    {
        s_ += p;
        return *this;
    }
    path &operator+=(char c)
    {
        s_ += c;
        return *this;
    }

    // the elements as an iterator walks them: root-name, root-directory, the
    // file names, and "" when the path ends in a separator
    vector<std::string> __elements() const
    {
        vector<std::string> out;
        size_t r = __rootNameLen();
        if (r)
            out.push_back(s_.substr(0, r));
        if (has_root_directory())
            out.push_back(s_.substr(r, 1));
        size_t i = __relStart();
        while (i < s_.size())
        {
            size_t j = i;
            while (j < s_.size() && !__is_sep(s_[j]))
                ++j;
            out.push_back(s_.substr(i, j - i));
            if (j >= s_.size())
                break;
            while (j < s_.size() && __is_sep(s_[j]))
                ++j;
            if (j >= s_.size())
                out.push_back("");
            i = j;
        }
        return out;
    }

    path lexically_normal() const
    {
        if (s_.empty())
            return path();
        std::string rn = s_.substr(0, __rootNameLen());
        for (size_t i = 0; i < rn.size(); ++i)
            if (rn[i] == '/')
                rn[i] = '\\';
        bool rootDir = has_root_directory();
        vector<std::string> out;
        bool trailing = false;
        size_t i = __relStart();
        while (i < s_.size())
        {
            size_t j = i;
            while (j < s_.size() && !__is_sep(s_[j]))
                ++j;
            std::string e = s_.substr(i, j - i);
            while (j < s_.size() && __is_sep(s_[j]))
                ++j;
            bool sepAfter = j > i + e.size();
            if (e == ".")
                trailing = true;
            else if (e == "..")
            {
                if (!out.empty() && out.back() != "..")
                {
                    out.pop_back();
                    trailing = true;
                }
                else if (rootDir && out.empty())
                    trailing = false;
                else
                {
                    out.push_back("..");
                    trailing = sepAfter;
                }
            }
            else
            {
                out.push_back(e);
                trailing = sepAfter;
            }
            i = j;
        }
        std::string r = rn;
        if (rootDir)
            r += '\\';
        for (size_t k = 0; k < out.size(); ++k)
        {
            if (k)
                r += '\\';
            r += out[k];
        }
        if (trailing && !out.empty() && out.back() != "..")
            r += '\\';
        if (r.empty())
            r = ".";
        return path(r);
    }

    path lexically_relative(const path &base) const
    {
        if (root_name().s_ != base.root_name().s_ || is_absolute() != base.is_absolute() ||
            (!has_root_directory() && base.has_root_directory()))
            return path();
        vector<std::string> a = __elements(), b = base.__elements();
        size_t i = 0;
        while (i < a.size() && i < b.size() && __sameElement(a[i], b[i]))
            ++i;
        if (i == a.size() && i == b.size())
            return path(".");
        long long n = 0;
        for (size_t k = i; k < b.size(); ++k)
        {
            const std::string &e = b[k];
            if (e == "..")
                --n;
            else if (!e.empty() && e != ".")
                ++n;
        }
        if (n < 0)
            return path();
        if (n == 0 && (i == a.size() || a[i].empty()))
            return path(".");
        path r;
        for (long long k = 0; k < n; ++k)
            r /= path("..");
        for (size_t k = i; k < a.size(); ++k)
            r /= path(a[k]);
        return r;
    }
    path lexically_proximate(const path &base) const
    {
        path r = lexically_relative(base);
        return r.empty() ? *this : r;
    }
    size_t __rootCount() const { return (has_root_name() ? 1 : 0) + (has_root_directory() ? 1 : 0); }
    static bool __sameElement(const std::string &x, const std::string &y)
    {
        if (x.size() == 1 && y.size() == 1 && __is_sep(x[0]) && __is_sep(y[0]))
            return true;
        return x == y;
    }

    int compare(const path &o) const
    {
        vector<std::string> a = __elements(), b = o.__elements();
        for (size_t i = 0; i < a.size() && i < b.size(); ++i)
        {
            if (__sameElement(a[i], b[i]))
                continue;
            return a[i] < b[i] ? -1 : 1;
        }
        return a.size() < b.size() ? -1 : a.size() > b.size() ? 1 : 0;
    }
    bool operator==(const path &o) const { return compare(o) == 0; }
    bool operator!=(const path &o) const { return compare(o) != 0; }
    bool operator<(const path &o) const { return compare(o) < 0; }

    // iteration over the elements
    class iterator
    {
      public:
        iterator() : i_(0) {}
        iterator(const shared_ptr<vector<path>> &e, size_t i) : e_(e), i_(i) {}
        const path &operator*() const { return (*e_)[i_]; }
        const path *operator->() const { return &(*e_)[i_]; }
        iterator &operator++()
        {
            ++i_;
            return *this;
        }
        bool operator==(const iterator &o) const { return i_ == o.i_; }
        bool operator!=(const iterator &o) const { return i_ != o.i_; }

      private:
        shared_ptr<vector<path>> e_;
        size_t i_;
    };
    iterator begin() const
    {
        auto e = make_shared<vector<path>>();
        vector<std::string> parts = __elements();
        for (size_t i = 0; i < parts.size(); ++i)
            e->push_back(path(parts[i]));
        return iterator(e, 0);
    }
    iterator end() const { return iterator(nullptr, __elements().size()); }

  private:
    std::string s_;
};

inline path u8path(const string &s) { return path(s); }
inline path operator/(const char *a, const path &b) { return path(a) / b; }

class filesystem_error : public runtime_error
{
  public:
    filesystem_error(const string &what) : runtime_error(what) {}
    filesystem_error(const string &what, const error_code &ec) : runtime_error(what + ": " + ec.message()) {}
    filesystem_error(const string &what, const path &p, const error_code &ec)
        : runtime_error("filesystem error: " + what + ": " + ec.message() + " [" + p.string() + "]")
    {
    }
};

enum class directory_options
{
    none,
    follow_directory_symlink,
    skip_permission_denied
};
enum class copy_options
{
    none,
    skip_existing,
    overwrite_existing,
    update_existing,
    recursive
};
enum class file_type
{
    none,
    not_found,
    regular,
    directory,
    symlink,
    block,
    character,
    fifo,
    socket,
    unknown
};

class file_status
{
  public:
    file_status() : t_(file_type::none) {}
    explicit file_status(file_type t) : t_(t) {}
    file_type type() const { return t_; }

  private:
    file_type t_;
};

inline error_code __last_error()
{
    DWORD e = GetLastError();
    if (e == 2 || e == 3)
        return error_code((int)e, "No such file or directory");
    if (e == 5)
        return error_code((int)e, "Permission denied");
    if (e == 80 || e == 183)
        return error_code((int)e, "File exists");
    return error_code((int)e, "Operation failed");
}

inline file_status status(const path &p, error_code &ec)
{
    ec.clear();
    DWORD a = GetFileAttributesW(__wide(p.string()).c_str());
    if (a == INVALID_FILE_ATTRIBUTES)
        return file_status(file_type::not_found);
    return file_status((a & FILE_ATTRIBUTE_DIRECTORY) ? file_type::directory : file_type::regular);
}
inline file_status status(const path &p)
{
    error_code ec;
    return status(p, ec);
}
inline bool exists(file_status s) { return s.type() != file_type::not_found && s.type() != file_type::none; }
inline bool is_regular_file(file_status s) { return s.type() == file_type::regular; }
inline bool is_directory(file_status s) { return s.type() == file_type::directory; }
inline bool exists(const path &p) { return exists(status(p)); }
inline bool exists(const path &p, error_code &ec) { return exists(status(p, ec)); }
inline bool is_regular_file(const path &p) { return is_regular_file(status(p)); }
inline bool is_regular_file(const path &p, error_code &ec) { return is_regular_file(status(p, ec)); }
inline bool is_directory(const path &p) { return is_directory(status(p)); }
inline bool is_directory(const path &p, error_code &ec) { return is_directory(status(p, ec)); }

inline path current_path(error_code &ec)
{
    ec.clear();
    wchar_t buf[1024];
    DWORD n = GetCurrentDirectoryW(1024, buf);
    return path(__narrow(buf, (int)n));
}
inline path current_path()
{
    error_code ec;
    return current_path(ec);
}
inline void current_path(const path &p) { SetCurrentDirectoryW(__wide(p.string()).c_str()); }

inline path absolute(const path &p, error_code &ec)
{
    ec.clear();
    if (p.empty())
        return path();
    if (p.is_absolute())
        return p; // as it is: no . or .. resolved (libstdc++ does the same)
    std::wstring w = __wide(p.string());
    wchar_t buf[2048];
    DWORD n = GetFullPathNameW(w.c_str(), 2048, buf, nullptr);
    if (n == 0)
    {
        ec = __last_error();
        return path();
    }
    return path(__narrow(buf, (int)n));
}
inline path absolute(const path &p)
{
    error_code ec;
    return absolute(p, ec);
}

// absolute, with no . or .. left, no trailing separator; it must exist
inline path canonical(const path &p, error_code &ec)
{
    path pa = absolute(p, ec);
    if (ec)
        return path();
    if (!exists(pa))
    {
        ec = error_code(2, "No such file or directory");
        return path();
    }
    path result = pa.root_path();
    vector<string> parts = pa.relative_path().__elements();
    for (size_t i = 0; i < parts.size(); ++i)
    {
        const string &e = parts[i];
        if (e.empty() || e == ".")
            continue;
        if (e == "..")
        {
            if (result.has_relative_path())
                result = result.parent_path();
            continue;
        }
        result /= path(e);
    }
    return result;
}
inline path canonical(const path &p)
{
    error_code ec;
    path r = canonical(p, ec);
    if (ec)
        throw filesystem_error("cannot make canonical path", p, ec);
    return r;
}

inline path weakly_canonical(const path &p, error_code &ec)
{
    ec.clear();
    if (exists(p))
        return canonical(p, ec);
    path result;
    vector<string> parts = p.__elements();
    size_t i = 0;
    for (; i < parts.size(); ++i)
    {
        path tmp = result / path(parts[i]);
        if (!exists(tmp))
            break;
        result = tmp;
    }
    if (!result.empty())
        result = canonical(result, ec);
    for (; i < parts.size(); ++i)
        result /= path(parts[i]);
    return result.lexically_normal();
}
inline path weakly_canonical(const path &p)
{
    error_code ec;
    return weakly_canonical(p, ec);
}

inline path relative(const path &p, const path &base, error_code &ec)
{
    path a = weakly_canonical(p, ec);
    if (ec)
        return path();
    path b = weakly_canonical(base, ec);
    if (ec)
        return path();
    return a.lexically_relative(b);
}
inline path relative(const path &p, const path &base = current_path())
{
    error_code ec;
    return relative(p, base, ec);
}
inline path proximate(const path &p, const path &base = current_path())
{
    error_code ec;
    path r = relative(p, base, ec);
    return r.empty() ? p : r;
}

class directory_entry
{
  public:
    directory_entry() {}
    explicit directory_entry(const filesystem::path &p) : p_(p) {}
    const filesystem::path &path() const { return p_; }
    operator const filesystem::path &() const { return p_; }
    bool exists() const { return filesystem::exists(p_); }
    bool is_regular_file() const { return filesystem::is_regular_file(p_); }
    bool is_directory() const { return filesystem::is_directory(p_); }
    bool is_directory(error_code &ec) const { return filesystem::is_directory(p_, ec); }
    bool is_regular_file(error_code &ec) const { return filesystem::is_regular_file(p_, ec); }
    bool exists(error_code &ec) const { return filesystem::exists(p_, ec); }
    bool is_symlink() const { return false; }
    unsigned long long file_size() const { return filesystem::file_size(p_); }
    file_status status() const { return filesystem::status(p_); }

  private:
    filesystem::path p_;
};

// the names in dir (no . and ..), in FindFirstFile's order
inline vector<string> __list(const path &dir, bool &ok)
{
    vector<string> out;
    WIN32_FIND_DATAW fd;
    std::wstring pattern = __wide((dir / path("*")).string());
    HANDLE h = FindFirstFileW(pattern.c_str(), &fd);
    ok = h != (HANDLE)(long long)-1;
    if (!ok)
        return out;
    do
    {
        int len = 0;
        while (fd.cFileName[len])
            ++len;
        string name = __narrow(fd.cFileName, len);
        if (name != "." && name != "..")
            out.push_back(name);
    } while (FindNextFileW(h, &fd));
    FindClose(h);
    return out;
}

// The listing is taken when the iterator is made; iteration walks it.
class directory_iterator
{
  public:
    directory_iterator() : i_(0) {}
    explicit directory_iterator(const path &p) : i_(0)
    {
        error_code ec;
        __load(p, false, ec);
        if (ec)
            throw filesystem_error("directory iterator cannot open directory", p, ec);
    }
    directory_iterator(const path &p, error_code &ec) : i_(0) { __load(p, false, ec); }
    directory_iterator(const path &p, directory_options, error_code &ec) : i_(0) { __load(p, false, ec); }
    directory_iterator(const path &p, directory_options) : i_(0)
    {
        error_code ec;
        __load(p, false, ec);
    }
    const directory_entry &operator*() const { return (*e_)[i_]; }
    const directory_entry *operator->() const { return &(*e_)[i_]; }
    directory_iterator &operator++()
    {
        ++i_;
        return *this;
    }
    directory_iterator &increment(error_code &ec)
    {
        ec.clear();
        ++i_;
        return *this;
    }
    bool __atEnd() const { return !e_ || i_ >= e_->size(); }
    bool operator==(const directory_iterator &o) const { return __atEnd() && o.__atEnd() ? true : (e_ == o.e_ && i_ == o.i_); }
    bool operator!=(const directory_iterator &o) const { return !(*this == o); }
    directory_iterator begin() const { return *this; }
    directory_iterator end() const { return directory_iterator(); }

  protected:
    shared_ptr<vector<directory_entry>> e_;
    size_t i_;
    void __load(const path &dir, bool recursive, error_code &ec)
    {
        ec.clear();
        e_ = make_shared<vector<directory_entry>>();
        bool ok = true;
        vector<string> names = __list(dir, ok);
        if (!ok)
        {
            ec = __last_error();
            return;
        }
        for (size_t k = 0; k < names.size(); ++k)
        {
            path p = dir / path(names[k]);
            e_->push_back(directory_entry(p));
            if (recursive && is_directory(p))
                __walk(p);
        }
    }
    void __walk(const path &dir)
    {
        bool ok = true;
        vector<string> names = __list(dir, ok);
        for (size_t k = 0; k < names.size(); ++k)
        {
            path p = dir / path(names[k]);
            e_->push_back(directory_entry(p));
            if (is_directory(p))
                __walk(p);
        }
    }
};

// walks the tree as it goes (pre-order): a stack of directory listings
class recursive_directory_iterator
{
  public:
    recursive_directory_iterator() {}
    explicit recursive_directory_iterator(const path &p)
    {
        error_code ec;
        __start(p, ec);
        if (ec)
            throw filesystem_error("recursive directory iterator cannot open directory", p, ec);
    }
    recursive_directory_iterator(const path &p, error_code &ec) { __start(p, ec); }
    recursive_directory_iterator(const path &p, directory_options, error_code &ec) { __start(p, ec); }
    recursive_directory_iterator(const path &p, directory_options)
    {
        error_code ec;
        __start(p, ec);
    }
    const directory_entry &operator*() const { return st_->cur; }
    const directory_entry *operator->() const { return &st_->cur; }
    recursive_directory_iterator &operator++()
    {
        __advance();
        return *this;
    }
    recursive_directory_iterator &increment(error_code &ec)
    {
        ec.clear();
        __advance();
        return *this;
    }
    void disable_recursion_pending()
    {
        if (st_)
            st_->skip = true;
    }
    void pop()
    {
        if (!st_ || st_->levels.empty())
            return;
        st_->levels.pop_back();
        st_->skip = true;
        __advance();
    }
    int depth() const { return st_ ? (int)st_->levels.size() - 1 : 0; }
    bool __atEnd() const { return !st_ || st_->levels.empty(); }
    bool operator==(const recursive_directory_iterator &o) const
    {
        if (__atEnd() || o.__atEnd())
            return __atEnd() == o.__atEnd();
        return st_ == o.st_;
    }
    bool operator!=(const recursive_directory_iterator &o) const { return !(*this == o); }
    recursive_directory_iterator begin() const { return *this; }
    recursive_directory_iterator end() const { return recursive_directory_iterator(); }

  private:
    struct Level
    {
        path dir;
        vector<string> names;
        size_t i = 0;
    };
    struct State
    {
        vector<Level> levels;
        directory_entry cur;
        bool skip = false;
    };
    shared_ptr<State> st_;

    void __start(const path &p, error_code &ec)
    {
        ec.clear();
        bool ok = true;
        Level top;
        top.dir = p;
        top.names = __list(p, ok);
        if (!ok)
        {
            ec = __last_error();
            return;
        }
        st_ = make_shared<State>();
        if (top.names.empty())
        {
            st_.reset();
            return;
        }
        st_->levels.push_back(top);
        __settle();
    }
    // the current entry from the top listing
    void __settle()
    {
        Level &l = st_->levels.back();
        st_->cur = directory_entry(l.dir / path(l.names[l.i]));
        st_->skip = false;
    }
    void __advance()
    {
        if (__atEnd())
            return;
        // into the current directory, unless told not to
        if (!st_->skip && st_->cur.is_directory())
        {
            bool ok = true;
            Level sub;
            sub.dir = st_->cur.path();
            sub.names = __list(sub.dir, ok);
            if (ok && !sub.names.empty())
            {
                st_->levels.push_back(sub);
                __settle();
                return;
            }
        }
        // on to the next name, climbing out of finished listings
        while (!st_->levels.empty())
        {
            Level &l = st_->levels.back();
            if (++l.i < l.names.size())
            {
                __settle();
                return;
            }
            st_->levels.pop_back();
        }
    }
};

inline bool is_empty(const path &p, error_code &ec)
{
    ec.clear();
    file_status s = status(p);
    if (is_directory(s))
    {
        bool ok = true;
        return __list(p, ok).empty();
    }
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW(__wide(p.string()).c_str(), &fd);
    if (h == (HANDLE)(long long)-1)
    {
        ec = __last_error();
        return false;
    }
    FindClose(h);
    return fd.nFileSizeHigh == 0 && fd.nFileSizeLow == 0;
}
inline bool is_empty(const path &p)
{
    error_code ec;
    return is_empty(p, ec);
}

inline bool create_directory(const path &p, error_code &ec)
{
    ec.clear();
    if (CreateDirectoryW(__wide(p.string()).c_str(), nullptr))
        return true;
    if (!is_directory(p))
        ec = __last_error();
    return false;
}
inline bool create_directory(const path &p)
{
    error_code ec;
    return create_directory(p, ec);
}
inline bool create_directories(const path &p, error_code &ec)
{
    ec.clear();
    if (p.empty() || is_directory(p))
        return false;
    path parent = p.parent_path();
    if (!parent.empty() && parent != p && !exists(parent))
    {
        create_directories(parent, ec);
        if (ec)
            return false;
    }
    if (!p.has_filename())
        return false;
    return create_directory(p, ec);
}
inline bool create_directories(const path &p)
{
    error_code ec;
    return create_directories(p, ec);
}

inline bool remove(const path &p, error_code &ec)
{
    ec.clear();
    file_status s = status(p);
    if (!exists(s))
        return false;
    std::wstring w = __wide(p.string());
    bool ok = is_directory(s) ? RemoveDirectoryW(w.c_str()) != 0 : DeleteFileW(w.c_str()) != 0;
    if (!ok)
        ec = __last_error();
    return ok;
}
inline bool remove(const path &p)
{
    error_code ec;
    return remove(p, ec);
}
inline unsigned long long remove_all(const path &p, error_code &ec)
{
    ec.clear();
    file_status s = status(p);
    if (!exists(s))
        return 0;
    unsigned long long n = 0;
    if (is_directory(s))
    {
        bool ok = true;
        vector<string> names = __list(p, ok);
        for (size_t k = 0; k < names.size(); ++k)
        {
            n += remove_all(p / path(names[k]), ec);
            if (ec)
                return n;
        }
    }
    if (remove(p, ec))
        ++n;
    return n;
}
inline unsigned long long remove_all(const path &p)
{
    error_code ec;
    return remove_all(p, ec);
}

inline bool copy_file(const path &from, const path &to, copy_options o, error_code &ec)
{
    ec.clear();
    if (exists(to))
    {
        if (o == copy_options::skip_existing)
            return false;
        if (o != copy_options::overwrite_existing && o != copy_options::update_existing)
        {
            ec = error_code(80, "File exists");
            return false;
        }
    }
    if (!CopyFileW(__wide(from.string()).c_str(), __wide(to.string()).c_str(), FALSE))
    {
        ec = __last_error();
        return false;
    }
    return true;
}
inline bool copy_file(const path &from, const path &to, error_code &ec)
{
    return copy_file(from, to, copy_options::none, ec);
}
inline bool copy_file(const path &from, const path &to, copy_options o = copy_options::none)
{
    error_code ec;
    bool r = copy_file(from, to, o, ec);
    if (ec)
        throw filesystem_error("cannot copy file", from, ec);
    return r;
}
inline void rename(const path &from, const path &to)
{
    MoveFileExW(__wide(from.string()).c_str(), __wide(to.string()).c_str(), 1);
}

// file times: 100 ns ticks since 1601 (only compared and counted)
class file_time_type
{
  public:
    file_time_type() : t_(0) {}
    explicit file_time_type(long long t) : t_(t) {}
    static file_time_type min() { return file_time_type(-9223372036854775807LL - 1); }
    long long __ticks() const { return t_; }
    file_time_type time_since_epoch() const { return *this; }
    long long count() const { return t_; }
    bool operator<(const file_time_type &o) const { return t_ < o.t_; }
    bool operator>(const file_time_type &o) const { return t_ > o.t_; }
    bool operator<=(const file_time_type &o) const { return t_ <= o.t_; }
    bool operator>=(const file_time_type &o) const { return t_ >= o.t_; }
    bool operator==(const file_time_type &o) const { return t_ == o.t_; }
    bool operator!=(const file_time_type &o) const { return t_ != o.t_; }

  private:
    long long t_;
};
inline file_time_type last_write_time(const path &p, error_code &ec)
{
    ec.clear();
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW(__wide(p.string()).c_str(), &fd);
    if (h == (HANDLE)(long long)-1)
    {
        ec = __last_error();
        return file_time_type::min();
    }
    FindClose(h);
    return file_time_type(((long long)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime);
}
inline file_time_type last_write_time(const path &p)
{
    error_code ec;
    return last_write_time(p, ec);
}
inline unsigned long long file_size(const path &p)
{
    WIN32_FIND_DATAW fd;
    HANDLE h = FindFirstFileW(__wide(p.string()).c_str(), &fd);
    if (h == (HANDLE)(long long)-1)
        return (unsigned long long)-1;
    FindClose(h);
    return ((unsigned long long)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
}

