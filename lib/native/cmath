// <cmath> for Quantum's native backend. sqrt, fabs, floor, ceil and trunc
// are built in (SSE instructions, exact); the rest follow.
#pragma once

inline double fmod(double x, double y)
{
    if (y == 0 || x != x || y != y)
        return 0.0 / 0.0;
    double q = trunc(x / y);
    double r = x - q * y;
    // exact remainder by repeated correction (x - q*y may round)
    while (r != 0 && (r < 0) != (x < 0))
        r += x < 0 ? -fabs(y) : fabs(y);
    while (fabs(r) >= fabs(y))
        r -= x < 0 ? -fabs(y) : fabs(y);
    return r;
}
inline double round(double x) { return x < 0 ? -floor(-x + 0.5) : floor(x + 0.5); }
inline bool isnan(double x) { return x != x; }
inline bool isinf(double x) { return x - x != 0 && x == x; }
inline bool isfinite(double x) { return x - x == 0; }
inline bool signbit(double x) { return x < 0 || (x == 0 && 1 / x < 0); }

namespace std
{
using ::fmod;
using ::isfinite;
using ::isinf;
using ::isnan;
using ::round;
using ::signbit;
inline double abs(double x) { return fabs(x); }
inline double sqrt(double x) { return ::sqrt(x); }
inline double floor(double x) { return ::floor(x); }
inline double ceil(double x) { return ::ceil(x); }
inline double trunc(double x) { return ::trunc(x); }
inline double fabs(double x) { return ::fabs(x); }
} // namespace std
