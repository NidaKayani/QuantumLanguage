using namespace __dll_ucrtbase;

inline bool isnan(double x) { return x != x; }
inline bool isinf(double x) { return x - x != 0 && x == x; }
inline bool isfinite(double x) { return x - x == 0; }
inline bool isnormal(double x)
{
    double a = fabs(x);
    return isfinite(x) && a >= 2.2250738585072014e-308;
}
inline bool signbit(double x)
{
    unsigned long long b = *(unsigned long long *)&x;
    return (b >> 63) != 0;
}

#define M_PI 3.14159265358979323846
#define M_E 2.7182818284590452354
#define M_SQRT2 1.41421356237309504880
#define M_LN2 0.69314718055994530942
#define M_LN10 2.30258509299404568402
#define HUGE_VAL (__builtin_huge_val())
#define INFINITY (__builtin_huge_val())
#define NAN (__builtin_nan())

inline double __builtin_huge_val()
{
    unsigned long long b = 0x7FF0000000000000ULL;
    return *(double *)&b;
}
inline double __builtin_nan()
{
    unsigned long long b = 0x7FF8000000000000ULL;
    return *(double *)&b;
}

