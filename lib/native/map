// <map> for Quantum's native backend: std::map over the AVL tree in
// <__tree> (keys ordered by <).
#pragma once
#include <__tree>
#include <initializer_list>

namespace std
{

template <typename K, typename V>
class map
{
  public:
    typedef __titer<K, V> iterator;
    typedef __titer<K, V> const_iterator;
    typedef pair<K, V> value_type;
    typedef K key_type;
    typedef V mapped_type;

    map() {}
    map(initializer_list<pair<K, V>> items)
    {
        for (const pair<K, V> &kv : items)
            insert(kv);
    }
    map(const map &o) { t_.copyFrom(o.t_); }
    map(map &&o) { t_.takeFrom(o.t_); }
    map &operator=(const map &o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.copyFrom(o.t_);
        }
        return *this;
    }
    map &operator=(map &&o)
    {
        if (this != &o)
        {
            t_.clear();
            t_.takeFrom(o.t_);
        }
        return *this;
    }

    size_t size() const { return t_.size_; }
    bool empty() const { return t_.size_ == 0; }
    iterator begin() const { return iterator(t_.first(), &t_); }
    iterator end() const { return iterator(nullptr, &t_); }
    iterator find(const K &k) const { return iterator(t_.find(k), &t_); }
    size_t count(const K &k) const { return t_.find(k) ? 1 : 0; }
    bool contains(const K &k) const { return t_.find(k) != nullptr; }
    iterator lower_bound(const K &k) const { return iterator(t_.lowerBound(k), &t_); }
    iterator upper_bound(const K &k) const { return iterator(t_.upperBound(k), &t_); }

    V &operator[](const K &k)
    {
        __tnode<K, V> *n = t_.find(k);
        if (n)
            return n->kv.second;
        bool added = false;
        return t_.insert(pair<K, V>(k, V()), added)->kv.second;
    }
    V &at(const K &k) { return t_.find(k)->kv.second; }
    const V &at(const K &k) const { return t_.find(k)->kv.second; }
    pair<iterator, bool> insert(const pair<K, V> &kv)
    {
        bool added = false;
        __tnode<K, V> *n = t_.insert(kv, added);
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    pair<iterator, bool> insert(pair<K, V> &&kv)
    {
        __tnode<K, V> *n = t_.find(kv.first);
        if (n)
            return pair<iterator, bool>(iterator(n, &t_), false);
        bool added = false;
        n = t_.insert(pair<K, V>(kv.first, V()), added);
        n->kv.second = std::move(kv.second);
        return pair<iterator, bool>(iterator(n, &t_), true);
    }
    template <typename A, typename B>
    pair<iterator, bool> emplace(A &&key, B &&value)
    {
        K k(std::forward<A>(key));
        __tnode<K, V> *n = t_.find(k);
        if (n)
            return pair<iterator, bool>(iterator(n, &t_), false);
        bool added = false;
        n = t_.insert(pair<K, V>(k, V()), added);
        n->kv.second = V(std::forward<B>(value));
        return pair<iterator, bool>(iterator(n, &t_), true);
    }
    pair<iterator, bool> insert_or_assign(const K &k, const V &v)
    {
        bool added = false;
        __tnode<K, V> *n = t_.insert(pair<K, V>(k, v), added);
        if (!added)
            n->kv.second = v;
        return pair<iterator, bool>(iterator(n, &t_), added);
    }
    size_t erase(const K &k)
    {
        __tnode<K, V> *n = t_.find(k);
        if (!n)
            return 0;
        t_.erase(n);
        return 1;
    }
    iterator erase(iterator it)
    {
        __tnode<K, V> *next = __tree<K, V>::next(it.n_);
        t_.erase(it.n_);
        return iterator(next, &t_);
    }
    void clear() { t_.clear(); }
    void swap(map &o) { t_.swap(o.t_); }
    pair<iterator, bool> try_emplace(const K &k)
    {
        bool added = false;
        __tnode<K, V> *n = t_.find(k);
        if (n)
            return pair<iterator, bool>(iterator(n, &t_), false);
        n = t_.insert(pair<K, V>(k, V()), added);
        return pair<iterator, bool>(iterator(n, &t_), true);
    }
    template <typename A>
    pair<iterator, bool> try_emplace(const K &k, A &&v)
    {
        __tnode<K, V> *n = t_.find(k);
        if (n)
            return pair<iterator, bool>(iterator(n, &t_), false);
        bool added = false;
        n = t_.insert(pair<K, V>(k, V(std::forward<A>(v))), added);
        return pair<iterator, bool>(iterator(n, &t_), true);
    }
    template <typename __InputIt>
    void insert(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            insert(*first);
    }
    iterator erase(iterator first, iterator last)
    {
        while (first != last)
            first = erase(first);
        return last;
    }
    __rtiter<K, V> rbegin() const { return __rtiter<K, V>(nullptr, &t_); }
    __rtiter<K, V> rend() const { return __rtiter<K, V>(t_.first(), &t_); }
    bool operator==(const map &o) const
    {
        if (size() != o.size())
            return false;
        for (__tnode<K, V> *a = t_.first(), *b = o.t_.first(); a; a = __tree<K, V>::next(a), b = __tree<K, V>::next(b))
            if (!(a->kv.first == b->kv.first) || !(a->kv.second == b->kv.second))
                return false;
        return true;
    }
    bool operator!=(const map &o) const { return !(*this == o); }

  private:
    __tree<K, V> t_;
};

// keys may repeat: equal keys kept in insertion order
template <typename K, typename V>
class multimap
{
  public:
    typedef __titer<K, V> iterator;
    typedef __titer<K, V> const_iterator;
    typedef pair<K, V> value_type;

    multimap() {}
    multimap(const multimap &o)
    {
        for (__tnode<K, V> *n = o.t_.first(); n; n = __tree<K, V>::next(n))
            t_.insertMulti(n->kv);
    }
    multimap(multimap &&o) { t_.takeFrom(o.t_); }
    size_t size() const { return t_.size_; }
    bool empty() const { return t_.size_ == 0; }
    iterator begin() const { return iterator(t_.first(), &t_); }
    iterator end() const { return iterator(nullptr, &t_); }
    iterator insert(const pair<K, V> &kv) { return iterator(t_.insertMulti(kv), &t_); }
    iterator emplace(const K &k, const V &v) { return insert(pair<K, V>(k, v)); }
    iterator find(const K &k) const
    {
        __tnode<K, V> *n = t_.lowerBound(k);
        return iterator(n && !(k < n->kv.first) ? n : nullptr, &t_);
    }
    size_t count(const K &k) const
    {
        size_t c = 0;
        for (__tnode<K, V> *n = t_.lowerBound(k); n && !(k < n->kv.first); n = __tree<K, V>::next(n))
            ++c;
        return c;
    }
    iterator lower_bound(const K &k) const { return iterator(t_.lowerBound(k), &t_); }
    iterator upper_bound(const K &k) const { return iterator(t_.upperBound(k), &t_); }
    pair<iterator, iterator> equal_range(const K &k) const
    {
        return pair<iterator, iterator>(lower_bound(k), upper_bound(k));
    }
    iterator erase(iterator it)
    {
        __tnode<K, V> *next = __tree<K, V>::next(it.n_);
        t_.erase(it.n_);
        return iterator(next, &t_);
    }
    size_t erase(const K &k)
    {
        size_t c = 0;
        for (__tnode<K, V> *n = t_.lowerBound(k); n && !(k < n->kv.first); ++c)
        {
            __tnode<K, V> *next = __tree<K, V>::next(n);
            t_.erase(n);
            n = next;
        }
        return c;
    }
    void clear() { t_.clear(); }

  private:
    __tree<K, V> t_;
};

} // namespace std
