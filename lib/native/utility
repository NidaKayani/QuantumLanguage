// <utility> for Quantum's native backend. std::move and std::forward are
// built into the compiler; std::pair and std::swap are here.
#pragma once

namespace std
{

template <typename A, typename B>
struct pair
{
    A first;
    B second;
    pair() : first(), second() {}
    pair(const A &a, const B &b) : first(a), second(b) {}
    template <typename U, typename V>
    pair(U &&a, V &&b) : first(std::forward<U>(a)), second(std::forward<V>(b))
    {
    }
    template <typename U, typename V>
    pair(const pair<U, V> &o) : first(o.first), second(o.second)
    {
    }
    template <typename U, typename V>
    pair(pair<U, V> &&o) : first(std::move(o.first)), second(std::move(o.second))
    {
    }
    bool operator==(const pair &o) const { return first == o.first && second == o.second; }
    bool operator!=(const pair &o) const { return !(*this == o); }
    bool operator<(const pair &o) const { return first < o.first || (!(o.first < first) && second < o.second); }
    bool operator>(const pair &o) const { return o < *this; }
    bool operator<=(const pair &o) const { return !(o < *this); }
    bool operator>=(const pair &o) const { return !(*this < o); }
};

template <typename A, typename B>
pair<A, B> make_pair(const A &a, const B &b)
{
    return pair<A, B>(a, b);
}

// an iterator whose elements are moved from (make_move_iterator)
template <typename T>
class move_iterator
{
  public:
    explicit move_iterator(T *p) : p_(p) {}
    T &&operator*() const { return std::move(*p_); }
    move_iterator &operator++()
    {
        ++p_;
        return *this;
    }
    bool operator==(const move_iterator &o) const { return p_ == o.p_; }
    bool operator!=(const move_iterator &o) const { return p_ != o.p_; }
    long long operator-(const move_iterator &o) const { return p_ - o.p_; }
    T *base() const { return p_; }
    T *p_;
};

template <typename T>
move_iterator<T> make_move_iterator(T *p)
{
    return move_iterator<T>(p);
}

// function objects
template <typename T = void>
struct less
{
    bool operator()(const T &a, const T &b) const { return a < b; }
};
template <typename T = void>
struct greater
{
    bool operator()(const T &a, const T &b) const { return b < a; }
};
template <typename T = void>
struct less_equal
{
    bool operator()(const T &a, const T &b) const { return !(b < a); }
};
template <typename T = void>
struct greater_equal
{
    bool operator()(const T &a, const T &b) const { return !(a < b); }
};
template <typename T = void>
struct equal_to
{
    bool operator()(const T &a, const T &b) const { return a == b; }
};
template <typename T = void>
struct not_equal_to
{
    bool operator()(const T &a, const T &b) const { return !(a == b); }
};
template <typename T = void>
struct plus
{
    T operator()(const T &a, const T &b) const { return a + b; }
};
template <typename T = void>
struct minus
{
    T operator()(const T &a, const T &b) const { return a - b; }
};
template <typename T = void>
struct multiplies
{
    T operator()(const T &a, const T &b) const { return a * b; }
};

template <typename T>
void swap(T &a, T &b)
{
    T t = std::move(a);
    a = std::move(b);
    b = std::move(t);
}

} // namespace std
