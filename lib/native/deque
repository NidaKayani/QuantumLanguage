// <deque> for Quantum's native backend: elements in fixed blocks of 16 that
// never move, so references survive push_back / push_front; the block table
// grows at either end. Iterators are (deque, index) pairs: random access.
#pragma once
#include <utility>
#include <initializer_list>

namespace std
{

template <typename T>
class deque;

template <typename T>
class __diter
{
  public:
    __diter() : d_(nullptr), i_(0) {}
    __diter(const deque<T> *d, size_t i) : d_(d), i_(i) {}
    T &operator*() const { return d_->__at(i_); }
    T *operator->() const { return &d_->__at(i_); }
    T &operator[](long long k) const { return d_->__at(i_ + k); }
    __diter &operator++()
    {
        ++i_;
        return *this;
    }
    __diter operator++(int)
    {
        __diter old = *this;
        ++i_;
        return old;
    }
    __diter &operator--()
    {
        --i_;
        return *this;
    }
    __diter operator--(int)
    {
        __diter old = *this;
        --i_;
        return old;
    }
    __diter &operator+=(long long k)
    {
        i_ += k;
        return *this;
    }
    __diter &operator-=(long long k)
    {
        i_ -= k;
        return *this;
    }
    __diter operator+(long long k) const { return __diter(d_, i_ + k); }
    __diter operator-(long long k) const { return __diter(d_, i_ - k); }
    long long operator-(const __diter &o) const { return (long long)i_ - (long long)o.i_; }
    bool operator==(const __diter &o) const { return i_ == o.i_; }
    bool operator!=(const __diter &o) const { return i_ != o.i_; }
    bool operator<(const __diter &o) const { return i_ < o.i_; }
    bool operator>(const __diter &o) const { return i_ > o.i_; }
    bool operator<=(const __diter &o) const { return i_ <= o.i_; }
    bool operator>=(const __diter &o) const { return i_ >= o.i_; }
    const deque<T> *d_;
    size_t i_;
};

// in reverse: i_ is one past the current index
template <typename T>
class __drev
{
  public:
    __drev(const deque<T> *d, size_t i) : d_(d), i_(i) {}
    T &operator*() const { return d_->__at(i_ - 1); }
    T *operator->() const { return &d_->__at(i_ - 1); }
    __drev &operator++()
    {
        --i_;
        return *this;
    }
    bool operator==(const __drev &o) const { return i_ == o.i_; }
    bool operator!=(const __drev &o) const { return i_ != o.i_; }
    const deque<T> *d_;
    size_t i_;
};

template <typename T>
class deque
{
  public:
    typedef T value_type;
    typedef __diter<T> iterator;
    typedef __diter<T> const_iterator;

    deque() : blocks_(nullptr), nblocks_(0), first_(0), size_(0) {}
    deque(initializer_list<T> items) : blocks_(nullptr), nblocks_(0), first_(0), size_(0)
    {
        for (const T &v : items)
            push_back(v);
    }
    deque(const deque &o) : blocks_(nullptr), nblocks_(0), first_(0), size_(0)
    {
        for (size_t i = 0; i < o.size_; ++i)
            push_back(o.__at(i));
    }
    deque(deque &&o) : blocks_(o.blocks_), nblocks_(o.nblocks_), first_(o.first_), size_(o.size_)
    {
        o.blocks_ = nullptr;
        o.nblocks_ = 0;
        o.first_ = 0;
        o.size_ = 0;
    }
    ~deque()
    {
        clear();
        for (size_t b = 0; b < nblocks_; ++b)
            free(blocks_[b]);
        free(blocks_);
    }
    deque &operator=(const deque &o)
    {
        if (this != &o)
        {
            clear();
            for (size_t i = 0; i < o.size_; ++i)
                push_back(o.__at(i));
        }
        return *this;
    }
    deque &operator=(deque &&o)
    {
        if (this != &o)
        {
            swap(o);
            o.clear();
        }
        return *this;
    }

    size_t size() const { return size_; }
    bool empty() const { return size_ == 0; }
    T &operator[](size_t i) { return __at(i); }
    const T &operator[](size_t i) const { return __at(i); }
    T &at(size_t i) { return __at(i); }
    T &front() { return __at(0); }
    T &back() { return __at(size_ - 1); }
    iterator begin() const { return iterator(this, 0); }
    iterator end() const { return iterator(this, size_); }
    iterator cbegin() const { return iterator(this, 0); }
    iterator cend() const { return iterator(this, size_); }
    __drev<T> rbegin() const { return __drev<T>(this, size_); }
    __drev<T> rend() const { return __drev<T>(this, 0); }
    const T &front() const { return __at(0); }
    const T &back() const { return __at(size_ - 1); }

    void push_back(const T &v)
    {
        T *p = __slotBack();
        __native_construct(p, v);
        ++size_;
    }
    void push_back(T &&v)
    {
        T *p = __slotBack();
        __native_construct_move(p, v);
        ++size_;
    }
    T *__emplace_raw()
    {
        T *p = __slotBack();
        ++size_;
        return p;
    }
    void push_front(const T &v)
    {
        T *p = __slotFront();
        __native_construct(p, v);
        --first_;
        ++size_;
    }
    void push_front(T &&v)
    {
        T *p = __slotFront();
        __native_construct_move(p, v);
        --first_;
        ++size_;
    }
    void pop_back()
    {
        __native_destroy(&__at(size_ - 1));
        --size_;
    }
    void pop_front()
    {
        __native_destroy(&__at(0));
        ++first_;
        --size_;
    }
    void clear()
    {
        while (size_)
            pop_back();
        first_ = nblocks_ * 8; // the middle: room to grow both ways
    }
    iterator erase(iterator pos)
    {
        size_t i = pos.i_;
        for (size_t k = i; k + 1 < size_; ++k)
            __at(k) = std::move(__at(k + 1));
        pop_back();
        return iterator(this, i);
    }
    iterator erase(iterator first, iterator last)
    {
        size_t i = first.i_, n = last.i_ - first.i_;
        for (size_t k = i; k + n < size_; ++k)
            __at(k) = std::move(__at(k + n));
        for (size_t k = 0; k < n; ++k)
            pop_back();
        return iterator(this, i);
    }
    iterator insert(iterator pos, const T &v)
    {
        size_t i = pos.i_;
        push_back(v);
        for (size_t k = size_ - 1; k > i; --k)
            std::swap(__at(k), __at(k - 1));
        return iterator(this, i);
    }
    void resize(size_t n)
    {
        while (size_ > n)
            pop_back();
        while (size_ < n)
            push_back(T());
    }
    void swap(deque &o)
    {
        std::swap(blocks_, o.blocks_);
        std::swap(nblocks_, o.nblocks_);
        std::swap(first_, o.first_);
        std::swap(size_, o.size_);
    }

    T &__at(size_t i) const
    {
        size_t p = first_ + i;
        return blocks_[p / 16][p % 16];
    }

  private:
    T **blocks_;
    size_t nblocks_;
    size_t first_; // physical position of element 0
    size_t size_;

    // a new block table of n blocks, the old blocks placed from `at`
    void __regrow(size_t n, size_t at)
    {
        T **nb = (T **)malloc(n * sizeof(T *));
        for (size_t b = 0; b < n; ++b)
            nb[b] = nullptr;
        for (size_t b = 0; b < nblocks_; ++b)
            nb[at + b] = blocks_[b];
        for (size_t b = 0; b < n; ++b)
            if (!nb[b])
                nb[b] = (T *)malloc(16 * sizeof(T));
        free(blocks_);
        blocks_ = nb;
        first_ += at * 16;
        nblocks_ = n;
    }
    T *__slotBack()
    {
        if (!nblocks_)
        {
            __regrow(2, 0);
            first_ = 16;
        }
        if (first_ + size_ >= nblocks_ * 16)
            __regrow(nblocks_ * 2, 0);
        size_t p = first_ + size_;
        return &blocks_[p / 16][p % 16];
    }
    T *__slotFront()
    {
        if (!nblocks_)
        {
            __regrow(2, 0);
            first_ = 16;
        }
        if (first_ == 0)
            __regrow(nblocks_ * 2, nblocks_);
        size_t p = first_ - 1;
        return &blocks_[p / 16][p % 16];
    }
};

} // namespace std
