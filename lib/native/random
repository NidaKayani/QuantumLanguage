// <random> for Quantum's native backend, with libstdc++'s algorithms (so a
// seeded program draws the same numbers as when built by g++): the Mersenne
// twisters, random_device (RtlGenRandom), uniform_int_distribution (Lemire's
// nearly-divisionless method on 128-bit products) and
// uniform_real_distribution (generate_canonical, one 64-bit draw).
#pragma once
#include <__hash>

