class mt19937_64
{
  public:
    typedef unsigned long long result_type;
    explicit mt19937_64(unsigned long long s = 5489ULL) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = s;
        for (int i = 1; i < 312; ++i)
            x_[i] = 6364136223846793005ULL * (x_[i - 1] ^ (x_[i - 1] >> 62)) + (unsigned long long)i;
        i_ = 312;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 312)
            twist();
        unsigned long long z = x_[i_++];
        z ^= (z >> 29) & 0x5555555555555555ULL;
        z ^= (z << 17) & 0x71D67FFFEDA60000ULL;
        z ^= (z << 37) & 0xFFF7EEE000000000ULL;
        z ^= z >> 43;
        return z;
    }
    void discard(unsigned long long n)
    {
        while (n--)
            (*this)();
    }

  private:
    unsigned long long x_[312];
    int i_;
    void twist()
    {
        const unsigned long long upper = 0xFFFFFFFF80000000ULL, lower = 0x7FFFFFFFULL;
        for (int k = 0; k < 312; ++k)
        {
            unsigned long long y = (x_[k] & upper) | (x_[(k + 1) % 312] & lower);
            x_[k] = x_[(k + 156) % 312] ^ (y >> 1) ^ ((y & 1) ? 0xB5026F5AA96619E9ULL : 0ULL);
        }
        i_ = 0;
    }
};

class mt19937
{
  public:
    typedef unsigned result_type;
    explicit mt19937(unsigned long long s = 5489U) { seed(s); }
    void seed(unsigned long long s)
    {
        x_[0] = (unsigned)s;
        for (int i = 1; i < 624; ++i)
            x_[i] = 1812433253U * (x_[i - 1] ^ (x_[i - 1] >> 30)) + (unsigned)i;
        i_ = 624;
    }
    static unsigned long long min() { return 0; }
    static unsigned long long max() { return 0xFFFFFFFFULL; }
    unsigned long long operator()()
    {
        if (i_ >= 624)
            twist();
        unsigned z = x_[i_++];
        z ^= z >> 11;
        z ^= (z << 7) & 0x9D2C5680U;
        z ^= (z << 15) & 0xEFC60000U;
        z ^= z >> 18;
        return z;
    }

  private:
    unsigned x_[624];
    int i_;
    void twist()
    {
        for (int k = 0; k < 624; ++k)
        {
            unsigned y = (x_[k] & 0x80000000U) | (x_[(k + 1) % 624] & 0x7FFFFFFFU);
            x_[k] = x_[(k + 397) % 624] ^ (y >> 1) ^ ((y & 1) ? 0x9908B0DFU : 0U);
        }
        i_ = 0;
    }
};
typedef mt19937 default_random_engine;

