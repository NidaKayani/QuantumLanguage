// The native backend's program start: main(argc, argv)'s arguments, from the
// Windows command line as UTF-8. Included (by the compiler) when main takes
// them.
#pragma once
#include <windows.h>

char **__startup_args(int *argc)
{
    int n = 0;
    wchar_t **wide = CommandLineToArgvW(GetCommandLineW(), &n);
    char **out = new char *[n + 1];
    for (int i = 0; i < n; ++i)
    {
        int len = WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, nullptr, 0, nullptr, nullptr);
        out[i] = new char[len];
        WideCharToMultiByte(CP_UTF8, 0, wide[i], -1, out[i], len, nullptr, nullptr);
    }
    out[n] = nullptr;
    LocalFree((HLOCAL)wide);
    *argc = n;
    return out;
}
