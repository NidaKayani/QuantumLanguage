// <vector> for Quantum's native backend: std::vector<T> over raw heap
// storage; elements are built and destroyed in place (__native_construct /
// __native_destroy, compiler builtins), so T needs no default constructor.
#pragma once
#include <string>
#include <utility>
#include <initializer_list>

namespace std
{

template <typename T>
class vector
{
  public:
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef __rptr<T> reverse_iterator;
    typedef __rptr<T> const_reverse_iterator;

    vector() : data_(nullptr), size_(0), cap_(0) {}
    explicit vector(size_t n) : data_(nullptr), size_(0), cap_(0) { resize(n); }
    vector(size_t n, const T &v) : data_(nullptr), size_(0), cap_(0)
    {
        reserve(n);
        for (size_t i = 0; i < n; ++i)
            __native_construct(data_ + i, v);
        size_ = n;
    }
    vector(initializer_list<T> items) : data_(nullptr), size_(0), cap_(0)
    {
        reserve(items.size());
        for (const T &v : items)
            __native_construct(data_ + size_++, v);
    }
    template <typename __InputIt>
    vector(__InputIt first, __InputIt last) : data_(nullptr), size_(0), cap_(0)
    {
        for (; first != last; ++first)
            this->emplace_back(*first);
    }
    vector(const vector &o) : data_(nullptr), size_(0), cap_(0)
    {
        reserve(o.size_);
        for (size_t i = 0; i < o.size_; ++i)
            __native_construct(data_ + i, o.data_[i]);
        size_ = o.size_;
    }
    vector(vector &&o) : data_(o.data_), size_(o.size_), cap_(o.cap_)
    {
        o.data_ = nullptr;
        o.size_ = 0;
        o.cap_ = 0;
    }
    ~vector()
    {
        clear();
        free(data_);
    }

    vector &operator=(const vector &o)
    {
        if (this != &o)
        {
            clear();
            reserve(o.size_);
            for (size_t i = 0; i < o.size_; ++i)
                __native_construct(data_ + i, o.data_[i]);
            size_ = o.size_;
        }
        return *this;
    }
    vector &operator=(vector &&o)
    {
        if (this != &o)
        {
            clear();
            free(data_);
            data_ = o.data_;
            size_ = o.size_;
            cap_ = o.cap_;
            o.data_ = nullptr;
            o.size_ = 0;
            o.cap_ = 0;
        }
        return *this;
    }

    size_t size() const { return size_; }
    size_t capacity() const { return cap_; }
    bool empty() const { return size_ == 0; }
    T *data() { return data_; }
    T *begin() { return data_; }
    T *end() { return data_ + size_; }
    const T *begin() const { return data_; }
    const T *end() const { return data_ + size_; }
    __rptr<T> rbegin() const { return __rptr<T>(data_ + size_); }
    __rptr<T> rend() const { return __rptr<T>(data_); }
    T &operator[](size_t i) { return data_[i]; }
    const T &operator[](size_t i) const { return data_[i]; }
    T &at(size_t i) { return data_[i]; }
    T &front() { return data_[0]; }
    T &back() { return data_[size_ - 1]; }
    const T &back() const { return data_[size_ - 1]; }

    void reserve(size_t n)
    {
        if (n <= cap_)
            return;
        T *d = (T *)malloc(n * sizeof(T));
        for (size_t i = 0; i < size_; ++i)
        {
            __native_construct_move(d + i, data_[i]);
            __native_destroy(data_ + i);
        }
        free(data_);
        data_ = d;
        cap_ = n;
    }
    void resize(size_t n, const T &v)
    {
        if (n > cap_)
            reserve(n);
        while (size_ > n)
            __native_destroy(data_ + --size_);
        while (size_ < n)
            __native_construct(data_ + size_++, v);
    }
    void shrink_to_fit() {}
    size_t max_size() const { return 0x7FFFFFFFFFFFFFFFULL / sizeof(T); }
    const T *cbegin() const { return data_; }
    const T *cend() const { return data_ + size_; }
    const T *data() const { return data_; }
    const T &at(size_t i) const { return data_[i]; }
    const T &front() const { return data_[0]; }
    void resize(size_t n)
    {
        if (n > cap_)
            reserve(n);
        while (size_ > n)
            __native_destroy(data_ + --size_);
        while (size_ < n)
            __native_construct(data_ + size_++, T());
    }
    void clear()
    {
        while (size_ > 0)
            __native_destroy(data_ + --size_);
    }
    void push_back(const T &v)
    {
        if (size_ == cap_)
            reserve(cap_ ? cap_ * 2 : 4);
        __native_construct(data_ + size_, v);
        ++size_;
    }
    void push_back(T &&v)
    {
        if (size_ == cap_)
            reserve(cap_ ? cap_ * 2 : 4);
        __native_construct_move(data_ + size_, v);
        ++size_;
    }
    // emplace_back's storage (the compiler builds the element in it)
    T *__emplace_raw()
    {
        if (size_ == cap_)
            reserve(cap_ ? cap_ * 2 : 4);
        return data_ + size_++;
    }
    void pop_back()
    {
        if (size_)
            __native_destroy(data_ + --size_);
    }
    T *erase(T *pos)
    {
        size_t i = (size_t)(pos - data_);
        for (size_t k = i; k + 1 < size_; ++k)
            data_[k] = std::move(data_[k + 1]);
        pop_back();
        return data_ + i;
    }
    T *insert(T *pos, const T &v)
    {
        size_t i = (size_t)(pos - data_);
        push_back(v);
        for (size_t k = size_ - 1; k > i; --k)
            std::swap(data_[k], data_[k - 1]);
        return data_ + i;
    }

    T *insert(T *pos, size_t n, const T &v)
    {
        size_t i = (size_t)(pos - data_);
        vector tmp(n, v);
        return insert(data_ + i, tmp.data_, tmp.data_ + n);
    }
    T *insert(T *pos, initializer_list<T> items)
    {
        size_t i = (size_t)(pos - data_);
        vector tmp(items);
        return insert(data_ + i, tmp.data_, tmp.data_ + tmp.size_);
    }
    T *insert(T *pos, T &&v)
    {
        size_t i = (size_t)(pos - data_);
        push_back(std::move(v));
        for (size_t k = size_ - 1; k > i; --k)
            std::swap(data_[k], data_[k - 1]);
        return data_ + i;
    }

    T *insert(T *pos, const T *first, const T *last)
    {
        size_t i = (size_t)(pos - data_);
        size_t n = (size_t)(last - first);
        if (n == 0)
            return data_ + i;
        // the range copied first (it may be inside this vector)
        vector tmp(first, last);
        reserve(size_ + n);
        for (size_t k = 0; k < n; ++k)
            __native_construct_move(data_ + size_ + k, tmp.data_[k]);
        size_ += n;
        // rotate the new elements into place
        for (size_t k = size_ - n; k > i; --k)
            for (size_t m = 0; m < n; ++m)
                std::swap(data_[k - 1 + m], data_[k + m]);
        return data_ + i;
    }
    // any other iterators (move iterators, other containers')
    template <typename __InputIt>
    T *insert(T *pos, __InputIt first, __InputIt last)
    {
        size_t i = (size_t)(pos - data_);
        vector tmp;
        for (; first != last; ++first)
            tmp.push_back(*first);
        size_t n = tmp.size_;
        if (n == 0)
            return data_ + i;
        reserve(size_ + n);
        for (size_t k = 0; k < n; ++k)
            __native_construct_move(data_ + size_ + k, tmp.data_[k]);
        size_ += n;
        for (size_t k = size_ - n; k > i; --k)
            for (size_t m = 0; m < n; ++m)
                std::swap(data_[k - 1 + m], data_[k + m]);
        return data_ + i;
    }
    T *erase(T *first, T *last)
    {
        size_t i = (size_t)(first - data_), n = (size_t)(last - first);
        for (size_t k = i; k + n < size_; ++k)
            data_[k] = std::move(data_[k + n]);
        for (size_t k = 0; k < n; ++k)
            pop_back();
        return data_ + i;
    }
    bool operator==(const vector &o) const
    {
        if (size_ != o.size_)
            return false;
        for (size_t i = 0; i < size_; ++i)
            if (!(data_[i] == o.data_[i]))
                return false;
        return true;
    }
    bool operator!=(const vector &o) const { return !(*this == o); }
    bool operator<(const vector &o) const
    {
        for (size_t i = 0; i < size_ && i < o.size_; ++i)
        {
            if (data_[i] < o.data_[i])
                return true;
            if (o.data_[i] < data_[i])
                return false;
        }
        return size_ < o.size_;
    }
    void swap(vector &o)
    {
        T *d = data_;
        size_t s = size_, c = cap_;
        data_ = o.data_;
        size_ = o.size_;
        cap_ = o.cap_;
        o.data_ = d;
        o.size_ = s;
        o.cap_ = c;
    }
    template <typename __InputIt>
    void assign(__InputIt first, __InputIt last)
    {
        clear();
        for (; first != last; ++first)
            this->emplace_back(*first);
    }
    void assign(size_t n, const T &v)
    {
        clear();
        for (size_t k = 0; k < n; ++k)
            push_back(v);
    }

  private:
    T *data_;
    size_t size_;
    size_t cap_;
};

} // namespace std
