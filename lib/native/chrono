// <chrono> for Quantum's native backend: duration<Rep, Num, Den> (a period of
// Num/Den seconds, in place of std::ratio), the steady and system clocks.
#pragma once
#include <windows.h>

namespace std
{
namespace chrono
{

inline long long __gcd(long long a, long long b)
{
    while (b)
    {
        long long t = a % b;
        a = b;
        b = t;
    }
    return a < 0 ? -a : a;
}

template <typename Rep, long long Num = 1, long long Den = 1>
class duration
{
  public:
    typedef Rep rep;
    duration() : r_(0) {}
    duration(Rep r) : r_(r) {}
    // from another period: count * (N2/D2) / (Num/Den), as libstdc++ computes it
    template <typename R2, long long N2, long long D2>
    duration(const duration<R2, N2, D2> &o) : r_(0)
    {
        long long num = N2 * Den, den = D2 * Num;
        long long g = __gcd(num, den);
        num /= g;
        den /= g;
        if (num == 1 && den == 1)
            r_ = (Rep)o.count();
        else if (num == 1)
            r_ = (Rep)((Rep)o.count() / (Rep)den);
        else if (den == 1)
            r_ = (Rep)((Rep)o.count() * (Rep)num);
        else
            r_ = (Rep)((Rep)o.count() * (Rep)num / (Rep)den);
    }
    Rep count() const { return r_; }
    // in nanoseconds: durations of different periods compared
    long long __ns() const
    {
        long long num = Num * 1000000000LL, den = Den;
        long long g = __gcd(num, den);
        return (long long)(r_ * (Rep)(num / g) / (Rep)(den / g));
    }
    duration operator+(const duration &o) const { return duration(r_ + o.r_); }
    duration operator-(const duration &o) const { return duration(r_ - o.r_); }
    duration &operator+=(const duration &o)
    {
        r_ += o.r_;
        return *this;
    }
    duration &operator-=(const duration &o)
    {
        r_ -= o.r_;
        return *this;
    }
    template <typename R2, long long N2, long long D2>
    bool operator<(const duration<R2, N2, D2> &o) const
    {
        return __ns() < o.__ns();
    }
    template <typename R2, long long N2, long long D2>
    bool operator>(const duration<R2, N2, D2> &o) const
    {
        return __ns() > o.__ns();
    }
    template <typename R2, long long N2, long long D2>
    bool operator<=(const duration<R2, N2, D2> &o) const
    {
        return __ns() <= o.__ns();
    }
    template <typename R2, long long N2, long long D2>
    bool operator>=(const duration<R2, N2, D2> &o) const
    {
        return __ns() >= o.__ns();
    }
    template <typename R2, long long N2, long long D2>
    bool operator==(const duration<R2, N2, D2> &o) const
    {
        return __ns() == o.__ns();
    }

  private:
    Rep r_;
};

typedef duration<long long, 1, 1000000000> nanoseconds;
typedef duration<long long, 1, 1000000> microseconds;
typedef duration<long long, 1, 1000> milliseconds;
typedef duration<long long, 1, 1> seconds;
typedef duration<long long, 60, 1> minutes;
typedef duration<long long, 3600, 1> hours;

template <typename To, typename R2, long long N2, long long D2>
To duration_cast(const duration<R2, N2, D2> &d)
{
    return To(d);
}

template <typename Clock>
class time_point
{
  public:
    time_point() : d_(0) {}
    explicit time_point(const nanoseconds &d) : d_(d) {}
    nanoseconds time_since_epoch() const { return d_; }
    nanoseconds operator-(const time_point &o) const { return nanoseconds(d_.count() - o.d_.count()); }
    bool operator<(const time_point &o) const { return d_.count() < o.d_.count(); }
    bool operator>(const time_point &o) const { return d_.count() > o.d_.count(); }
    bool operator<=(const time_point &o) const { return d_.count() <= o.d_.count(); }
    bool operator>=(const time_point &o) const { return d_.count() >= o.d_.count(); }

  private:
    nanoseconds d_;
};

struct steady_clock
{
    static time_point<steady_clock> now()
    {
        long long c = 0, f = 1;
        QueryPerformanceCounter(&c);
        QueryPerformanceFrequency(&f);
        long long ns = c / f * 1000000000LL + c % f * 1000000000LL / f;
        return time_point<steady_clock>(nanoseconds(ns));
    }
};
typedef steady_clock high_resolution_clock;

struct system_clock
{
    static time_point<system_clock> now()
    {
        FILETIME ft;
        GetSystemTimeAsFileTime(&ft);
        long long t = ((long long)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
        return time_point<system_clock>(nanoseconds((t - 116444736000000000LL) * 100));
    }
};

} // namespace chrono
} // namespace std
