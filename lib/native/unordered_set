// <unordered_set> for Quantum's native backend: the keys of an
// unordered_map (iterated in insertion order).
#pragma once
#include <unordered_map>

namespace std
{

template <typename K>
class __hsiter
{
  public:
    __hsiter() : n_(nullptr) {}
    explicit __hsiter(__hnode<K, char> *n) : n_(n) {}
    const K &operator*() const { return n_->kv.first; }
    const K *operator->() const { return &n_->kv.first; }
    __hsiter &operator++()
    {
        n_ = n_->next;
        return *this;
    }
    __hsiter operator++(int)
    {
        __hsiter old = *this;
        n_ = n_->next;
        return old;
    }
    bool operator==(const __hsiter &o) const { return n_ == o.n_; }
    bool operator!=(const __hsiter &o) const { return n_ != o.n_; }
    __hnode<K, char> *n_;
};

template <typename K>
class unordered_set
{
  public:
    typedef __hsiter<K> iterator;
    typedef __hsiter<K> const_iterator;
    typedef K value_type;

    unordered_set() {}
    unordered_set(initializer_list<K> items)
    {
        for (const K &k : items)
            m_[k] = 0;
    }
    template <typename __InputIt>
    unordered_set(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            m_[*first] = 0;
    }

    size_t size() const { return m_.size(); }
    bool empty() const { return m_.empty(); }
    iterator begin() const { return iterator(m_.begin().n_); }
    iterator end() const { return iterator(nullptr); }
    void reserve(size_t) {}
    iterator find(const K &k) const { return iterator(m_.find(k).n_); }
    size_t count(const K &k) const { return m_.count(k); }
    bool contains(const K &k) const { return m_.count(k) != 0; }
    pair<iterator, bool> insert(const K &k)
    {
        pair<__hiter<K, char>, bool> r = m_.insert(pair<K, char>(k, 0));
        return pair<iterator, bool>(iterator(r.first.n_), r.second);
    }
    template <typename __InputIt>
    void insert(__InputIt first, __InputIt last)
    {
        for (; first != last; ++first)
            m_[*first] = 0;
    }
    pair<iterator, bool> emplace(const K &k) { return insert(k); }
    size_t erase(const K &k) { return m_.erase(k); }
    iterator erase(iterator it)
    {
        __hnode<K, char> *next = it.n_->next;
        m_.erase(__hiter<K, char>(it.n_));
        return iterator(next);
    }
    void clear() { m_.clear(); }

  private:
    unordered_map<K, char> m_;
};

} // namespace std
