// <system_error> for Quantum's native backend: error_code (a value and a
// message; the filesystem functions set it).
#pragma once
#include <string>
#include <stdexcept>

namespace std
{

class error_code
{
  public:
    error_code() : v_(0) {}
    error_code(int v, const string &msg) : v_(v), msg_(msg) {}
    int value() const { return v_; }
    string message() const { return msg_; }
    explicit operator bool() const { return v_ != 0; }
    bool operator!() const { return v_ == 0; }
    void clear()
    {
        v_ = 0;
        msg_ = "";
    }

  private:
    int v_;
    string msg_;
};

class system_error : public runtime_error
{
  public:
    system_error(const error_code &ec, const string &what) : runtime_error(what + ": " + ec.message()), ec_(ec) {}
    const error_code &code() const { return ec_; }

  private:
    error_code ec_;
};

} // namespace std
