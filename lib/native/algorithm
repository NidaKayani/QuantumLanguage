template <typename T>
const T &min(const T &a, const T &b)
{
    return b < a ? b : a;
}

template <typename T>
const T &max(const T &a, const T &b)
{
    return a < b ? b : a;
}

template <typename T>
T min(initializer_list<T> items)
{
    const T *best = items.begin();
    for (const T *p = items.begin(); p != items.end(); ++p)
        if (*p < *best)
            best = p;
    return *best;
}
template <typename T>
T max(initializer_list<T> items)
{
    const T *best = items.begin();
    for (const T *p = items.begin(); p != items.end(); ++p)
        if (*best < *p)
            best = p;
    return *best;
}

template <typename T>
void reverse(T *first, T *last)
{
    while (first < last)
    {
        --last;
        T t = std::move(*first);
        *first = std::move(*last);
        *last = std::move(t);
        ++first;
    }
}

template <typename T, typename V>
T *find(T *first, T *last, const V &value)
{
    for (; first != last; ++first)
        if (*first == value)
            return first;
    return last;
}

template <typename T, typename V>
long long count(T *first, T *last, const V &value)
{
    long long n = 0;
    for (; first != last; ++first)
        if (*first == value)
            ++n;
    return n;
}

// a stable merge sort (std::sort's order on equal keys is unspecified)
template <typename T, typename Less>
void __mergeSort(T *a, T *tmp, long long n, Less cmp)
{
    if (n < 2)
        return;
    long long mid = n / 2;
    __mergeSort(a, tmp, mid, cmp);
    __mergeSort(a + mid, tmp, n - mid, cmp);
    long long i = 0, j = mid, k = 0;
    while (i < mid && j < n)
    {
        if (cmp(a[j], a[i]))
            tmp[k++] = std::move(a[j++]);
        else
            tmp[k++] = std::move(a[i++]);
    }
    while (i < mid)
        tmp[k++] = std::move(a[i++]);
    while (j < n)
        tmp[k++] = std::move(a[j++]);
    for (long long x = 0; x < n; ++x)
        a[x] = std::move(tmp[x]);
}

template <typename T, typename Less>
void stable_sort(T *first, T *last, Less cmp)
{
    long long n = last - first;
    if (n < 2)
        return;
    T *tmp = new T[n];
    __mergeSort(first, tmp, n, cmp);
    delete[] tmp;
}

template <typename T>
struct __less
{
    bool operator()(const T &a, const T &b) const { return a < b; }
};

template <typename T>
void stable_sort(T *first, T *last)
{
    __less<T> cmp;
    stable_sort(first, last, cmp);
}

// ── std::sort: libstdc++'s introsort, step for step (so equal keys end up
// in the same order as in a g++ build) ──
inline int __lg(long long n)
{
    int k = 0;
    while (n > 1)
    {
        n >>= 1;
        ++k;
    }
    return k;
}

template <typename T, typename C>
void __iter_swap(T *a, T *b)
{
    std::swap(*a, *b);
}

template <typename T, typename C>
void __move_median_to_first(T *result, T *a, T *b, T *c, C &comp)
{
    if (comp(*a, *b))
    {
        if (comp(*b, *c))
            std::swap(*result, *b);
        else if (comp(*a, *c))
            std::swap(*result, *c);
        else
            std::swap(*result, *a);
    }
    else if (comp(*a, *c))
        std::swap(*result, *a);
    else if (comp(*b, *c))
        std::swap(*result, *c);
    else
        std::swap(*result, *b);
}

template <typename T, typename C>
T *__unguarded_partition(T *first, T *last, T *pivot, C &comp)
{
    while (true)
    {
        while (comp(*first, *pivot))
            ++first;
        --last;
        while (comp(*pivot, *last))
            --last;
        if (!(first < last))
            return first;
        std::swap(*first, *last);
        ++first;
    }
}

template <typename T, typename C>
void __push_heap(T *first, long long hole, long long top, T value, C &comp)
{
    long long parent = (hole - 1) / 2;
    while (hole > top && comp(first[parent], value))
    {
        first[hole] = std::move(first[parent]);
        hole = parent;
        parent = (hole - 1) / 2;
    }
    first[hole] = std::move(value);
}

template <typename T, typename C>
void __adjust_heap(T *first, long long hole, long long len, T value, C &comp)
{
    long long top = hole;
    long long second = hole;
    while (second < (len - 1) / 2)
    {
        second = 2 * (second + 1);
        if (comp(first[second], first[second - 1]))
            second--;
        first[hole] = std::move(first[second]);
        hole = second;
    }
    if ((len & 1) == 0 && second == (len - 2) / 2)
    {
        second = 2 * (second + 1);
        first[hole] = std::move(first[second - 1]);
        hole = second - 1;
    }
    __push_heap(first, hole, top, std::move(value), comp);
}

template <typename T, typename C>
void __make_heap(T *first, T *last, C &comp)
{
    long long len = last - first;
    if (len < 2)
        return;
    long long parent = (len - 2) / 2;
    while (true)
    {
        T value = std::move(first[parent]);
        __adjust_heap(first, parent, len, std::move(value), comp);
        if (parent == 0)
            return;
        parent--;
    }
}

template <typename T, typename C>
void __pop_heap(T *first, T *last, T *result, C &comp)
{
    T value = std::move(*result);
    *result = std::move(*first);
    __adjust_heap(first, 0, last - first, std::move(value), comp);
}

template <typename T, typename C>
void __sort_heap(T *first, T *last, C &comp)
{
    while (last - first > 1)
    {
        --last;
        __pop_heap(first, last, last, comp);
    }
}

template <typename T, typename C>
void __heap_select(T *first, T *middle, T *last, C &comp)
{
    __make_heap(first, middle, comp);
    for (T *i = middle; i < last; ++i)
        if (comp(*i, *first))
            __pop_heap(first, middle, i, comp);
}

template <typename T, typename C>
void __introsort_loop(T *first, T *last, int depth, C &comp)
{
    while (last - first > 16)
    {
        if (depth == 0)
        {
            __heap_select(first, last, last, comp);
            __sort_heap(first, last, comp);
            return;
        }
        --depth;
        T *mid = first + (last - first) / 2;
        __move_median_to_first(first, first + 1, mid, last - 1, comp);
        T *cut = __unguarded_partition(first + 1, last, first, comp);
        __introsort_loop(cut, last, depth, comp);
        last = cut;
    }
}

template <typename T, typename C>
void __unguarded_linear_insert(T *last, C &comp)
{
    T val = std::move(*last);
    T *next = last - 1;
    while (comp(val, *next))
    {
        *last = std::move(*next);
        last = next;
        --next;
    }
    *last = std::move(val);
}

template <typename T, typename C>
void __insertion_sort(T *first, T *last, C &comp)
{
    if (first == last)
        return;
    for (T *i = first + 1; i != last; ++i)
    {
        if (comp(*i, *first))
        {
            T val = std::move(*i);
            for (T *k = i; k != first; --k)
                *k = std::move(*(k - 1));
            *first = std::move(val);
        }
        else
            __unguarded_linear_insert(i, comp);
    }
}

template <typename T, typename C>
void __final_insertion_sort(T *first, T *last, C &comp)
{
    if (last - first > 16)
    {
        __insertion_sort(first, first + 16, comp);
        for (T *i = first + 16; i != last; ++i)
            __unguarded_linear_insert(i, comp);
    }
    else
        __insertion_sort(first, last, comp);
}

template <typename T, typename C>
void sort(T *first, T *last, C comp)
{
    if (first != last)
    {
        __introsort_loop(first, last, __lg(last - first) * 2, comp);
        __final_insertion_sort(first, last, comp);
    }
}

template <typename T>
void sort(T *first, T *last)
{
    __less<T> cmp;
    sort(first, last, cmp);
}

// ── heaps ──
template <typename T, typename C>
void push_heap(T *first, T *last, C comp)
{
    T value = std::move(*(last - 1));
    __push_heap(first, (last - first) - 1, 0, std::move(value), comp);
}
template <typename T>
void push_heap(T *first, T *last)
{
    push_heap(first, last, __less<T>());
}
template <typename T, typename C>
void pop_heap(T *first, T *last, C comp)
{
    if (last - first > 1)
    {
        --last;
        __pop_heap(first, last, last, comp);
    }
}
template <typename T>
void pop_heap(T *first, T *last)
{
    pop_heap(first, last, __less<T>());
}
template <typename T, typename C>
void make_heap(T *first, T *last, C comp)
{
    __make_heap(first, last, comp);
}
template <typename T>
void make_heap(T *first, T *last)
{
    make_heap(first, last, __less<T>());
}
template <typename T, typename C>
void sort_heap(T *first, T *last, C comp)
{
    __sort_heap(first, last, comp);
}
template <typename T>
void sort_heap(T *first, T *last)
{
    sort_heap(first, last, __less<T>());
}

// ── shuffling, as libstdc++ draws ──
template <typename T, typename G>
void shuffle(T *first, T *last, G &g)
{
    if (first == last)
        return;
    unsigned long long urngrange = G::max() - G::min();
    unsigned long long urange = (unsigned long long)(last - first);
    if (urngrange / urange >= urange)
    {
        T *i = first + 1;
        if (urange % 2 == 0)
        {
            uniform_int_distribution<unsigned long long> d(0, 1);
            std::swap(*i, *(first + d(g)));
            ++i;
        }
        while (i != last)
        {
            unsigned long long swapRange = (unsigned long long)(i - first) + 1;
            uniform_int_distribution<unsigned long long> d(0, swapRange * (swapRange + 1) - 1);
            unsigned long long x = d(g);
            unsigned long long p1 = x / (swapRange + 1), p2 = x % (swapRange + 1);
            std::swap(*i, *(first + p1));
            ++i;
            std::swap(*i, *(first + p2));
            ++i;
        }
        return;
    }
    for (T *i = first + 1; i != last; ++i)
    {
        uniform_int_distribution<unsigned long long> d(0, (unsigned long long)(i - first));
        std::swap(*i, *(first + d(g)));
    }
}

template <typename T>
void random_shuffle(T *first, T *last)
{
    if (first != last)
        for (T *i = first + 1; i != last; ++i)
        {
            T *j = first + rand() % ((i - first) + 1);
            if (i != j)
                std::swap(*i, *j);
        }
}

template <typename T, typename C>
bool next_permutation(T *first, T *last, C comp)
{
    if (first == last || first + 1 == last)
        return false;
    T *i = last - 1;
    while (true)
    {
        T *ii = i;
        --i;
        if (comp(*i, *ii))
        {
            T *j = last;
            while (!comp(*i, *--j))
            {
            }
            std::swap(*i, *j);
            reverse(ii, last);
            return true;
        }
        if (i == first)
        {
            reverse(first, last);
            return false;
        }
    }
}
template <typename T>
bool next_permutation(T *first, T *last)
{
    return next_permutation(first, last, __less<T>());
}
template <typename T, typename C>
bool prev_permutation(T *first, T *last, C comp)
{
    if (first == last || first + 1 == last)
        return false;
    T *i = last - 1;
    while (true)
    {
        T *ii = i;
        --i;
        if (comp(*ii, *i))
        {
            T *j = last;
            while (!comp(*--j, *i))
            {
            }
            std::swap(*i, *j);
            reverse(ii, last);
            return true;
        }
        if (i == first)
        {
            reverse(first, last);
            return false;
        }
    }
}
template <typename T>
bool prev_permutation(T *first, T *last)
{
    return prev_permutation(first, last, __less<T>());
}

template <typename T, typename P>
T *stable_partition(T *first, T *last, P p)
{
    vector<T> yes, no;
    for (T *i = first; i != last; ++i)
    {
        if (p(*i))
            yes.push_back(std::move(*i));
        else
            no.push_back(std::move(*i));
    }
    T *out = first;
    for (size_t k = 0; k < yes.size(); ++k)
        *out++ = std::move(yes[k]);
    T *mid = out;
    for (size_t k = 0; k < no.size(); ++k)
        *out++ = std::move(no[k]);
    return mid;
}

template <typename T>
const T &clamp(const T &v, const T &lo, const T &hi)
{
    return v < lo ? lo : hi < v ? hi : v;
}

// predicates over any iterators
template <typename It, typename P>
It find_if(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return first;
    return last;
}
template <typename It, typename P>
It find_if_not(It first, It last, P p)
{
    for (; first != last; ++first)
        if (!p(*first))
            return first;
    return last;
}
// the first of two equal neighbours (last: none)
template <typename It>
It adjacent_find(It first, It last)
{
    if (first == last)
        return last;
    for (It next = first; ++next != last; first = next)
        if (*first == *next)
            return first;
    return last;
}
template <typename It, typename P>
It adjacent_find(It first, It last, P same)
{
    if (first == last)
        return last;
    for (It next = first; ++next != last; first = next)
        if (same(*first, *next))
            return first;
    return last;
}
template <typename It, typename P>
bool any_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return true;
    return false;
}
template <typename It, typename P>
bool all_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (!p(*first))
            return false;
    return true;
}
template <typename It, typename P>
bool none_of(It first, It last, P p)
{
    for (; first != last; ++first)
        if (p(*first))
            return false;
    return true;
}
template <typename It, typename P>
long long count_if(It first, It last, P p)
{
    long long n = 0;
    for (; first != last; ++first)
        if (p(*first))
            ++n;
    return n;
}
template <typename It, typename F>
F for_each(It first, It last, F f)
{
    for (; first != last; ++first)
        f(*first);
    return f;
}

// over contiguous elements
template <typename T, typename P>
T *remove_if(T *first, T *last, P p)
{
    T *out = first;
    for (; first != last; ++first)
        if (!p(*first))
        {
            if (out != first)
                *out = std::move(*first);
            ++out;
        }
    return out;
}
template <typename T, typename V>
T *remove(T *first, T *last, const V &value)
{
    T *out = first;
    for (; first != last; ++first)
        if (!(*first == value))
        {
            if (out != first)
                *out = std::move(*first);
            ++out;
        }
    return out;
}
template <typename T>
T *unique(T *first, T *last)
{
    if (first == last)
        return last;
    T *out = first;
    for (T *p = first + 1; p != last; ++p)
        if (!(*p == *out))
        {
            ++out;
            if (out != p)
                *out = std::move(*p);
        }
    return out + 1;
}
template <typename T, typename V>
T *lower_bound(T *first, T *last, const V &value)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (first[h] < value)
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V>
T *upper_bound(T *first, T *last, const V &value)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (!(value < first[h]))
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V>
bool binary_search(T *first, T *last, const V &value)
{
    T *p = lower_bound(first, last, value);
    return p != last && !(value < *p);
}
template <typename T, typename V, typename C>
T *lower_bound(T *first, T *last, const V &value, C comp)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (comp(first[h], value))
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V, typename C>
T *upper_bound(T *first, T *last, const V &value, C comp)
{
    long long n = last - first;
    while (n > 0)
    {
        long long h = n / 2;
        if (!comp(value, first[h]))
        {
            first += h + 1;
            n -= h + 1;
        }
        else
            n = h;
    }
    return first;
}
template <typename T, typename V, typename C>
bool binary_search(T *first, T *last, const V &value, C comp)
{
    T *p = lower_bound(first, last, value, comp);
    return p != last && !comp(value, *p);
}
template <typename T, typename V>
pair<T *, T *> equal_range(T *first, T *last, const V &value)
{
    return pair<T *, T *>(lower_bound(first, last, value), upper_bound(first, last, value));
}
template <typename T, typename C>
T *max_element(T *first, T *last, C comp)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (comp(*best, *p))
            best = p;
    return best;
}
template <typename T, typename C>
T *min_element(T *first, T *last, C comp)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (comp(*p, *best))
            best = p;
    return best;
}
template <typename T, typename P>
T *unique(T *first, T *last, P same)
{
    if (first == last)
        return last;
    T *out = first;
    for (T *p = first + 1; p != last; ++p)
        if (!same(*out, *p))
        {
            ++out;
            if (out != p)
                *out = std::move(*p);
        }
    return out + 1;
}

// [first, middle) to the end: three reversals; the new place of *first
template <typename T>
T *rotate(T *first, T *middle, T *last)
{
    if (first == middle)
        return last;
    if (middle == last)
        return first;
    reverse(first, middle);
    reverse(middle, last);
    reverse(first, last);
    return first + (last - middle);
}

template <typename T>
T *max_element(T *first, T *last)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (*best < *p)
            best = p;
    return best;
}
template <typename T>
T *min_element(T *first, T *last)
{
    T *best = first;
    for (T *p = first; p != last; ++p)
        if (*p < *best)
            best = p;
    return best;
}
template <typename T, typename V>
void fill(T *first, T *last, const V &value)
{
    for (; first != last; ++first)
        *first = value;
}
template <typename T, typename V>
void replace(T *first, T *last, const V &from, const V &to)
{
    for (; first != last; ++first)
        if (*first == from)
            *first = to;
}
template <typename It, typename Out>
Out copy(It first, It last, Out out)
{
    for (; first != last; ++first, ++out)
        *out = *first;
    return out;
}
template <typename It, typename Out, typename F>
Out transform(It first, It last, Out out, F f)
{
    for (; first != last; ++first, ++out)
        *out = f(*first);
    return out;
}
template <typename A, typename B>
bool equal(A first, A last, B other)
{
    for (; first != last; ++first, ++other)
        if (!(*first == *other))
            return false;
    return true;
}

