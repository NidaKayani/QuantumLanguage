// a stream's remaining characters, one by one (end: the default one)
template <typename C>
class istreambuf_iterator
{
  public:
    istreambuf_iterator() : s_(nullptr) {}
    istreambuf_iterator(__stream &s) : s_(&s) {}
    C operator*() const { return (C)s_->__peekc(); }
    istreambuf_iterator &operator++()
    {
        s_->__getc();
        return *this;
    }
    bool __end() const { return !s_ || s_->__peekc() == -1; }
    bool operator==(const istreambuf_iterator &o) const { return __end() == o.__end(); }
    bool operator!=(const istreambuf_iterator &o) const { return __end() != o.__end(); }

  private:
    __stream *s_;
};

// std::getline(stream, line [, delimiter])
inline __stream &getline(__stream &in, string &line, char delim = '\n')
{
    line.clear();
    int c = in.__getc();
    if (c == -1)
    {
        in.get(); // sets eof / fail
        return in;
    }
    while (c != -1 && c != (unsigned char)delim)
    {
        line += (char)c;
        c = in.__getc();
    }
    return in;
}

// the console
class __console : public __stream
{
  public:
    explicit __console(int fd) : fd_(fd), have_(false), next_(0), pos_(0) {}
    void write(const char *s, long long n) override
    {
        long long start = 0;
        for (long long i = 0; i < n; ++i)
            if (s[i] == '\n')
            {
                if (i > start)
                    __native_write(fd_, s + start, i - start);
                __native_write(fd_, "\r\n", 2);
                start = i + 1;
            }
        if (n > start)
            __native_write(fd_, s + start, n - start);
    }
    int __getc() override
    {
        int c = __peekc();
        if (c != -1)
            ++pos_;
        return c;
    }
    int __peekc() override
    {
        while (pos_ >= buf_.size())
        {
            char chunk[4096];
            long long got = __native_read(fd_, chunk, 4096);
            if (got <= 0)
                return -1;
            buf_.clear();
            pos_ = 0;
            for (long long i = 0; i < got; ++i)
                if (!(chunk[i] == '\r' && i + 1 < got && chunk[i + 1] == '\n'))
                    buf_ += chunk[i];
        }
        return (unsigned char)buf_[pos_];
    }

  private:
    int fd_;
    bool have_;
    int next_;
    string buf_;
    size_t pos_;
};

