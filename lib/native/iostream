class __stream : public ios_base
{
  public:
    __stream()
        : prec_(6), float_(0), base_(10), width_(0), fill_(' '), boolalpha_(false), left_(false), showpoint_(false),
          upper_(false), fail_(false), eof_(false), gcount_(0)
    {
    }
    virtual ~__stream() {}

    // the bytes, as each kind of stream moves them
    virtual void write(const char *s, long long n) {}
    virtual int __getc() { return -1; }
    virtual int __peekc() { return -1; }
    virtual string __rest()
    {
        string r;
        int c;
        while ((c = __getc()) != -1)
            r += (char)c;
        return r;
    }
    // positions, for the streams that have them (-1 / false: none)
    virtual long long __tell(bool put) { return -1; }
    virtual bool __seek(bool put, long long off, int dir) { return false; }

    // ── unformatted input, positions ──
    __stream &read(char *s, long long n)
    {
        gcount_ = 0;
        while (gcount_ < n)
        {
            int c = __getc();
            if (c == -1)
            {
                eof_ = true;
                fail_ = true;
                break;
            }
            s[gcount_++] = (char)c;
        }
        return *this;
    }
    long long gcount() const { return gcount_; }
    long long tellg() { return fail_ ? -1 : __tell(false); }
    long long tellp() { return fail_ ? -1 : __tell(true); }
    __stream &seekg(long long pos) { return seekg(pos, beg); }
    __stream &seekg(long long off, int dir)
    {
        eof_ = false;
        if (fail_ || !__seek(false, off, dir))
            fail_ = true;
        return *this;
    }
    __stream &seekp(long long pos) { return seekp(pos, beg); }
    __stream &seekp(long long off, int dir)
    {
        if (fail_ || !__seek(true, off, dir))
            fail_ = true;
        return *this;
    }

    // ── output ──
    __stream &put(char c)
    {
        write(&c, 1);
        return *this;
    }
    __stream &flush() { return *this; }
    int precision() const { return prec_; }
    int precision(int n)
    {
        int old = prec_;
        prec_ = n;
        return old;
    }
    int width() const { return width_; }
    int width(int n)
    {
        int old = width_;
        width_ = n;
        return old;
    }
    char fill(char c)
    {
        char old = fill_;
        fill_ = c;
        return old;
    }
    void __pad(const string &s)
    {
        if (width_ > (int)s.size())
        {
            string pad((size_t)width_ - s.size(), fill_);
            width_ = 0;
            if (left_)
            {
                write(s.c_str(), (long long)s.size());
                write(pad.c_str(), (long long)pad.size());
            }
            else
            {
                write(pad.c_str(), (long long)pad.size());
                write(s.c_str(), (long long)s.size());
            }
            return;
        }
        width_ = 0;
        write(s.c_str(), (long long)s.size());
    }
    string __int(unsigned long long u, bool negative)
    {
        char conv = base_ == 16 ? (upper_ ? 'X' : 'x') : base_ == 8 ? 'o' : 'd';
        return __fmtInt(u, negative, conv, -1, false, false, false);
    }
    __stream &operator<<(const char *s)
    {
        __pad(string(s));
        return *this;
    }
    __stream &operator<<(const string &s)
    {
        __pad(s);
        return *this;
    }
    __stream &operator<<(char c)
    {
        __pad(string(1, c));
        return *this;
    }
    __stream &operator<<(unsigned char c)
    {
        __pad(string(1, (char)c));
        return *this;
    }
    __stream &operator<<(bool b)
    {
        __pad(boolalpha_ ? string(b ? "true" : "false") : string(b ? "1" : "0"));
        return *this;
    }
    __stream &operator<<(int v)
    {
        long long w = v;
        __pad(__int(w < 0 ? (unsigned long long)0 - (unsigned long long)w : (unsigned long long)w, w < 0));
        return *this;
    }
    __stream &operator<<(long long v)
    {
        __pad(__int(v < 0 ? (unsigned long long)0 - (unsigned long long)v : (unsigned long long)v, v < 0));
        return *this;
    }
    __stream &operator<<(unsigned v)
    {
        __pad(__int(v, false));
        return *this;
    }
    __stream &operator<<(unsigned long long v)
    {
        __pad(__int(v, false));
        return *this;
    }
    __stream &operator<<(short v) { return *this << (int)v; }
    __stream &operator<<(unsigned short v) { return *this << (unsigned)v; }
    __stream &operator<<(double v)
    {
        char conv = float_ == 1 ? 'f' : float_ == 2 ? 'e' : 'g';
        if (upper_)
            conv = (char)(conv - 'a' + 'A');
        __pad(__fmtDouble(v, conv, prec_, showpoint_, false, false));
        return *this;
    }
    __stream &operator<<(float v) { return *this << (double)v; }
    __stream &operator<<(const void *p)
    {
        __pad("0x" + __fmtInt((unsigned long long)p, false, 'x', 1, false, false, false));
        return *this;
    }
    __stream &operator<<(const __rdbuf_t &r)
    {
        string rest = r.s->__rest();
        write(rest.c_str(), (long long)rest.size());
        return *this;
    }
    __stream &operator<<(const __endl_t &)
    {
        write("\n", 1);
        return *this;
    }
    __stream &operator<<(const __flush_t &) { return *this; }
    __stream &operator<<(const __floatfmt_t &f)
    {
        float_ = f.mode;
        return *this;
    }
    __stream &operator<<(const __base_t &b)
    {
        base_ = b.base;
        return *this;
    }
    __stream &operator<<(const __boolalpha_t &)
    {
        boolalpha_ = true;
        return *this;
    }
    __stream &operator<<(const __noboolalpha_t &)
    {
        boolalpha_ = false;
        return *this;
    }
    __stream &operator<<(const __left_t &)
    {
        left_ = true;
        return *this;
    }
    __stream &operator<<(const __right_t &)
    {
        left_ = false;
        return *this;
    }
    __stream &operator<<(const __showpoint_t &)
    {
        showpoint_ = true;
        return *this;
    }
    __stream &operator<<(const __uppercase_t &)
    {
        upper_ = true;
        return *this;
    }
    __stream &operator<<(const __nouppercase_t &)
    {
        upper_ = false;
        return *this;
    }
    __stream &operator<<(const __noshowpoint_t &)
    {
        showpoint_ = false;
        return *this;
    }
    __stream &operator<<(const __setprecision_t &m)
    {
        prec_ = m.n;
        return *this;
    }
    __stream &operator<<(const __setw_t &m)
    {
        width_ = m.n;
        return *this;
    }
    __stream &operator<<(const __setfill_t &m)
    {
        fill_ = m.c;
        return *this;
    }

    // ── input ──
    int get()
    {
        int c = __getc();
        if (c == -1)
        {
            eof_ = true;
            fail_ = true;
        }
        return c;
    }
    bool get(char &c)
    {
        int v = get();
        if (v == -1)
            return false;
        c = (char)v;
        return true;
    }
    int peek()
    {
        int c = __peekc();
        if (c == -1)
            eof_ = true;
        return c;
    }
    __stream &ignore(long long n = 1, int delim = -1)
    {
        for (long long i = 0; i < n; ++i)
        {
            int c = get();
            if (c == -1 || c == delim)
                break;
        }
        return *this;
    }
    __rdbuf_t rdbuf()
    {
        __rdbuf_t r;
        r.s = this;
        return r;
    }
    void __skipSpace()
    {
        int c;
        while ((c = __peekc()) != -1 && (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'))
            __getc();
    }
    string __word()
    {
        __skipSpace();
        string w;
        int c;
        while ((c = __peekc()) != -1 && !(c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'))
            w += (char)__getc();
        if (w.empty())
        {
            fail_ = true;
            eof_ = __peekc() == -1;
        }
        return w;
    }
    __stream &operator>>(string &s)
    {
        string w = __word();
        if (!w.empty())
            s = w;
        return *this;
    }
    __stream &operator>>(char &c)
    {
        __skipSpace();
        int v = get();
        if (v != -1)
            c = (char)v;
        return *this;
    }
    __stream &operator>>(long long &v)
    {
        string w = __word();
        if (w.empty())
            return *this;
        size_t i = 0;
        bool neg = false;
        if (w[0] == '-' || w[0] == '+')
        {
            neg = w[0] == '-';
            i = 1;
        }
        if (i >= w.size() || w[i] < '0' || w[i] > '9')
        {
            fail_ = true;
            v = 0;
            return *this;
        }
        long long r = 0;
        for (; i < w.size() && w[i] >= '0' && w[i] <= '9'; ++i)
            r = r * 10 + (w[i] - '0');
        v = neg ? -r : r;
        return *this;
    }
    __stream &operator>>(int &v)
    {
        long long w = 0;
        *this >> w;
        v = (int)w;
        return *this;
    }
    __stream &operator>>(double &v);

    bool good() const { return !fail_ && !eof_; }
    bool fail() const { return fail_; }
    bool bad() const { return false; }
    bool eof() const { return eof_; }
    void clear()
    {
        fail_ = false;
        eof_ = false;
    }
    explicit operator bool() const { return !fail_; }
    bool operator!() const { return fail_; }

  protected:
    int prec_;
    int float_; // 0 %g, 1 fixed, 2 scientific
    int base_;
    int width_;
    char fill_;
    bool boolalpha_, left_, showpoint_, upper_;
    bool fail_, eof_;
    long long gcount_;
};

