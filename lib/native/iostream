// <iostream> for Quantum's native backend. One stream class does input and
// output (the standard's istream / ostream / iostream are aliases of it);
// each kind of stream overrides the byte-level write / read. std::cout and
// std::cerr write straight to the console handles; text-mode streams write
// '\n' as "\r\n" and read "\r\n" as '\n', as on Windows.
#pragma once
#include <string>
#include <__format>

long long __native_write(int fd, const char *bytes, long long count);
long long __native_read(int fd, char *bytes, long long count);

